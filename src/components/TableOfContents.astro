---
import { type TocItem } from './TableOfContents.astro';

export interface TocItem {
  id: string;
  text: string;
  level: number;
}

interface Props {
  items: TocItem[];
}

const { items } = Astro.props;
const hasItems = items && items.length >= 2;
---

{hasItems && (
  <>
    {/* 1. Inline Editorial Overview at top of article (Under Title) */}
    <nav 
      id="toc-inline-container" 
      class="toc-card relative my-10 md:my-12 overflow-hidden rounded-xl border border-border-subtle/60 shadow-lg shadow-black/5 select-none transition-all duration-300" 
      aria-label="Table of contents overview"
    >
      <!-- Stationary Decoupled Frosted Glass Backdrop (Matches Terminal Card Spec) -->
      <div class="toc-backdrop absolute inset-0 -z-10 bg-bg/65 backdrop-blur-xl backdrop-saturate-150"></div>

      <!-- Header Bar -->
      <div id="toc-inline-header" class="flex items-center justify-between border-b border-border-subtle/50 px-3 sm:px-4 md:px-5 py-2.5 sm:py-3 bg-bg-subtle/30 transition-colors duration-200">
        <div class="flex items-center gap-2 sm:gap-2.5">
          <span class="font-serif italic text-accent text-xs leading-none select-none">§</span>
          <span class="font-mono text-[9px] sm:text-[10px] md:text-[11px] uppercase tracking-[0.18em] sm:tracking-[0.25em] text-text-muted font-medium">
            TABLE OF CONTENTS
          </span>
          <span class="font-mono text-[9px] text-accent/90 tabular-nums font-semibold tracking-wider">
            [{items.length}]
          </span>
        </div>
        <button 
          id="toc-toggle-btn"
          type="button"
          class="group flex items-center gap-1.5 font-mono text-[10px] uppercase tracking-wider text-text-muted hover:text-accent transition-colors duration-200 cursor-pointer"
          aria-expanded="true"
          aria-controls="toc-inline-content"
        >
          <span id="toc-toggle-text">Collapse</span>
          <svg id="toc-toggle-icon" class="w-3.5 h-3.5 text-text-muted group-hover:text-accent transition-transform duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="18 15 12 9 6 15"></polyline>
          </svg>
        </button>
      </div>

      <!-- Expandable / Collapsible Content Wrapper -->
      <div id="toc-inline-content" class="overflow-hidden">
        <div id="toc-inline-body" class="p-3 md:p-4 relative">
          <ol id="toc-inline-list" class="space-y-1">
            {items.map((item, index) => {
              const num = String(index + 1).padStart(2, '0');
              const isSub = item.level > 2;
              return (
                <li 
                  class={`toc-inline-row relative group rounded-lg transition-colors duration-200 ${isSub ? "ml-4 md:ml-6 pl-3 border-l border-border-subtle/50 my-0.5" : "my-0.5"}`}
                  data-index={index}
                  data-id={item.id}
                >
                  <a 
                    href={`#${item.id}`}
                    data-toc-id={item.id}
                    class="toc-jump-link flex items-baseline gap-3 px-3 py-1.5 text-text-muted hover:text-text-main transition-colors text-xs md:text-sm leading-relaxed rounded-md select-none"
                  >
                    <span class="toc-inline-num font-mono text-[10px] md:text-[11px] text-accent/80 group-hover:text-accent tabular-nums select-none shrink-0 font-medium transition-all duration-200">
                      {num}
                    </span>
                    <span class="toc-inline-title font-sans transition-colors duration-200 group-hover:text-text-main">
                      {item.text}
                    </span>
                  </a>
                </li>
              );
            })}
          </ol>
        </div>
      </div>
    </nav>

    {/* 2. Desktop Floating Anime.js Scroll Indicator Rail (Clean Frameless Floating Rail) */}
    <aside
      id="toc-floating-rail"
      class="fixed left-4 xl:left-8 2xl:left-12 top-1/2 -translate-y-1/2 z-40 hidden lg:flex flex-col select-none pointer-events-auto opacity-0 transition-opacity duration-300 max-h-[85vh]"
      aria-label="Reading section indicator"
    >
      <!-- Rail Header & Progress Counter -->
      <div class="mb-3.5 flex items-center gap-2 pl-3">
        <span class="font-serif italic text-accent text-xs font-normal select-none leading-none">§</span>
        <span class="font-mono text-[9px] uppercase tracking-[0.25em] text-text-muted/70 font-medium">INDEX</span>
        <span class="text-border-subtle/70 text-[9px] font-mono select-none">/</span>
        <span id="toc-rail-progress" class="font-mono text-[9px] text-accent font-semibold tabular-nums">0%</span>
      </div>

      <!-- Rail Items with Dynamic Cursor Track -->
      <div id="toc-rail-track" class="relative flex flex-col py-2 pl-3 border-l border-border-subtle/40 overflow-y-auto max-h-[calc(85vh-2.5rem)] scrollbar-none">
        <!-- Animated Active Indicator Pin (Refined Editorial Margin Needle) -->
        <div
          id="toc-rail-indicator"
          class="absolute -left-[1px] w-[2px] bg-accent rounded-[1px] pointer-events-none origin-center transition-[top,height] duration-300 ease-out"
          style="top: 0px; height: 24px;"
        >
          <span class="absolute top-1/2 -translate-y-1/2 left-[2px] w-1.5 h-[1.5px] bg-accent"></span>
        </div>

        <!-- Section Nodes -->
        <div class="space-y-3.5" id="toc-rail-items-container">
          {items.map((item, idx) => {
            const num = String(idx + 1).padStart(2, '0');
            return (
              <div 
                class="toc-rail-node group relative flex items-center" 
                data-index={idx} 
                data-id={item.id}
              >
                <a
                  href={`#${item.id}`}
                  class="toc-jump-link flex items-center gap-2.5 py-1 text-text-muted/60 hover:text-text-main transition-colors duration-200"
                  aria-label={`Jump to section ${num}: ${item.text}`}
                >
                  <span class="toc-rail-num font-mono text-[11px] tabular-nums font-medium transition-all duration-300">
                    {num}
                  </span>
                  <!-- Expanding Title Ribbon on Hover -->
                  <span class="toc-rail-title font-sans text-xs tracking-tight whitespace-nowrap overflow-hidden max-w-[95px] xl:max-w-[200px] 2xl:max-w-[230px] truncate opacity-70 group-hover:opacity-100 group-hover:text-accent transition-all duration-200">
                    {item.text}
                  </span>
                </a>
              </div>
            );
          })}
        </div>
      </div>
    </aside>

    {/* 3. Mobile Scrim / Click-Catcher */}
    <div 
      id="toc-mobile-scrim" 
      class="fixed inset-0 z-45 bg-black/25 opacity-0 pointer-events-none transition-opacity duration-300 lg:hidden"
      aria-hidden="true"
    ></div>

    {/* Mobile / Tablet Morphing TOC Container (Frosted Glass) */}
    <nav 
      id="toc-mobile-container" 
      class="fixed bottom-6 left-4 sm:left-6 md:bottom-8 md:left-8 z-50 lg:hidden opacity-0 pointer-events-none overflow-hidden bg-bg/85 backdrop-blur-xl border border-border-subtle/70 shadow-2xl shadow-black/25 transition-[width,height,border-radius,box-shadow,opacity,transform] duration-350 ease-[cubic-bezier(0.16,1,0.3,1)] select-none translate-y-3"
      style="width: 210px; height: 44px; border-radius: 9999px; transform: translateZ(0); will-change: width, height, border-radius;"
      aria-label="Mobile table of contents"
    >
      <!-- Top Header Bar (Fixed 44px) -->
      <div id="toc-mobile-header" class="relative h-11 w-full shrink-0 border-b border-transparent transition-colors duration-200">
        
        <!-- Layer A: Collapsed Pill View -->
        <button
          id="toc-mobile-pill-btn"
          type="button"
          class="absolute inset-0 w-full h-full flex items-center justify-between px-4 cursor-pointer text-left transition-opacity duration-200"
          aria-expanded="false"
          aria-controls="toc-mobile-body"
          aria-label="Expand table of contents"
        >
          <div class="flex items-center gap-2 overflow-hidden pr-1">
            <span class="font-serif italic text-accent text-xs font-normal leading-none shrink-0 select-none">§</span>
            <span id="toc-mobile-active-num" class="font-mono text-[10px] text-accent font-semibold tabular-nums shrink-0">01</span>
            <span id="toc-mobile-active-title" class="font-serif italic text-xs max-w-[130px] sm:max-w-[170px] truncate text-text-main/90">Contents</span>
          </div>
          <svg id="toc-mobile-chevron" class="w-3 h-3 text-text-muted/70 shrink-0 transition-transform duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="18 15 12 9 6 15"></polyline>
          </svg>
        </button>

        <!-- Layer B: Expanded Header View -->
        <div 
          id="toc-mobile-expanded-header" 
          class="absolute inset-0 w-full h-full flex items-center justify-between px-4 opacity-0 pointer-events-none transition-opacity duration-200"
        >
          <div class="flex items-center gap-2">
            <span class="font-serif italic text-accent text-xs leading-none shrink-0 select-none">§</span>
            <span class="font-mono text-[9.5px] uppercase tracking-[0.2em] text-text-muted font-medium">TABLE OF CONTENTS</span>
            <span class="font-mono text-[9px] text-accent font-semibold">[{items.length}]</span>
          </div>
          <button 
            id="toc-mobile-close-btn" 
            type="button" 
            class="w-6 h-6 flex items-center justify-center rounded-full bg-border-subtle/20 hover:bg-border-subtle/40 text-text-muted hover:text-accent text-xs font-mono transition-colors cursor-pointer" 
            aria-label="Close table of contents"
          >
            ✕
          </button>
        </div>
      </div>

      <!-- Scrollable List of Items (Revealed in Expanded State) -->
      <div 
        id="toc-mobile-body" 
        class="opacity-0 pointer-events-none h-[calc(100%-44px)] flex flex-col transition-opacity duration-200"
      >
        <div class="flex-1 overflow-y-auto px-2 py-2 scrollbar-none overscroll-contain">
          <ol class="space-y-0.5" id="toc-mobile-list">
            {items.map((item, idx) => {
              const num = String(idx + 1).padStart(2, '0');
              const isSub = item.level > 2;
              return (
                <li class="my-0.5">
                  <a
                    href={`#${item.id}`}
                    class={`toc-jump-link toc-mobile-link flex items-baseline gap-2.5 text-text-muted hover:text-text-main px-3 py-1.5 rounded-lg hover:bg-accent/10 active:bg-accent/15 transition-all text-xs leading-relaxed ${isSub ? "ml-3 pl-2.5 border-l border-border-subtle/50 text-[11px]" : ""}`}
                    data-id={item.id}
                    data-index={idx}
                  >
                    <span class="toc-mobile-item-num font-mono text-[11px] text-accent/80 font-semibold tabular-nums shrink-0">{num}</span>
                    <span class="toc-mobile-item-text font-sans truncate">{item.text}</span>
                  </a>
                </li>
              );
            })}
          </ol>
        </div>
      </div>
    </nav>
  </>
)}

<script>
  import anime from 'animejs';

  function initTocScrollIndicator() {
    let activeAnimInstance: any = null;
    let railEntranceAnim: any = null;
    let mobileEntranceAnim: any = null;
    let isRailVisible = false;
    let isMobileVisible = false;
    let activeIndex = -1;

    // 1. Elements for Inline TOC (Under Title)
    const inlineContainer = document.getElementById('toc-inline-container');
    const inlineHeader = document.getElementById('toc-inline-header');
    const inlineContent = document.getElementById('toc-inline-content');
    const inlineRows = document.querySelectorAll<HTMLElement>('.toc-inline-row');
    const toggleBtn = document.getElementById('toc-toggle-btn');
    const toggleText = document.getElementById('toc-toggle-text');
    const toggleIcon = document.getElementById('toc-toggle-icon');

    // Morphing Collapse / Expand Accordion
    if (toggleBtn && inlineContent && inlineHeader && toggleText && toggleIcon) {
      let isExpanded = true;
      inlineContent.style.height = 'auto';

      toggleBtn.addEventListener('click', () => {
        isExpanded = !isExpanded;
        toggleBtn.setAttribute('aria-expanded', String(isExpanded));
        if (isExpanded) {
          toggleText.textContent = 'Collapse';
          toggleIcon.style.transform = 'rotate(0deg)';
          inlineHeader.style.borderBottomColor = '';
          inlineContent.style.display = 'block';
          const fullHeight = inlineContent.scrollHeight;

          anime({
            targets: inlineContent,
            height: [0, fullHeight],
            opacity: [0, 1],
            duration: 380,
            easing: 'easeOutCubic',
            complete: () => {
              inlineContent.style.height = 'auto';
            }
          });

          anime({
            targets: '.toc-inline-row',
            translateY: [8, 0],
            opacity: [0, 1],
            delay: anime.stagger(20),
            duration: 300,
            easing: 'easeOutQuad'
          });
        } else {
          toggleText.textContent = 'Expand';
          toggleIcon.style.transform = 'rotate(180deg)';
          const startHeight = inlineContent.offsetHeight;

          anime({
            targets: inlineContent,
            height: [startHeight, 0],
            opacity: [1, 0],
            duration: 300,
            easing: 'easeInOutCubic',
            complete: () => {
              inlineContent.style.display = 'none';
              inlineHeader.style.borderBottomColor = 'transparent';
            }
          });
        }
      });
    }

    // 2. Elements for Floating Indicators
    const rail = document.getElementById('toc-floating-rail');
    const indicator = document.getElementById('toc-rail-indicator');
    const progressText = document.getElementById('toc-rail-progress');
    const railNodes = document.querySelectorAll<HTMLElement>('.toc-rail-node');
    const mobileContainer = document.getElementById('toc-mobile-container');
    const mobileScrim = document.getElementById('toc-mobile-scrim');
    const mobileHeader = document.getElementById('toc-mobile-header');
    const mobilePillBtn = document.getElementById('toc-mobile-pill-btn');
    const mobileExpandedHeader = document.getElementById('toc-mobile-expanded-header');
    const mobileCloseBtn = document.getElementById('toc-mobile-close-btn');
    const mobileBody = document.getElementById('toc-mobile-body');
    const mobileActiveNum = document.getElementById('toc-mobile-active-num');
    const mobileActiveTitle = document.getElementById('toc-mobile-active-title');
    const mobileChevron = document.getElementById('toc-mobile-chevron');
    const mobileLinks = document.querySelectorAll<HTMLElement>('.toc-mobile-link');

    const headings = Array.from(document.querySelectorAll<HTMLElement>('article h2, article h3, article h4'))
      .filter(h => h.id);

    if (!headings.length) return;

    // Mobile Morphing TOC Toggle
    let isMobileOpen = false;

    const openMobileToc = () => {
      if (isMobileOpen || !mobileContainer) return;
      isMobileOpen = true;

      const isTablet = window.innerWidth >= 640;
      const targetWidth = isTablet ? '380px' : 'calc(100vw - 2rem)';
      const targetHeight = Math.min(window.innerHeight * 0.58, 420) + 'px';

      if (mobileScrim) {
        mobileScrim.classList.remove('pointer-events-none');
        mobileScrim.classList.add('opacity-100');
      }

      // Suppress floating scroll-to-top button while TOC is expanded
      const scrollToTopBtn = document.getElementById('scroll-to-top-btn');
      if (scrollToTopBtn) {
        scrollToTopBtn.dataset.suppressed = 'true';
        scrollToTopBtn.style.transition = 'opacity 200ms ease, transform 200ms ease';
        scrollToTopBtn.style.opacity = '0';
        scrollToTopBtn.style.pointerEvents = 'none';
        scrollToTopBtn.style.transform = 'translateY(16px) scale(0.85)';
      }

      mobileContainer.style.width = targetWidth;
      mobileContainer.style.maxWidth = '380px';
      mobileContainer.style.height = targetHeight;
      mobileContainer.style.borderRadius = '16px';
      if (mobileHeader) mobileHeader.style.borderBottomColor = 'rgba(255, 255, 255, 0.08)';

      if (mobilePillBtn) {
        mobilePillBtn.classList.add('opacity-0', 'pointer-events-none');
        mobilePillBtn.setAttribute('aria-expanded', 'true');
      }
      if (mobileExpandedHeader) {
        mobileExpandedHeader.classList.remove('opacity-0', 'pointer-events-none');
        mobileExpandedHeader.classList.add('opacity-100', 'pointer-events-auto');
      }

      setTimeout(() => {
        if (mobileBody) {
          mobileBody.classList.remove('opacity-0', 'pointer-events-none');
          mobileBody.classList.add('opacity-100', 'pointer-events-auto');
        }
      }, 80);
    };

    const closeMobileToc = () => {
      if (!isMobileOpen || !mobileContainer) return;
      isMobileOpen = false;

      if (mobileScrim) {
        mobileScrim.classList.add('pointer-events-none');
        mobileScrim.classList.remove('opacity-100');
      }

      // Restore floating scroll-to-top button if reader is scrolled down
      const scrollToTopBtn = document.getElementById('scroll-to-top-btn');
      if (scrollToTopBtn) {
        delete scrollToTopBtn.dataset.suppressed;
        if (window.scrollY > 300) {
          scrollToTopBtn.style.opacity = '1';
          scrollToTopBtn.style.pointerEvents = 'auto';
          scrollToTopBtn.style.transform = 'translateY(0px) scale(1)';
        } else {
          scrollToTopBtn.style.opacity = '0';
          scrollToTopBtn.style.pointerEvents = 'none';
          scrollToTopBtn.style.transform = 'translateY(16px) scale(1)';
        }
        setTimeout(() => {
          if (scrollToTopBtn) {
            scrollToTopBtn.style.transition = '';
          }
        }, 250);
      }

      if (mobileBody) {
        mobileBody.classList.add('opacity-0', 'pointer-events-none');
        mobileBody.classList.remove('opacity-100', 'pointer-events-auto');
      }

      if (mobileExpandedHeader) {
        mobileExpandedHeader.classList.add('opacity-0', 'pointer-events-none');
        mobileExpandedHeader.classList.remove('opacity-100', 'pointer-events-auto');
      }
      if (mobilePillBtn) {
        mobilePillBtn.classList.remove('opacity-0', 'pointer-events-none');
        mobilePillBtn.setAttribute('aria-expanded', 'false');
      }
      if (mobileHeader) mobileHeader.style.borderBottomColor = 'transparent';

      mobileContainer.style.width = '210px';
      mobileContainer.style.height = '44px';
      mobileContainer.style.borderRadius = '9999px';
    };

    if (mobilePillBtn) {
      mobilePillBtn.addEventListener('click', openMobileToc);
    }
    if (mobileCloseBtn) {
      mobileCloseBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        closeMobileToc();
      });
    }
    if (mobileScrim) {
      mobileScrim.addEventListener('click', closeMobileToc);
    }

    const onOutsideClick = (e: MouseEvent) => {
      if (!isMobileOpen || !mobileContainer) return;
      const target = e.target as Node;
      if (!mobileContainer.contains(target) && !mobileScrim?.contains(target)) {
        closeMobileToc();
      }
    };
    document.addEventListener('click', onOutsideClick);

    const onKeydown = (e: KeyboardEvent) => {
      if (e.key === 'Escape' && isMobileOpen) {
        closeMobileToc();
      }
    };
    window.addEventListener('keydown', onKeydown);
    const updateActiveIndicator = (newIndex: number) => {
      if (newIndex === activeIndex || newIndex < 0 || newIndex >= headings.length) return;
      // Update Inline Rows
      inlineRows.forEach((row, idx) => {
        const numSpan = row.querySelector('.toc-inline-num');
        const titleSpan = row.querySelector('.toc-inline-title');
        if (idx === newIndex) {
          row.classList.add('is-active');
          if (numSpan) {
            numSpan.classList.add('text-accent', 'font-bold');
            numSpan.classList.remove('text-accent/80');
          }
          if (titleSpan) {
            titleSpan.classList.add('text-text-main', 'font-medium');
          }
        } else {
          row.classList.remove('is-active');
          if (numSpan) {
            numSpan.classList.remove('text-accent', 'font-bold');
            numSpan.classList.add('text-accent/80');
          }
          if (titleSpan) {
            titleSpan.classList.remove('text-text-main', 'font-medium');
          }
        }
      });


      activeIndex = newIndex;

      // Update Desktop Rail Nodes
      railNodes.forEach((node, idx) => {
        const numSpan = node.querySelector<HTMLElement>('.toc-rail-num');
        const titleSpan = node.querySelector<HTMLElement>('.toc-rail-title');
        if (idx === newIndex) {
          node.classList.add('is-active');
          if (numSpan) {
            numSpan.classList.add('text-accent', 'font-semibold', 'translate-x-1');
            numSpan.classList.remove('text-text-muted/60');
          }
          if (titleSpan) {
            titleSpan.classList.add('text-text-main', 'font-serif', 'italic', 'opacity-100');
            titleSpan.classList.remove('opacity-70', 'text-accent');
          }
        } else {
          node.classList.remove('is-active');
          if (numSpan) {
            numSpan.classList.remove('text-accent', 'font-semibold', 'translate-x-1');
            numSpan.classList.add('text-text-muted/60');
          }
          if (titleSpan) {
            titleSpan.classList.remove('text-text-main', 'font-serif', 'italic', 'opacity-100');
            titleSpan.classList.add('opacity-70');
          }
        }
      });

      // Animate Vertical Pin on Rail via smooth hardware-accelerated transition
      if (indicator && railNodes[newIndex]) {
        const targetNode = railNodes[newIndex];
        const targetTop = targetNode.offsetTop;
        const targetHeight = targetNode.offsetHeight;

        indicator.style.top = `${targetTop}px`;
        indicator.style.height = `${targetHeight}px`;
      }

      // Update Mobile Pill Label
      if (headings[newIndex]) {
        const currentH = headings[newIndex];
        const cleanText = currentH.textContent?.trim() || '';
        const numStr = String(newIndex + 1).padStart(2, '0');
        if (mobileActiveNum) mobileActiveNum.textContent = numStr;
        if (mobileActiveTitle) mobileActiveTitle.textContent = cleanText;
      }

      // Update Mobile Expanded Links
      mobileLinks.forEach((link, idx) => {
        const itemNum = link.querySelector('.toc-mobile-item-num');
        const itemText = link.querySelector('.toc-mobile-item-text');
        if (idx === newIndex) {
          link.classList.add('bg-accent/10', 'text-text-main', 'font-medium');
          if (itemNum) itemNum.classList.add('text-accent', 'font-bold');
          if (itemText) itemText.classList.add('text-text-main', 'font-serif', 'italic');
        } else {
          link.classList.remove('bg-accent/10', 'text-text-main', 'font-medium');
          if (itemNum) itemNum.classList.remove('text-accent', 'font-bold');
          if (itemText) itemText.classList.remove('text-text-main', 'font-serif', 'italic');
        }
      });
    };
    // Helper: Determine corresponding TOC heading index for ANY element
    const findHeadingIndexForElement = (el: HTMLElement): number => {
      const directIdx = headings.indexOf(el);
      if (directIdx !== -1) return directIdx;

      let candidateIdx = -1;
      for (let i = 0; i < headings.length; i++) {
        const pos = el.compareDocumentPosition(headings[i]);
        if (pos & Node.DOCUMENT_POSITION_PRECEDING) {
          candidateIdx = i;
        }
      }
      if (candidateIdx !== -1) return candidateIdx;

      const firstPos = el.compareDocumentPosition(headings[0]);
      if (firstPos & Node.DOCUMENT_POSITION_FOLLOWING) {
        return 0;
      }
      return headings.length - 1;
    };

    // Smooth Scroll All Anchor Links (TOC headings, Citations [1], Footnotes) to CENTER of Viewport
    let isClickScrolling = false;
    let clickScrollTimer: any = null;

    const stopClickLock = () => {
      isClickScrolling = false;
      if (clickScrollTimer) clearTimeout(clickScrollTimer);
    };
    window.addEventListener('wheel', stopClickLock, { passive: true });
    window.addEventListener('touchmove', stopClickLock, { passive: true });

    const allAnchorLinks = document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]');
    allAnchorLinks.forEach(link => {
      link.addEventListener('click', (e) => {
        const href = link.getAttribute('href');
        if (!href || href === '#' || !href.startsWith('#')) return;
        const targetId = href.slice(1);
        const target = document.getElementById(targetId);
        if (!target) return;

        e.preventDefault();
        closeMobileToc();

        // 1. Instantly calculate and update active indicator for this section
        const targetIdx = findHeadingIndexForElement(target);
        updateActiveIndicator(targetIdx);

        // Lock scroll spy so intermediate scroll updates don't overwrite user selection
        isClickScrolling = true;
        if (clickScrollTimer) clearTimeout(clickScrollTimer);

        // 2. Scroll element to CENTER of the screen
        const targetRect = target.getBoundingClientRect();
        const currentScroll = window.scrollY;
        const targetCenterOffset = currentScroll + targetRect.top - (window.innerHeight / 2) + (targetRect.height / 2);
        const clampedOffset = Math.max(0, targetCenterOffset);

        const onScrollEnd = () => {
          updateActiveIndicator(targetIdx);
          clickScrollTimer = setTimeout(() => {
            isClickScrolling = false;
          }, 150);
        };

        if ((window as any).lenis) {
          (window as any).lenis.scrollTo(clampedOffset, {
            duration: 1.2,
            onComplete: onScrollEnd
          });
        } else {
          window.scrollTo({ top: clampedOffset, behavior: 'smooth' });
          onScrollEnd();
        }

        // Safety timer to unlock scroll-spy if onComplete doesn't fire
        clickScrollTimer = setTimeout(() => {
          isClickScrolling = false;
        }, 1350);

        // 3. Trigger visual flash highlight on target element
        target.classList.remove('anchor-highlight');
        void (target as HTMLElement).offsetWidth;
        target.classList.add('anchor-highlight');
        setTimeout(() => {
          target.classList.remove('anchor-highlight');
        }, 2200);

        history.pushState(null, '', href);
      });
    });
    // Scroll Handler
    const onScroll = () => {
      const scrollY = window.scrollY;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const triggerThreshold = inlineContainer 
        ? inlineContainer.offsetTop + inlineContainer.offsetHeight 
        : 350;

      // 1. Entrance / Exit of Desktop Rail via anime.js
      if (rail) {
        if (scrollY > triggerThreshold) {
          if (!isRailVisible) {
            isRailVisible = true;
            rail.classList.remove('pointer-events-none');
            if (railEntranceAnim) railEntranceAnim.pause();
            railEntranceAnim = anime({
              targets: rail,
              opacity: [0, 1],
              duration: 400,
              easing: 'easeOutCubic'
            });
          }
        } else {
          if (isRailVisible) {
            isRailVisible = false;
            rail.classList.add('pointer-events-none');
            if (railEntranceAnim) railEntranceAnim.pause();
            railEntranceAnim = anime({
              targets: rail,
              opacity: [1, 0],
              duration: 300,
              easing: 'easeInQuad'
            });
          }
        }
      }

      // 2. Entrance / Exit of Mobile Pill via anime.js
      // 2. Entrance / Exit of Mobile Morphing Container via anime.js
      if (mobileContainer) {
        if (scrollY > triggerThreshold) {
          if (!isMobileVisible) {
            isMobileVisible = true;
            mobileContainer.classList.remove('pointer-events-none');
            if (mobileEntranceAnim) mobileEntranceAnim.pause();
            mobileEntranceAnim = anime({
              targets: mobileContainer,
              opacity: [0, 1],
              translateY: [12, 0],
              duration: 400,
              easing: 'easeOutCubic'
            });
          }
        } else {
          if (isMobileVisible) {
            isMobileVisible = false;
            mobileContainer.classList.add('pointer-events-none');
            closeMobileToc();
            if (mobileEntranceAnim) mobileEntranceAnim.pause();
            mobileEntranceAnim = anime({
              targets: mobileContainer,
              opacity: [1, 0],
              translateY: [0, 12],
              duration: 300,
              easing: 'easeInQuad'
            });
          }
        }
      }

      // 3. Update Progress Percentage Text
      if (progressText && docHeight > 0) {
        const pct = Math.min(100, Math.max(0, Math.round((scrollY / docHeight) * 100)));
        progressText.textContent = `${pct}%`;
      }
      // If user recently clicked a TOC link, preserve the target heading until smooth scroll finishes
      if (isClickScrolling) return;

      // 4. Calculate Active Heading when heading crosses activation zone (upper-middle viewport)
      const activationLine = window.innerHeight * 0.55;
      let currentIdx = 0;

      for (let i = 0; i < headings.length; i++) {
        const rect = headings[i].getBoundingClientRect();
        if (rect.top <= activationLine) {
          currentIdx = i;
        } else {
          break;
        }
      }

      // If reader scrolled to the very end of the document (within 40px of maximum scroll)
      // and the last heading is visibly inside the viewport, activate the last heading
      if (docHeight > 0 && scrollY >= docHeight - 40) {
        const lastHeading = headings[headings.length - 1];
        if (lastHeading) {
          const lastRect = lastHeading.getBoundingClientRect();
          if (lastRect.top <= window.innerHeight * 0.85) {
            currentIdx = headings.length - 1;
          }
        }
      }

      updateActiveIndicator(currentIdx);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    if ((window as any).lenis) {
      (window as any).lenis.on('scroll', onScroll);
    }
    // Initial run
    onScroll();

    // Cleanup when navigating with Astro View Transitions
    document.addEventListener('astro:before-swap', () => {
      window.removeEventListener('scroll', onScroll);
      window.removeEventListener('resize', onScroll);
      window.removeEventListener('wheel', stopClickLock);
      window.removeEventListener('touchmove', stopClickLock);
      document.removeEventListener('click', onOutsideClick);
      window.removeEventListener('keydown', onKeydown);
      if ((window as any).lenis) {
        (window as any).lenis.off('scroll', onScroll);
      }
      if (activeAnimInstance) activeAnimInstance.pause();
      if (railEntranceAnim) railEntranceAnim.pause();
      if (mobileEntranceAnim) mobileEntranceAnim.pause();
    }, { once: true });
  }

  document.addEventListener('astro:page-load', initTocScrollIndicator);
  if (document.readyState === 'complete') initTocScrollIndicator();
  else window.addEventListener('DOMContentLoaded', initTocScrollIndicator);
</script>
