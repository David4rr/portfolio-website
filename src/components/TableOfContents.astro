---
export interface TocItem {
  id: string;
  text: string;
  level: number;
}

interface Props {
  items: TocItem[];
}

const { items } = Astro.props;
const hasItems = items && items.length >= 2;
---

{hasItems && (
  <>
    {/* 1. Inline Editorial Overview at top of article (Under Title) */}
    <nav 
      id="toc-inline-container" 
      class="toc-card relative my-10 md:my-12 overflow-hidden rounded-xl border border-border-subtle/60 shadow-lg shadow-black/5 select-none transition-all duration-300" 
      aria-label="Table of contents overview"
    >
      <!-- Stationary Decoupled Frosted Glass Backdrop (Matches Terminal Card Spec) -->
      <div class="toc-backdrop absolute inset-0 -z-10 bg-bg/65 backdrop-blur-xl backdrop-saturate-150"></div>

      <!-- Header Bar -->
      <div id="toc-inline-header" class="flex items-center justify-between border-b border-border-subtle/50 px-3 sm:px-4 md:px-5 py-2.5 sm:py-3 bg-bg-subtle/30 transition-colors duration-200">
        <div class="flex items-center gap-2 sm:gap-2.5">
          <span class="font-serif italic text-accent text-xs leading-none select-none">§</span>
          <span class="font-mono text-[9px] sm:text-[10px] md:text-[11px] uppercase tracking-[0.18em] sm:tracking-[0.25em] text-text-muted font-medium">
            TABLE OF CONTENTS
          </span>
          <span class="font-mono text-[9px] text-accent/90 tabular-nums font-semibold tracking-wider">
            [{items.length}]
          </span>
        </div>
        <button 
          id="toc-toggle-btn"
          type="button"
          class="group flex items-center gap-1.5 font-mono text-[10px] uppercase tracking-wider text-text-muted hover:text-accent transition-colors duration-200 cursor-pointer"
          aria-expanded="true"
          aria-controls="toc-inline-content"
        >
          <span id="toc-toggle-text">Collapse</span>
          <svg id="toc-toggle-icon" class="w-3.5 h-3.5 text-text-muted group-hover:text-accent transition-transform duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="18 15 12 9 6 15"></polyline>
          </svg>
        </button>
      </div>

      <!-- Expandable / Collapsible Content Wrapper -->
      <div id="toc-inline-content" class="overflow-hidden">
        <div id="toc-inline-body" class="p-3 md:p-4 relative">
          <ol id="toc-inline-list" class="space-y-1">
            {items.map((item, index) => {
              const num = String(index + 1).padStart(2, '0');
              const isSub = item.level > 2;
              return (
                <li 
                  class={`toc-inline-row relative group rounded-lg transition-colors duration-200 ${isSub ? "ml-4 md:ml-6 pl-3 border-l border-border-subtle/50 my-0.5" : "my-0.5"}`}
                  data-index={index}
                  data-id={item.id}
                >
                  <a 
                    href={`#${item.id}`}
                    data-toc-id={item.id}
                    class="toc-jump-link flex items-baseline gap-3 px-3 py-1.5 text-text-muted hover:text-text-main transition-colors text-xs md:text-sm leading-relaxed rounded-md select-none"
                  >
                    <span class="toc-inline-num font-mono text-[10px] md:text-[11px] text-accent/80 group-hover:text-accent tabular-nums select-none shrink-0 font-medium transition-all duration-200">
                      {num}
                    </span>
                    <span class="toc-inline-title font-sans transition-colors duration-200 group-hover:text-text-main">
                      {item.text}
                    </span>
                  </a>
                </li>
              );
            })}
          </ol>
        </div>
      </div>
    </nav>

    {/* 2. Desktop Floating Anime.js Scroll Indicator Rail (Clean Frameless Floating Rail) */}
    <aside
      id="toc-floating-rail"
      class="fixed left-4 xl:left-8 2xl:left-12 top-1/2 -translate-y-1/2 z-40 hidden lg:flex flex-col select-none pointer-events-auto opacity-0 transition-opacity duration-300 max-h-[85vh]"
      aria-label="Reading section indicator"
    >
      <!-- Rail Header & Progress Counter -->
      <div class="mb-3.5 flex items-center gap-2 pl-3">
        <span class="font-serif italic text-accent text-xs font-normal select-none leading-none">§</span>
        <span class="font-mono text-[9px] uppercase tracking-[0.25em] text-text-muted/70 font-medium">INDEX</span>
        <span class="text-border-subtle/70 text-[9px] font-mono select-none">/</span>
        <span id="toc-rail-progress" class="font-mono text-[9px] text-accent font-semibold tabular-nums">0%</span>
      </div>

      <!-- Rail Items with Dynamic Cursor Track -->
      <div id="toc-rail-track" class="relative flex flex-col py-2 pl-3 border-l border-border-subtle/40 overflow-y-auto max-h-[calc(85vh-2.5rem)] scrollbar-none">
        <!-- Animated Active Indicator Pin (Refined Editorial Margin Needle) -->
        <div
          id="toc-rail-indicator"
          class="absolute -left-[1px] w-[2px] bg-accent rounded-[1px] pointer-events-none origin-center transition-[top,height] duration-300 ease-out"
          style="top: 0px; height: 24px;"
        >
          <span class="absolute top-1/2 -translate-y-1/2 left-[2px] w-1.5 h-[1.5px] bg-accent"></span>
        </div>

        <!-- Section Nodes -->
        <div class="space-y-3.5" id="toc-rail-items-container">
          {items.map((item, idx) => {
            const num = String(idx + 1).padStart(2, '0');
            return (
              <div 
                class="toc-rail-node group relative flex items-center" 
                data-index={idx} 
                data-id={item.id}
              >
                <a
                  href={`#${item.id}`}
                  class="toc-jump-link flex items-center gap-2.5 py-1 text-text-muted/60 hover:text-text-main transition-colors duration-200"
                  aria-label={`Jump to section ${num}: ${item.text}`}
                >
                  <span class="toc-rail-num font-mono text-[11px] tabular-nums font-medium transition-all duration-300">
                    {num}
                  </span>
                  <!-- Expanding Title Ribbon on Hover -->
                  <span class="toc-rail-title font-sans text-xs tracking-tight whitespace-nowrap overflow-hidden max-w-[95px] xl:max-w-[200px] 2xl:max-w-[230px] truncate opacity-70 group-hover:opacity-100 group-hover:text-accent transition-all duration-200">
                    {item.text}
                  </span>
                </a>
              </div>
            );
          })}
        </div>
      </div>
    </aside>

    {/* 3. Mobile Scrim / Click-Catcher */}
    <div 
      id="toc-mobile-scrim" 
      class="fixed inset-0 z-45 bg-black/25 opacity-0 pointer-events-none transition-opacity duration-300 lg:hidden"
      aria-hidden="true"
    ></div>

    {/* Mobile / Tablet Morphing TOC Container (Frosted Glass) */}
    <nav 
      id="toc-mobile-container" 
      class="fixed bottom-6 left-4 sm:left-6 md:bottom-8 md:left-8 z-50 lg:hidden opacity-0 pointer-events-none overflow-hidden bg-bg/85 backdrop-blur-xl border border-border-subtle/70 shadow-2xl shadow-black/25 transition-[width,height,border-radius,box-shadow,opacity,transform] duration-350 ease-[cubic-bezier(0.16,1,0.3,1)] select-none translate-y-3"
      style="width: 210px; height: 44px; border-radius: 9999px; transform: translateZ(0); will-change: width, height, border-radius;"
      aria-label="Mobile table of contents"
    >
      <!-- Top Header Bar (Fixed 44px) -->
      <div id="toc-mobile-header" class="relative h-11 w-full shrink-0 border-b border-transparent transition-colors duration-200">
        
        <!-- Layer A: Collapsed Pill View -->
        <button
          id="toc-mobile-pill-btn"
          type="button"
          class="absolute inset-0 w-full h-full flex items-center justify-between px-4 cursor-pointer text-left transition-opacity duration-200"
          aria-expanded="false"
          aria-controls="toc-mobile-body"
          aria-label="Expand table of contents"
        >
          <div class="flex items-center gap-2 overflow-hidden pr-1">
            <span class="font-serif italic text-accent text-xs font-normal leading-none shrink-0 select-none">§</span>
            <span id="toc-mobile-active-num" class="font-mono text-[10px] text-accent font-semibold tabular-nums shrink-0">01</span>
            <span id="toc-mobile-active-title" class="font-serif italic text-xs max-w-[130px] sm:max-w-[170px] truncate text-text-main/90">Contents</span>
          </div>
          <svg id="toc-mobile-chevron" class="w-3 h-3 text-text-muted/70 shrink-0 transition-transform duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="18 15 12 9 6 15"></polyline>
          </svg>
        </button>

        <!-- Layer B: Expanded Header View -->
        <div 
          id="toc-mobile-expanded-header" 
          class="absolute inset-0 w-full h-full flex items-center justify-between px-4 opacity-0 pointer-events-none transition-opacity duration-200"
        >
          <div class="flex items-center gap-2">
            <span class="font-serif italic text-accent text-xs leading-none shrink-0 select-none">§</span>
            <span class="font-mono text-[9.5px] uppercase tracking-[0.2em] text-text-muted font-medium">TABLE OF CONTENTS</span>
            <span class="font-mono text-[9px] text-accent font-semibold">[{items.length}]</span>
          </div>
          <button 
            id="toc-mobile-close-btn" 
            type="button" 
            class="w-6 h-6 flex items-center justify-center rounded-full bg-border-subtle/20 hover:bg-border-subtle/40 text-text-muted hover:text-accent text-xs font-mono transition-colors cursor-pointer" 
            aria-label="Close table of contents"
          >
            ✕
          </button>
        </div>
      </div>

      <!-- Scrollable List of Items (Revealed in Expanded State) -->
      <div 
        id="toc-mobile-body" 
        class="opacity-0 pointer-events-none h-[calc(100%-44px)] flex flex-col transition-opacity duration-200"
      >
        <div class="flex-1 overflow-y-auto px-2 py-2 scrollbar-none overscroll-contain">
          <ol class="space-y-0.5" id="toc-mobile-list">
            {items.map((item, idx) => {
              const num = String(idx + 1).padStart(2, '0');
              const isSub = item.level > 2;
              return (
                <li class="my-0.5">
                  <a
                    href={`#${item.id}`}
                    class={`toc-jump-link toc-mobile-link flex items-baseline gap-2.5 text-text-muted hover:text-text-main px-3 py-1.5 rounded-lg hover:bg-accent/10 active:bg-accent/15 transition-all text-xs leading-relaxed ${isSub ? "ml-3 pl-2.5 border-l border-border-subtle/50 text-[11px]" : ""}`}
                    data-id={item.id}
                    data-index={idx}
                  >
                    <span class="toc-mobile-item-num font-mono text-[11px] text-accent/80 font-semibold tabular-nums shrink-0">{num}</span>
                    <span class="toc-mobile-item-text font-sans truncate">{item.text}</span>
                  </a>
                </li>
              );
            })}
          </ol>
        </div>
      </div>
    </nav>
  </>
)}

<script>
  import '../scripts/toc-controller';
</script>
