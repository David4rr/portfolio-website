---
import { type TocItem } from './TableOfContents.astro';

export interface TocItem {
  id: string;
  text: string;
  level: number;
}

interface Props {
  items: TocItem[];
}

const { items } = Astro.props;
const hasItems = items && items.length >= 2;
---

{hasItems && (
  <>
    {/* 1. Inline Editorial Overview at top of article */}
    <nav 
      id="toc-inline-container" 
      class="my-10 md:my-12 p-5 md:p-6 rounded-md bg-bg/50 backdrop-blur-xl border border-border-subtle/50 transition-colors duration-300 select-none shadow-sm" 
      aria-label="Table of contents overview"
    >
      <div class="flex items-center justify-between gap-4 border-b border-border-subtle/40 pb-3 mb-4">
        <div class="flex items-center gap-2.5">
          <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span>
          <span class="font-mono text-[10px] md:text-[11px] uppercase tracking-[0.25em] text-text-muted font-medium">
            Table of Contents
          </span>
          <span class="font-mono text-[9px] text-text-muted/60 tracking-wider">
            [{items.length} sections]
          </span>
        </div>
        <button 
          id="toc-toggle-btn"
          type="button"
          class="text-text-muted hover:text-accent font-mono text-[10px] uppercase tracking-wider flex items-center gap-1 cursor-pointer transition-colors"
          aria-expanded="true"
          aria-controls="toc-inline-list"
        >
          <span id="toc-toggle-text">Collapse</span>
          <svg id="toc-toggle-icon" class="w-3 h-3 transition-transform duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="18 15 12 9 6 15"></polyline>
          </svg>
        </button>
      </div>

      <ol id="toc-inline-list" class="space-y-2.5 overflow-hidden transition-all duration-300">
        {items.map((item, index) => {
          const num = String(index + 1).padStart(2, '0');
          const isSub = item.level > 2;
          return (
            <li class={isSub ? "ml-4 md:ml-6 border-l border-border-subtle/50 pl-3 my-1.5" : "my-1"}>
              <a 
                href={`#${item.id}`}
                data-toc-id={item.id}
                class="toc-jump-link group flex items-baseline gap-2.5 text-text-muted hover:text-text-main transition-colors text-xs md:text-sm leading-relaxed"
              >
                <span class="font-mono text-[10px] md:text-[11px] text-accent/80 group-hover:text-accent tabular-nums select-none shrink-0 font-medium">
                  {num}
                </span>
                <span class="group-hover:translate-x-0.5 transition-transform duration-200">
                  {item.text}
                </span>
              </a>
            </li>
          );
        })}
      </ol>
    </nav>

    {/* 2. Desktop Floating Anime.js Scroll Indicator Rail (Frosted Glass Console) */}
    <aside
      id="toc-floating-rail"
      class="fixed left-4 xl:left-8 top-1/2 -translate-y-1/2 z-40 hidden lg:flex flex-col select-none pointer-events-auto opacity-0 -translate-x-8 p-3.5 pr-4 rounded-2xl bg-bg/60 backdrop-blur-xl border border-border-subtle/50 shadow-2xl shadow-black/10 transition-opacity duration-300"
      aria-label="Reading section indicator"
    >
      <!-- Rail Header & Progress Counter -->
      <div class="mb-3 flex items-center gap-2 pl-3">
        <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse shrink-0"></span>
        <span class="font-mono text-[9px] uppercase tracking-[0.25em] text-text-muted/80 font-medium">INDEX</span>
        <span id="toc-rail-progress" class="font-mono text-[9px] text-accent font-semibold tabular-nums">0%</span>
      </div>

      <!-- Rail Items with Dynamic Cursor Track -->
      <div id="toc-rail-track" class="relative flex flex-col py-2 pl-3 border-l border-border-subtle/40">
        <!-- Animated Active Indicator Pin (Driven by anime.js) -->
        <div
          id="toc-rail-indicator"
          class="absolute -left-[2px] w-[3px] bg-accent rounded-full shadow-[0_0_10px_rgba(255,107,53,0.7)] pointer-events-none origin-center"
          style="top: 0px; height: 24px;"
        ></div>

        <!-- Section Nodes -->
        <div class="space-y-3.5" id="toc-rail-items-container">
          {items.map((item, idx) => {
            const num = String(idx + 1).padStart(2, '0');
            return (
              <div 
                class="toc-rail-node group relative flex items-center" 
                data-index={idx} 
                data-id={item.id}
              >
                <a
                  href={`#${item.id}`}
                  class="toc-jump-link flex items-center gap-2.5 py-1 text-text-muted/60 hover:text-text-main transition-colors duration-200"
                  aria-label={`Jump to section ${num}: ${item.text}`}
                >
                  <span class="toc-rail-num font-mono text-[11px] tabular-nums font-medium transition-all duration-300">
                    {num}
                  </span>
                  <!-- Expanding Title Ribbon on Hover -->
                  <span class="toc-rail-title font-sans text-xs tracking-tight whitespace-nowrap overflow-hidden max-w-[170px] xl:max-w-[210px] truncate opacity-70 group-hover:opacity-100 group-hover:text-accent transition-all duration-200">
                    {item.text}
                  </span>
                </a>
              </div>
            );
          })}
        </div>
      </div>
    </aside>

    {/* 3. Mobile / Tablet Floating Pill Indicator (Frosted Glass) */}
    <div 
      id="toc-mobile-pill" 
      class="fixed bottom-6 left-6 z-40 lg:hidden opacity-0 translate-y-6 pointer-events-none transition-all duration-300"
    >
      <button
        id="toc-mobile-toggle-btn"
        type="button"
        class="flex items-center gap-2.5 px-3.5 py-2.5 rounded-full bg-bg/75 backdrop-blur-xl border border-border-subtle/70 shadow-xl shadow-black/20 text-xs text-text-main hover:border-accent active:scale-95 transition-all duration-200"
        aria-label="Table of contents menu"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse shrink-0"></span>
        <span id="toc-mobile-active-num" class="font-mono text-[10px] text-accent font-semibold tabular-nums shrink-0">01</span>
        <span id="toc-mobile-active-title" class="font-sans text-[11px] max-w-[130px] sm:max-w-[180px] truncate text-text-muted">Contents</span>
        <svg id="toc-mobile-chevron" class="w-3 h-3 text-text-muted/70 transition-transform duration-300 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="18 15 12 9 6 15"></polyline>
        </svg>
      </button>
    </div>

    {/* Mobile Popover Drawer (Frosted Glass) */}
    <div 
      id="toc-mobile-drawer" 
      class="fixed inset-x-4 bottom-20 z-40 lg:hidden hidden bg-bg/85 backdrop-blur-2xl border border-border-subtle/80 rounded-lg p-5 shadow-2xl shadow-black/40 max-h-[60vh] overflow-y-auto"
    >
      <div class="flex items-center justify-between pb-3 mb-3 border-b border-border-subtle/40">
        <div class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
          <span class="font-mono text-[10px] uppercase tracking-[0.2em] text-text-muted font-medium">TABLE OF CONTENTS</span>
          <span class="font-mono text-[9px] text-accent">[{items.length}]</span>
        </div>
        <button id="toc-mobile-close-btn" type="button" class="text-text-muted hover:text-accent text-xs font-mono p-1">✕</button>
      </div>
      <ol class="space-y-3">
        {items.map((item, idx) => {
          const num = String(idx + 1).padStart(2, '0');
          return (
            <li>
              <a
                href={`#${item.id}`}
                class="toc-jump-link toc-mobile-link flex items-baseline gap-2.5 text-text-muted hover:text-text-main py-1"
                data-id={item.id}
                data-num={num}
              >
                <span class="font-mono text-xs text-accent font-semibold tabular-nums shrink-0">{num}</span>
                <span class="font-sans text-xs leading-relaxed">{item.text}</span>
              </a>
            </li>
          );
        })}
      </ol>
    </div>
  </>
)}

<script>
  import anime from 'animejs';

  let activeAnimInstance: any = null;
  let railEntranceAnim: any = null;
  let mobileEntranceAnim: any = null;
  let isRailVisible = false;
  let isMobileVisible = false;
  let activeIndex = -1;
  let isProgrammaticScroll = false;
  let scrollUnlockTimeout: any = null;

  function initTocScrollIndicator() {
    // 1. Inline Toggle Button (Top Card)
    const toggleBtn = document.getElementById('toc-toggle-btn');
    const inlineList = document.getElementById('toc-inline-list');
    const toggleText = document.getElementById('toc-toggle-text');
    const toggleIcon = document.getElementById('toc-toggle-icon');

    if (toggleBtn && inlineList && toggleText && toggleIcon) {
      let isExpanded = true;
      toggleBtn.addEventListener('click', () => {
        isExpanded = !isExpanded;
        toggleBtn.setAttribute('aria-expanded', String(isExpanded));
        if (isExpanded) {
          inlineList.style.display = 'block';
          toggleText.textContent = 'Collapse';
          toggleIcon.style.transform = 'rotate(0deg)';
        } else {
          inlineList.style.display = 'none';
          toggleText.textContent = 'Expand';
          toggleIcon.style.transform = 'rotate(180deg)';
        }
      });
    }

    // 2. Elements for Floating Indicators
    const rail = document.getElementById('toc-floating-rail');
    const indicator = document.getElementById('toc-rail-indicator');
    const progressText = document.getElementById('toc-rail-progress');
    const railNodes = document.querySelectorAll<HTMLElement>('.toc-rail-node');
    const inlineContainer = document.getElementById('toc-inline-container');
    const mobilePill = document.getElementById('toc-mobile-pill');
    const mobileToggleBtn = document.getElementById('toc-mobile-toggle-btn');
    const mobileDrawer = document.getElementById('toc-mobile-drawer');
    const mobileCloseBtn = document.getElementById('toc-mobile-close-btn');
    const mobileActiveNum = document.getElementById('toc-mobile-active-num');
    const mobileActiveTitle = document.getElementById('toc-mobile-active-title');
    const mobileChevron = document.getElementById('toc-mobile-chevron');

    const headings = Array.from(document.querySelectorAll<HTMLElement>('article h2, article h3, article h4'))
      .filter(h => h.id);

    if (!headings.length) return;

    // Mobile Drawer Toggle
    let isDrawerOpen = false;
    const closeDrawer = () => {
      if (!isDrawerOpen || !mobileDrawer) return;
      isDrawerOpen = false;
      if (mobileChevron) mobileChevron.style.transform = 'rotate(0deg)';
      anime({
        targets: mobileDrawer,
        opacity: [1, 0],
        translateY: [0, 15],
        duration: 200,
        easing: 'easeInQuad',
        complete: () => {
          mobileDrawer.classList.add('hidden');
        }
      });
    };

    const openDrawer = () => {
      if (isDrawerOpen || !mobileDrawer) return;
      isDrawerOpen = true;
      if (mobileChevron) mobileChevron.style.transform = 'rotate(180deg)';
      mobileDrawer.classList.remove('hidden');
      anime({
        targets: mobileDrawer,
        opacity: [0, 1],
        translateY: [15, 0],
        duration: 300,
        easing: 'easeOutCubic'
      });

      anime({
        targets: '.toc-mobile-link',
        opacity: [0, 1],
        translateY: [10, 0],
        delay: anime.stagger(30),
        duration: 350,
        easing: 'easeOutQuad'
      });
    };

    if (mobileToggleBtn) {
      mobileToggleBtn.addEventListener('click', () => {
        if (isDrawerOpen) closeDrawer();
        else openDrawer();
      });
    }

    if (mobileCloseBtn) {
      mobileCloseBtn.addEventListener('click', closeDrawer);
    }

    // Animate Indicator to Node Index using anime.js
    const updateActiveIndicator = (newIndex: number) => {
      if (newIndex === activeIndex || newIndex < 0 || newIndex >= headings.length) return;
      activeIndex = newIndex;

      // Update Desktop Rail Nodes
      railNodes.forEach((node, idx) => {
        const numSpan = node.querySelector('.toc-rail-num');
        const titleSpan = node.querySelector('.toc-rail-title');
        if (idx === newIndex) {
          node.classList.add('is-active');
          if (numSpan) {
            numSpan.classList.add('text-accent', 'font-bold');
            numSpan.classList.remove('text-text-muted/60');
            // Elastic bounce on active number
            anime({
              targets: numSpan,
              scale: [1, 1.3, 1],
              duration: 450,
              easing: 'easeOutElastic(1, .6)'
            });
          }
          if (titleSpan) {
            titleSpan.classList.add('text-accent', 'opacity-100');
          }
        } else {
          node.classList.remove('is-active');
          if (numSpan) {
            numSpan.classList.remove('text-accent', 'font-bold');
            numSpan.classList.add('text-text-muted/60');
          }
          if (titleSpan) {
            titleSpan.classList.remove('text-accent', 'opacity-100');
          }
        }
      });

      // Animate Vertical Pin on Rail via anime.js
      if (indicator && railNodes[newIndex]) {
        const targetNode = railNodes[newIndex];
        const targetTop = targetNode.offsetTop;
        const targetHeight = targetNode.offsetHeight;

        if (activeAnimInstance) activeAnimInstance.pause();
        activeAnimInstance = anime({
          targets: indicator,
          top: `${targetTop}px`,
          height: `${targetHeight}px`,
          scaleY: [1.2, 1],
          duration: 400,
          easing: 'easeOutCubic'
        });
      }

      // Update Mobile Pill Label
      if (headings[newIndex]) {
        const currentH = headings[newIndex];
        const cleanText = currentH.textContent?.trim() || '';
        const numStr = String(newIndex + 1).padStart(2, '0');
        if (mobileActiveNum) mobileActiveNum.textContent = numStr;
        if (mobileActiveTitle) mobileActiveTitle.textContent = cleanText;
      }
    };

    // Smooth Scroll Links - Center Heading in Viewport & Instant Indicator Switch
    const jumpLinks = document.querySelectorAll<HTMLAnchorElement>('.toc-jump-link');
    jumpLinks.forEach(link => {
      link.addEventListener('click', (e) => {
        const href = link.getAttribute('href');
        if (!href || !href.startsWith('#')) return;
        const targetId = href.slice(1);
        const target = document.getElementById(targetId);
        if (!target) return;

        e.preventDefault();
        closeDrawer();

        // 1. Instantly switch indicator to target heading index
        const targetIdx = headings.findIndex(h => h.id === targetId);
        if (targetIdx !== -1) {
          updateActiveIndicator(targetIdx);
        }

        // 2. Lock programmatic scroll so onScroll doesn't fight while animating
        isProgrammaticScroll = true;
        if (scrollUnlockTimeout) clearTimeout(scrollUnlockTimeout);
        scrollUnlockTimeout = setTimeout(() => {
          isProgrammaticScroll = false;
        }, 1200);

        // 3. Scroll heading to EXACT CENTER of the screen
        const targetRect = target.getBoundingClientRect();
        const currentScroll = window.scrollY;
        const targetCenterOffset = currentScroll + targetRect.top - (window.innerHeight / 2) + (targetRect.height / 2);
        const clampedOffset = Math.max(0, targetCenterOffset);

        if ((window as any).lenis) {
          (window as any).lenis.scrollTo(clampedOffset, { duration: 1.2 });
        } else {
          window.scrollTo({ top: clampedOffset, behavior: 'smooth' });
        }
        history.pushState(null, '', href);
      });
    });

    // Scroll Handler
    const onScroll = () => {
      const scrollY = window.scrollY;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const triggerThreshold = inlineContainer 
        ? inlineContainer.offsetTop + inlineContainer.offsetHeight 
        : 350;

      // 1. Entrance / Exit of Desktop Rail via anime.js
      if (rail) {
        if (scrollY > triggerThreshold) {
          if (!isRailVisible) {
            isRailVisible = true;
            rail.classList.remove('pointer-events-none');
            if (railEntranceAnim) railEntranceAnim.pause();
            railEntranceAnim = anime({
              targets: rail,
              opacity: [0, 1],
              translateX: [-24, 0],
              duration: 500,
              easing: 'easeOutCubic'
            });
          }
        } else {
          if (isRailVisible) {
            isRailVisible = false;
            rail.classList.add('pointer-events-none');
            if (railEntranceAnim) railEntranceAnim.pause();
            railEntranceAnim = anime({
              targets: rail,
              opacity: [1, 0],
              translateX: [0, -24],
              duration: 350,
              easing: 'easeInQuad'
            });
          }
        }
      }

      // 2. Entrance / Exit of Mobile Pill via anime.js
      if (mobilePill) {
        if (scrollY > triggerThreshold) {
          if (!isMobileVisible) {
            isMobileVisible = true;
            mobilePill.classList.remove('pointer-events-none');
            if (mobileEntranceAnim) mobileEntranceAnim.pause();
            mobileEntranceAnim = anime({
              targets: mobilePill,
              opacity: [0, 1],
              translateY: [20, 0],
              duration: 450,
              easing: 'easeOutCubic'
            });
          }
        } else {
          if (isMobileVisible) {
            isMobileVisible = false;
            mobilePill.classList.add('pointer-events-none');
            closeDrawer();
            if (mobileEntranceAnim) mobileEntranceAnim.pause();
            mobileEntranceAnim = anime({
              targets: mobilePill,
              opacity: [1, 0],
              translateY: [0, 20],
              duration: 300,
              easing: 'easeInQuad'
            });
          }
        }
      }

      // 3. Update Progress Percentage Text
      if (progressText && docHeight > 0) {
        const pct = Math.min(100, Math.max(0, Math.round((scrollY / docHeight) * 100)));
        progressText.textContent = `${pct}%`;
      }

      // 4. Calculate Active Heading when heading reaches CENTER OF SCREEN
      if (!isProgrammaticScroll) {
        const centerY = window.innerHeight / 2;
        let currentIdx = 0;

        for (let i = 0; i < headings.length; i++) {
          const rect = headings[i].getBoundingClientRect();
          // Element has reached or passed the center of the viewport
          if (rect.top <= centerY) {
            currentIdx = i;
          } else {
            break;
          }
        }

        // If reader scrolled to the end of the document, activate the last heading
        if (scrollY + window.innerHeight >= docHeight - 60) {
          currentIdx = headings.length - 1;
        }

        updateActiveIndicator(currentIdx);
      }
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    // Initial run
    onScroll();

    // Cleanup when navigating with Astro View Transitions
    document.addEventListener('astro:before-swap', () => {
      window.removeEventListener('scroll', onScroll);
      if (scrollUnlockTimeout) clearTimeout(scrollUnlockTimeout);
      if (activeAnimInstance) activeAnimInstance.pause();
      if (railEntranceAnim) railEntranceAnim.pause();
      if (mobileEntranceAnim) mobileEntranceAnim.pause();
    }, { once: true });
  }

  document.addEventListener('astro:page-load', initTocScrollIndicator);
  if (document.readyState === 'complete') initTocScrollIndicator();
  else window.addEventListener('DOMContentLoaded', initTocScrollIndicator);
</script>
