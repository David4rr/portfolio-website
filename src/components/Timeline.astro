---
// ponytail: Experience & Education Timeline
const experiences = [
  {
    role: "Android Developer",
    company: "SocioDigitals - Surabaya",
    period: "Aug 2024 - Dec 2024",
    description: "Responsible for building mobile-based systems. SocioDigitals is a digital marketing agency focused on driving business growth and positive impact."
  },
  {
    role: "Android Learning Path",
    company: "Bangkit Academy 2024 (Google, GoTo, Traveloka)",
    period: "Feb 2024 - Jun 2024",
    description: "Participated in a globally certified Independent Study program. Successfully delivered all milestone projects on deadline and actively engaged in the curriculum."
  },
  {
    role: "Android Developer",
    company: "Sultan Farm - Jember",
    period: "Sep 2023 - Dec 2023",
    description: "Served as Head of the Mobile Division. Contributed to full-stack mobile development and led team coordination with strong dedication."
  }
];

const education = {
  degree: "D4 Informatics Engineering (S.Tr.Kom)",
  school: "Politeknik Negeri Jember",
  period: "Sep 2021 - Jul 2025",
  gpa: "3.88 / 4.00",
  achievement: "2nd Place, Best Application at TIF EXHIBITION (MOP GREEN - Greenhouse Monitoring System)"
};
---

<section id="timeline" class="pt-[clamp(4rem,8vw,8rem)] pb-8 relative border-t border-border-subtle/50 mt-12">
  <div class="max-w-4xl mx-auto w-full">
    
    <h2 class="font-serif text-[clamp(2.5rem,5vw,4rem)] text-text-main mb-16 text-center font-normal tracking-tight">
      Journey & Education<span class="text-accent">.</span>
    </h2>
    
    <!-- Education Block -->
    <div class="mb-20">
      <h3 class="font-serif text-[clamp(1.5rem,3vw,2.5rem)] text-text-main mb-8 italic border-b border-border-subtle/50 pb-4">Academic Backgrounds</h3>
      
      <!-- Unified Styling -->
      <div class="relative pl-6 ml-2 md:pl-8 md:ml-4">
        <!-- The Line -->
        <div class="absolute left-0 top-2 bottom-0 w-[2px] bg-border-subtle"></div>
        
        <!-- Timeline dot -->
        <div class="absolute -left-[4px] md:-left-[4px] top-1.5 w-[10px] h-[10px] bg-bg border-2 border-accent rounded-full"></div>
        
        <div class="flex flex-col md:flex-row md:items-baseline justify-between mb-1 gap-2">
          <h4 class="font-sans font-bold text-lg text-text-main">{education.degree}</h4>
          <span class="font-mono text-[10px] text-text-muted tracking-widest uppercase shrink-0">{education.period}</span>
        </div>
        <p class="font-serif text-text-muted mb-4 text-lg">{education.school} &mdash; <span class="text-text-main italic">GPA: {education.gpa}</span></p>
      
      <!-- Elegant Achievement Design -->
      <div class="mt-6 flex items-start gap-4 opacity-90 relative">
        <div class="w-6 h-[1px] bg-accent/60 mt-[0.6rem]"></div>
        <div>
          <p class="font-sans text-[9px] uppercase tracking-[0.25em] text-accent/80 mb-1">Notable Achievement</p>
          <p class="font-serif text-[1rem] text-text-main italic leading-relaxed max-w-xl">{education.achievement}</p>
        </div>
      </div>
      </div>
    </div>

    <!-- Experience Timeline -->
    <div>
      <h3 class="font-serif text-[clamp(1.5rem,3vw,2.5rem)] text-text-main mb-8 italic border-b border-border-subtle/50 pb-4">Professional Experience</h3>
      
      <div class="relative pl-6 ml-2 md:pl-8 md:ml-4">
        <!-- The Line -->
        <div class="absolute left-0 top-2 bottom-0 w-[2px] bg-border-subtle"></div>
        
        <div class="space-y-12">
          {experiences.map((exp, i) => (
            <div class="relative">
              <!-- Timeline dot -->
              <div class="absolute -left-[28px] md:-left-[36px] top-1.5 w-[10px] h-[10px] bg-bg border-2 border-accent rounded-full transition-transform hover:scale-150"></div>
            
            <div class="flex flex-col md:flex-row md:items-baseline justify-between mb-1 gap-2">
              <h4 class="font-sans font-bold text-lg text-text-main">{exp.role}</h4>
              <span class="font-mono text-[10px] text-text-muted tracking-widest uppercase shrink-0">{exp.period}</span>
            </div>
            
            <p class="font-serif text-accent italic mb-4 text-[0.95rem]">{exp.company}</p>
            <p class="font-serif text-text-muted text-[0.95rem] leading-[1.7] max-w-2xl">{exp.description}</p>
          </div>
        ))}
        </div>
      </div>
    </div>

    <!-- Resume Download Button -->
    <div class="mt-12 flex justify-center relative">
      <!-- The poetic connector line bridging the timeline to the button -->
      <div class="absolute left-[8px] md:left-[16px] top-[-3rem] bottom-[50%] right-[50%] border-l-2 border-b-2 border-border-subtle rounded-bl-[48px] pointer-events-none"></div>

      <a href="/assets/resume.pdf" target="_blank" rel="noopener noreferrer" 
         class="relative z-10 bg-bg inline-block border-2 border-border-subtle text-text-main font-sans uppercase tracking-[0.2em] text-[10px] px-8 py-4 rounded-full hover:border-accent hover:text-accent active:border-accent active:text-accent active:scale-95 transition-all duration-300">
         Download Full Résumé
      </a>
    </div>

  </div>
</section>
