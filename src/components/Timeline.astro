---
// ponytail: Timeline section
---
<section id="timeline" class="py-[clamp(4rem,8vw,8rem)]">
  <h2 class="text-[clamp(1.5rem,4vw,2.5rem)] font-bold mb-8 scroll-reveal opacity-0">Experience</h2>
  <div class="space-y-8 border-l border-border-subtle pl-6 ml-3">
    {[1, 2, 3].map((_, i) => (
      <div class="relative scroll-reveal opacity-0">
        <div class="absolute -left-[31px] top-1 w-3 h-3 bg-accent rounded-full border-4 border-bg"></div>
        <h3 class="text-xl font-bold">Senior Software Engineer <span class="text-accent">@ Tech Corp</span></h3>
        <p class="text-sm font-mono text-text-muted mb-2">2020 - Present</p>
        <ul class="list-disc list-inside text-text-muted space-y-1">
          <li>Architected and implemented core platform features.</li>
          <li>Led a team of 3 engineers in delivering high-impact projects.</li>
        </ul>
      </div>
    ))}
  </div>
</section>
