---
// ponytail: Experience & Education Timeline
const experiences = [
  {
    role: "Freelancer",
    company: "Self-Employed",
    period: "Current",
    description: "Building responsive web and mobile applications, crafting performant, custom digital solutions for clients."
  },
  {
    role: "Android Developer",
    company: "SocioDigitals - Surabaya",
    period: "Aug 2024 - Dec 2024",
    description: "Responsible for building mobile-based systems. SocioDigitals is a digital marketing agency focused on driving business growth and positive impact."
  },
  {
    role: "Android Learning Path",
    company: "Bangkit Academy 2024 (Google, GoTo, Traveloka)",
    period: "Feb 2024 - Jun 2024",
    description: "Participated in a globally certified Independent Study program. Successfully delivered all milestone projects on deadline and actively engaged in the curriculum."
  },
  {
    role: "Android Developer",
    company: "Sultan Farm - Jember",
    period: "Sep 2023 - Dec 2023",
    description: "Served as Head of the Mobile Division. Contributed to full-stack mobile development and led team coordination with strong dedication."
  }
];

const education = {
  degree: "D4 Informatics Engineering (S.Tr.Kom)",
  school: "Politeknik Negeri Jember",
  period: "Sep 2021 - Jul 2025",
  gpa: "3.88 / 4.00",
  achievement: "2nd Place, Best Application at TIF EXHIBITION (MOP GREEN - Greenhouse Monitoring System)"
};
---

<section id="timeline" class="pt-[clamp(4rem,8vw,8rem)] pb-8 relative border-t border-border-subtle/50 mt-12">
  <div class="max-w-4xl mx-auto w-full">
    
    <h2 class="font-serif text-[clamp(2.5rem,5vw,4rem)] text-text-main mb-16 text-center font-normal tracking-tight">
      Journey & Education<span class="text-accent">.</span>
    </h2>
    
    <!-- Education Block -->
    <div class="mb-20">
      <h3 class="font-serif text-[clamp(1.5rem,3vw,2.5rem)] text-text-main mb-8 italic border-b border-border-subtle/50 pb-4">Academic Backgrounds</h3>
      
      <!-- Unified Styling -->
      <div class="relative pl-6 ml-2 md:pl-8 md:ml-4">
        <!-- The Line -->
        <div class="absolute left-0 top-2 bottom-0 w-[2px] bg-border-subtle"></div>
        
        <!-- Timeline dot -->
        <div class="absolute -left-[4px] md:-left-[4px] top-1.5 w-[10px] h-[10px] bg-bg border-2 border-accent rounded-full"></div>
        
        <div class="flex flex-col md:flex-row md:items-baseline justify-between mb-1 gap-2">
          <h4 class="font-sans font-bold text-lg text-text-main">{education.degree}</h4>
          <span class="font-mono text-[10px] text-text-muted tracking-widest uppercase shrink-0">{education.period}</span>
        </div>
        <p class="font-serif text-text-muted mb-4 text-lg">{education.school} &mdash; <span class="text-text-main italic">GPA: {education.gpa}</span></p>
      
      <!-- Elegant Achievement Design -->
      <div class="mt-6 flex items-start gap-4 opacity-90 relative">
        <div class="w-6 h-[1px] bg-accent/60 mt-[0.6rem]"></div>
        <div>
          <p class="font-sans text-[9px] uppercase tracking-[0.25em] text-accent/80 mb-1">Notable Achievement</p>
          <p class="font-serif text-[1rem] text-text-main italic leading-relaxed max-w-xl">{education.achievement}</p>
        </div>
      </div>
      </div>
    </div>

    <!-- Experience Timeline -->
    <div>
      <h3 class="font-serif text-[clamp(1.5rem,3vw,2.5rem)] text-text-main mb-8 italic border-b border-border-subtle/50 pb-4">Professional Experience</h3>
      
      <div class="relative pl-6 ml-2 md:pl-8 md:ml-4">
        <!-- The Line -->
        <div class="absolute left-0 top-2 bottom-0 w-[2px] bg-border-subtle"></div>
        
        <div class="space-y-12">
          {experiences.map((exp, i) => (
            <div class="relative">
              <!-- Timeline dot -->
              <div class="absolute -left-[28px] md:-left-[36px] top-1.5 w-[10px] h-[10px] bg-bg border-2 border-accent rounded-full transition-transform hover:scale-150"></div>
            
            <div class="flex flex-col md:flex-row md:items-baseline justify-between mb-1 gap-2">
              <h4 class="font-sans font-bold text-lg text-text-main">{exp.role}</h4>
              <span class={`font-mono text-[10px] tracking-widest uppercase shrink-0 ${exp.period === "Current" ? "text-accent font-medium flex items-center gap-1.5" : "text-text-muted"}`}>
                {exp.period === "Current" && <span class="inline-block w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span>}
                {exp.period}
              </span>
            </div>
            
            {exp.company && <p class="font-serif text-accent italic mb-4 text-[0.95rem]">{exp.company}</p>}
            <p class="font-serif text-text-muted text-[0.95rem] leading-[1.7] max-w-2xl">{exp.description}</p>
          </div>
        ))}
        </div>
      </div>
    </div>

    <!-- Resume Download Button -->
    <div class="mt-12 flex justify-center relative">
      <!-- The poetic connector line bridging the timeline to the button -->
      <div class="absolute left-[8px] md:left-[16px] top-[-3rem] bottom-[50%] right-[50%] border-l-2 border-b-2 border-border-subtle rounded-bl-[48px] pointer-events-none"></div>

      <!-- The Download Component -->
      <button id="resume-download-btn" class="group relative z-10 bg-bg flex items-center justify-center text-text-main font-sans uppercase tracking-[0.2em] text-[10px] h-[48px] w-[260px] rounded-full overflow-hidden hover:text-accent active:scale-95 transition-transform duration-300 cursor-pointer">
        
        <!-- Base border (replaces CSS border to prevent clipping) -->
        <svg class="base-border absolute inset-0 w-full h-full pointer-events-none text-border-subtle group-hover:text-accent transition-colors duration-300">
          <path d="M 1 24 A 23 23 0 0 1 24 1 L 236 1 A 23 23 0 0 1 259 24 A 23 23 0 0 1 236 47 L 24 47 A 23 23 0 0 1 1 24 Z" fill="none" stroke="currentColor" stroke-width="2" />
        </svg>

        <!-- Button Area (Initial State) -->
        <div class="btn-area absolute inset-0 flex items-center justify-center gap-3 transition-colors duration-300">
          <div class="relative w-[4px] h-[4px] flex items-center justify-center transition-all duration-300 group-hover:w-[16px] group-hover:h-[16px]">
            <span class="absolute inset-0 bg-border-subtle rounded-full transition-all duration-300 group-hover:bg-transparent group-hover:opacity-0"></span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute w-[16px] h-[16px] text-accent opacity-0 scale-50 transition-all duration-300 group-hover:opacity-100 group-hover:scale-100">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
              <polyline points="7 10 12 15 17 10" />
              <line x1="12" y1="15" x2="12" y2="3" />
            </svg>
          </div>
          <span>Download Full Résumé</span>
        </div>

        <!-- Progress Area (Loading State) -->
        <div class="progress-area absolute inset-0 hidden items-center justify-center gap-4 pointer-events-none">
          <div class="area-left flex items-center gap-2 text-accent">
             <svg class="w-4 h-4 loading-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
               <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83" stroke-linecap="round"/>
             </svg>
             <span class="loading-progress font-mono text-text-main">0%</span>
          </div>
        </div>

        <!-- Complete Area (Done State) -->
        <div class="complete-area absolute inset-0 hidden items-center justify-center gap-2 text-accent pointer-events-none">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <path class="tick-1" d="M20 6L9 17" stroke-dasharray="52" stroke-dashoffset="52"/>
            <path class="tick-2" d="M9 17l-5-5" stroke-dasharray="52" stroke-dashoffset="52"/>
          </svg>
          <span class="done-text font-bold text-text-main">Downloaded</span>
        </div>
        
        <!-- Frame path for stroke animation starting from left-center -->
        <svg class="absolute inset-0 w-full h-full pointer-events-none text-accent">
          <path class="frame-btn-rect" d="M 1 24 A 23 23 0 0 1 24 1 L 236 1 A 23 23 0 0 1 259 24 A 23 23 0 0 1 236 47 L 24 47 A 23 23 0 0 1 1 24 Z" fill="none" stroke="currentColor" stroke-width="2" pathLength="100" stroke-dasharray="100" stroke-dashoffset="100" />
        </svg>
      </button>
    </div>

  </div>
</section>

<script>
  const btn = document.getElementById('resume-download-btn');
  const baseBorder = btn?.querySelector('.base-border');
  const btnArea = btn?.querySelector('.btn-area');
  const progressArea = btn?.querySelector('.progress-area');
  const completeArea = btn?.querySelector('.complete-area');
  const frameBtnRect = btn?.querySelector('.frame-btn-rect');
  const loadingIcon = btn?.querySelector('.loading-icon');
  const loadingProgress = btn?.querySelector('.loading-progress');
  const tick1 = btn?.querySelector('.tick-1');
  const tick2 = btn?.querySelector('.tick-2');
  const doneText = btn?.querySelector('.done-text');
  
  if (btn) {
    let isLoading = false;
    let loadingTime = 2500;
    let progress = { value: '0%' };
    let animeInstance: any = null; // Store it here!
    
    btn.addEventListener('click', async () => {
      if (isLoading) return;
      isLoading = true;
      progress.value = '0%';
      if (loadingProgress) loadingProgress.innerHTML = '0%';

      if (baseBorder) (baseBorder as HTMLElement).style.opacity = '0';
      
      const { default: anime } = await import('animejs/lib/anime.es.js');
      animeInstance = anime;

      anime({
        targets: btnArea,
        opacity: [1, 0],
        duration: 300,
        easing: 'easeInQuad',
        complete: () => {
          if (btnArea) (btnArea as HTMLElement).style.display = 'none';
          if (progressArea) {
            (progressArea as HTMLElement).style.display = 'flex';
            progressArea.classList.remove('hidden');
          }
          startLoading();
        }
      });
    });

    function startLoading() {
      const anime = animeInstance;
      anime({
        targets: loadingIcon,
        opacity: [0, 1],
        duration: 500,
        easing: 'easeOutQuad'
      });
      
      anime({
        targets: loadingIcon,
        rotateZ: 360,
        duration: 2000,
        loop: true,
        easing: 'linear'
      });

      anime({
        targets: loadingProgress,
        translateY: ['10px', '0'],
        opacity: [0, 1],
        duration: 500,
        easing: 'easeOutQuart'
      });

      anime({
        targets: progress,
        value: '100%',
        duration: loadingTime,
        easing: 'cubicBezier(.5, .05, .3, .9)',
        round: 1,
        update: function() {
          if (loadingProgress) loadingProgress.innerHTML = progress.value;
        }
      });

      anime({
        targets: frameBtnRect,
        strokeDashoffset: [100, 0],
        duration: loadingTime,
        easing: 'cubicBezier(.5, .05, .3, .9)',
        complete: completeLoading
      });
    }

    function completeLoading() {
      const anime = animeInstance;
      anime({
        targets: [loadingIcon, loadingProgress],
        translateY: [0, -20],
        opacity: [1, 0],
        duration: 500,
        easing: 'easeInQuad',
        complete: function() {
          if (progressArea) (progressArea as HTMLElement).style.display = 'none';
          if (completeArea) {
            (completeArea as HTMLElement).style.display = 'flex';
            completeArea.classList.remove('hidden');
          }
          showDone();
        }
      });
    }

    function showDone() {
      const anime = animeInstance;
      anime({
        targets: tick1,
        strokeDashoffset: [52, 0],
        opacity: [0, 1],
        duration: 500,
        easing: 'cubicBezier(.5, .05, .3, .9)'
      });

      anime({
        targets: tick2,
        strokeDashoffset: [52, 0],
        opacity: [0, 1],
        duration: 500,
        easing: 'cubicBezier(.5, .05, .3, .9)',
        delay: 200
      });

      anime({
        targets: doneText,
        opacity: [0, 1],
        translateY: ['10px', '0'],
        duration: 800,
        easing: 'easeOutQuad',
        delay: 200,
        complete: function() {
          // Direct Download after animation
          const link = document.createElement('a');
          link.href = '/assets/resume.pdf';
          link.download = 'resume.pdf';
          document.body.appendChild(link);
          link.click();
          document.body.removeChild(link);
        }
      });
      
      // Optional: reset after some time
      setTimeout(() => {
        isLoading = false;
        if (baseBorder) (baseBorder as HTMLElement).style.opacity = '1';
        if (completeArea) {
            (completeArea as HTMLElement).style.display = 'none';
            completeArea.classList.add('hidden');
        }
        if (btnArea) {
            (btnArea as HTMLElement).style.display = 'flex';
            (btnArea as HTMLElement).style.opacity = '1';
        }
        if (frameBtnRect) (frameBtnRect as HTMLElement).style.strokeDashoffset = '100';
        if (tick1) {
            (tick1 as HTMLElement).style.strokeDashoffset = '52';
            (tick1 as HTMLElement).style.opacity = '0';
        }
        if (tick2) {
            (tick2 as HTMLElement).style.strokeDashoffset = '52';
            (tick2 as HTMLElement).style.opacity = '0';
        }
      }, 5000);
    }
  }
</script>
