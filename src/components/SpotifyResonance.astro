---
interface Props {
  align?: "right" | "center";
  class?: string;
}

const { align = "right", class: className = "" } = Astro.props;
const isCenter = align === "center";
---

<div
  class={`spotify-resonance-root group flex flex-col transition-opacity duration-500 opacity-90 hover:opacity-100 ${
    isCenter ? "items-center text-center" : "items-end text-right"
  } ${className}`}
>
  <div class={`flex items-center gap-1.5 mb-0.5 ${isCenter ? "justify-center" : "justify-end"}`}>
    <div class="spotify-eq flex items-end gap-[2px] h-2.5 w-3 pb-[1px]" aria-hidden="true">
      <span class="eq-bar w-[1.5px] h-1 bg-text-muted/60 transition-all duration-300"></span>
      <span class="eq-bar w-[1.5px] h-2 bg-text-muted/60 transition-all duration-300"></span>
      <span class="eq-bar w-[1.5px] h-1.5 bg-text-muted/60 transition-all duration-300"></span>
    </div>

    <span
      class="spotify-tag font-sans text-[8.5px] uppercase tracking-[0.22em] text-text-muted/70 transition-colors duration-300"
    >
      Resonance
    </span>
  </div>

  <button
    type="button"
    aria-label="Expand Last.fm listening telemetry"
    class={`spotify-trigger spotify-link flex items-center gap-2 group/link select-none transition-all duration-200 active:scale-[0.97] active:duration-100 cursor-pointer ${
      isCenter ? "justify-center" : "justify-end"
    }`}
  >
    <div class={`flex flex-col max-w-[220px] sm:max-w-[240px] ${isCenter ? "items-center text-center" : "items-end text-right"}`}>
      <span
        class="spotify-title font-serif italic text-xs md:text-[13px] leading-tight text-text-main group-hover/link:text-accent transition-colors duration-300 truncate w-full"
      >
        Awaiting transmission...
      </span>
      <span
        class="spotify-artist font-sans text-[9.5px] tracking-wide text-text-muted/80 truncate w-full mt-0.5"
      >
        Chamber Silence
      </span>
    </div>

    <div
      class="spotify-art-wrap relative w-6 h-6 rounded border border-border-subtle overflow-hidden shrink-0 hidden bg-bg-elevated group-hover/link:border-accent transition-colors"
    >
      <div
        class="spotify-art w-full h-full bg-cover bg-center"
        role="img"
        aria-label="Spotify Album Art"
      ></div>
      <div class="absolute inset-0 bg-black/40 opacity-0 group-hover/link:opacity-100 flex items-center justify-center transition-opacity">
        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-white">
          <polyline points="15 3 21 3 21 9"></polyline>
          <polyline points="9 21 3 21 3 15"></polyline>
          <line x1="21" y1="21" x2="14" y2="10"></line>
          <line x1="3" y1="21" x2="10" y2="14"></line>
        </svg>
      </div>
    </div>
  </button>
</div>

<!-- Last.fm Telemetry Expand Modal (Global Portal) -->
<div
  id="lastfm-expand-modal"
  class="fixed inset-0 z-[120] opacity-0 pointer-events-none transition-opacity duration-200"
  role="dialog"
  aria-modal="true"
  aria-label="Last.fm Audio Telemetry"
>
  <!-- Transparent Backdrop Click Catcher -->
  <div id="lastfm-backdrop" class="absolute inset-0 bg-black/15 backdrop-blur-[2px]"></div>

  <!-- Anchored Minimalist Player & Credits Specimen Slip -->
  <div
    id="lastfm-modal-card"
    class="absolute w-[305px] sm:w-[335px] bg-bg-elevated/98 backdrop-blur-md border border-border-subtle/80 rounded-xl shadow-[0_16px_36px_-6px_rgba(0,0,0,0.55),0_0_0_1px_rgba(255,255,255,0.03)] p-4 sm:p-5 overflow-hidden will-change-transform"
  >
    <!-- Header: Quiet Status + Minimal Close -->
    <div class="flex items-center justify-between pb-2.5 mb-3 border-b border-white/[0.06]">
      <div class="flex items-center gap-2">
        <span id="lastfm-status-dot" class="w-1.5 h-1.5 rounded-full bg-text-muted/50 transition-colors duration-300"></span>
        <span id="lastfm-modal-status" class="font-mono text-[9px] uppercase tracking-[0.14em] text-text-muted">
          Resonance Idle
        </span>
      </div>
      <button
        type="button"
        id="lastfm-modal-close"
        class="text-text-muted hover:text-text-main transition-colors cursor-pointer text-xs leading-none p-1 -mr-1"
        aria-label="Close preview"
      >
        ✕
      </button>
    </div>

    <!-- Section 1: The Music Player Deck -->
    <div class="flex items-start gap-3.5 mb-3">
      <!-- 1:1 Album Art -->
      <div class="w-14 h-14 sm:w-15 sm:h-15 rounded-lg border border-white/10 overflow-hidden shrink-0 bg-bg-subtle relative shadow-sm group/art">
        <div
          id="lastfm-modal-art"
          class="w-full h-full bg-cover bg-center transition-transform duration-300 group-hover/art:scale-105"
          role="img"
          aria-label="Album Cover"
        ></div>
        <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent pointer-events-none"></div>
      </div>

      <!-- Track Information -->
      <div class="flex flex-col min-w-0 flex-1 pt-0.5">
        <h4
          id="lastfm-modal-title"
          class="font-serif italic text-sm sm:text-[15px] leading-snug text-text-main truncate w-full"
        >
          Awaiting transmission...
        </h4>
        <p
          id="lastfm-modal-artist"
          class="font-sans text-xs text-accent font-medium mt-0.5 truncate w-full"
        >
          Chamber Silence
        </p>
        <p
          id="lastfm-modal-album"
          class="font-serif italic text-[10.5px] text-text-muted/70 mt-0.5 truncate w-full"
        >
        </p>
      </div>
    </div>

    <!-- Player Progress & EQ Waveform Track -->
    <div class="flex items-center gap-2.5 px-0.5 mb-3.5">
      <!-- Animated Equalizer Bars -->
      <div id="lastfm-player-eq" class="flex items-end gap-[2px] h-3 w-3 shrink-0" aria-hidden="true">
        <span class="w-[1.5px] h-1.5 bg-accent/80 rounded-full animate-[eqBounce1_0.8s_ease-in-out_infinite]"></span>
        <span class="w-[1.5px] h-3 bg-accent rounded-full animate-[eqBounce2_0.8s_ease-in-out_infinite]"></span>
        <span class="w-[1.5px] h-2 bg-accent/80 rounded-full animate-[eqBounce3_0.8s_ease-in-out_infinite]"></span>
      </div>

      <!-- Scrubber Track Rail -->
      <div class="flex-1 h-1 bg-white/[0.07] rounded-full overflow-hidden relative">
        <div id="lastfm-player-rail" class="h-full bg-accent/85 rounded-full w-2/3 transition-all duration-500"></div>
      </div>

      <!-- Playback State Badge -->
      <span id="lastfm-player-label" class="font-mono text-[8px] uppercase tracking-wider text-text-muted/70 shrink-0">
        Streaming
      </span>
    </div>

    <!-- Section 2: Credits & Liner Notes -->
    <div class="pt-3 border-t border-white/[0.06]">
      <div class="flex items-center justify-between mb-1.5">
        <span class="font-mono text-[8px] uppercase tracking-[0.16em] text-text-muted/50">
          Credits & Liner Notes
        </span>
        <span
          id="lastfm-artist-tags"
          class="font-mono text-[8.5px] uppercase tracking-[0.1em] text-accent truncate max-w-[170px]"
        >
        </span>
      </div>

      <!-- Clean Liner Notes Excerpt (Strict 2 lines) -->
      <p
        id="lastfm-artist-bio"
        class="font-sans text-[11px] leading-relaxed text-text-muted/85 mb-3"
        style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;"
      >
        Telemetric audio signal standby...
      </p>

      <!-- Footer: Listeners & Clean Tactile Micro-Buttons -->
      <div class="flex items-center justify-between pt-2 border-t border-white/[0.05]">
        <span id="lastfm-artist-listeners" class="font-mono text-[9px] text-text-muted/70 truncate">
          -- listeners
        </span>
        <div class="flex items-center gap-1.5 shrink-0 ml-2">
          <a
            id="lastfm-song-link"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md bg-white/[0.04] hover:bg-accent/15 border border-white/10 hover:border-accent/40 text-text-muted hover:text-accent font-mono text-[9px] font-medium tracking-wide transition-all duration-200 active:scale-95 select-none group/trackbtn"
          >
            <span>Track</span>
            <svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="opacity-70 group-hover/trackbtn:opacity-100 group-hover/trackbtn:translate-x-0.5 group-hover/trackbtn:-translate-y-0.5 transition-all"><path d="M7 17L17 7M17 7H7M17 7V17"/></svg>
          </a>
          <a
            id="lastfm-artist-link"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md bg-white/[0.04] hover:bg-accent/15 border border-white/10 hover:border-accent/40 text-text-muted hover:text-accent font-mono text-[9px] font-medium tracking-wide transition-all duration-200 active:scale-95 select-none group/artbtn"
          >
            <span>Artist</span>
            <svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="opacity-70 group-hover/artbtn:opacity-100 group-hover/artbtn:translate-x-0.5 group-hover/artbtn:-translate-y-0.5 transition-all"><path d="M7 17L17 7M17 7H7M17 7V17"/></svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* Custom animated equalizer keyframes */
  @keyframes eqBounce1 {
    0%, 100% { height: 3px; }
    50% { height: 10px; }
  }
  @keyframes eqBounce2 {
    0%, 100% { height: 9px; }
    50% { height: 4px; }
  }
  @keyframes eqBounce3 {
    0%, 100% { height: 4px; }
    50% { height: 10px; }
  }

  :global(.eq-playing .eq-bar) {
    background-color: var(--color-accent) !important;
  }
  :global(.eq-playing .eq-bar:nth-child(1)) {
    animation: eqBounce1 1s ease-in-out infinite;
  }
  :global(.eq-playing .eq-bar:nth-child(2)) {
    animation: eqBounce2 0.8s ease-in-out infinite 0.15s;
  }
  :global(.eq-playing .eq-bar:nth-child(3)) {
    animation: eqBounce3 1.1s ease-in-out infinite 0.3s;
  }
</style>

<script>
  import anime from 'animejs';

  let spotifyInterval: any = null;
  let isFetching = false;
  let latestTelemetryData: any = null;
  let activeTriggerEl: HTMLElement | null = null;
  let isMorphing = false;

  function formatRelativeTime(uts: string | number) {
    if (!uts) return "Recently Played";
    const timestamp = typeof uts === "string" ? parseInt(uts, 10) * 1000 : uts * 1000;
    if (isNaN(timestamp)) return "Recently Played";
    const diffSec = Math.floor((Date.now() - timestamp) / 1000);
    if (diffSec < 60) return "Scrobbled just now";
    const diffMin = Math.floor(diffSec / 60);
    if (diffMin < 60) return `Scrobbled ${diffMin}m ago`;
    const diffHour = Math.floor(diffMin / 60);
    if (diffHour < 24) return `Scrobbled ${diffHour}h ago`;
    const diffDay = Math.floor(diffHour / 24);
    return `Scrobbled ${diffDay}d ago`;
  }
  function formatDuration(ms?: number) {
    if (!ms || ms <= 0) return "--:--";
    const totalSec = Math.floor(ms / 1000);
    const min = Math.floor(totalSec / 60);
    const sec = totalSec % 60;
    return `${min}:${sec.toString().padStart(2, '0')} min`;
  }

  function formatCount(num?: number) {
    if (num === undefined || num === null) return "--";
    if (num >= 1_000_000) return `${(num / 1_000_000).toFixed(1)}M`;
    if (num >= 1_000) return `${(num / 1_000).toFixed(1)}K`;
    return num.toLocaleString();
  }

  function ensureSingleModal() {
    const modals = document.querySelectorAll('#lastfm-expand-modal');
    if (modals.length > 1) {
      for (let i = 1; i < modals.length; i++) {
        modals[i].remove();
      }
    }
    const modal = document.getElementById('lastfm-expand-modal');
    if (modal && modal.parentNode !== document.body) {
      document.body.appendChild(modal);
    }
    return modal;
  }

  function populateModal(data: any) {
    if (!data) return;
    const isLive = data.isPlaying;
    const titleText = data.title || 'Chamber Silence';
    const artistText = data.artist || (isLive ? 'Unknown Artist' : 'Awaiting transmission...');
    const artistInfo = data.artistInfo;

    const modalTitle = document.getElementById('lastfm-modal-title');
    const modalArtist = document.getElementById('lastfm-modal-artist');
    const modalAlbum = document.getElementById('lastfm-modal-album');
    const modalArt = document.getElementById('lastfm-modal-art');
    const playerEq = document.getElementById('lastfm-player-eq');
    const playerRail = document.getElementById('lastfm-player-rail');
    const playerLabel = document.getElementById('lastfm-player-label');
    const artistTags = document.getElementById('lastfm-artist-tags');
    const artistBio = document.getElementById('lastfm-artist-bio');
    const artistListeners = document.getElementById('lastfm-artist-listeners');
    const modalStatus = document.getElementById('lastfm-modal-status');
    const statusDot = document.getElementById('lastfm-status-dot');
    const songLink = document.getElementById('lastfm-song-link') as HTMLAnchorElement;
    const artistLink = document.getElementById('lastfm-artist-link') as HTMLAnchorElement;

    if (modalTitle) modalTitle.textContent = titleText;
    if (modalArtist) modalArtist.textContent = artistText;
    if (modalAlbum) {
      modalAlbum.textContent = data.album ? `Album: ${data.album}` : '';
      modalAlbum.style.display = data.album ? 'block' : 'none';
    }
    if (modalArt && data.albumImageUrl) {
      modalArt.style.backgroundImage = `url("${data.albumImageUrl}")`;
    }

    if (playerEq) {
      if (isLive) {
        playerEq.classList.remove('opacity-40');
      } else {
        playerEq.classList.add('opacity-40');
       }
    }

    if (playerRail) {
      playerRail.style.width = isLive ? '75%' : '100%';
    }

    if (playerLabel) {
      playerLabel.textContent = isLive ? 'Live Stream' : 'Playback Finished';
    }

    if (artistTags) {
      if (artistInfo?.tags && artistInfo.tags.length > 0) {
        artistTags.textContent = artistInfo.tags.slice(0, 2).join(' • ');
        artistTags.style.display = 'inline';
      } else {
        artistTags.style.display = 'none';
      }
    }

    if (artistBio) {
      if (artistInfo?.bio) {
        let bio = artistInfo.bio;
        bio = bio.replace(/\(\s*\/[^)]+\/\s*[^)]*\)/g, '');
        bio = bio.replace(/\(\s*born\s+[^)]+\)/gi, '');
        bio = bio.replace(/\(\s*[^)]*;\s*born\s+[^)]+\)/gi, '');
        bio = bio.replace(/\s{2,}/g, ' ').replace(/\s+([.,;:])/g, '$1').trim();

        const sentences = bio.match(/[^.!?]+[.!?]+/g) || [bio];
        let note = sentences[0]?.trim() || "";
        if (note.length < 60 && sentences[1]) {
          const combined = note + " " + sentences[1].trim();
          if (combined.length <= 160) {
            note = combined;
          }
        }
        if (note.length > 160) {
          const cut = note.slice(0, 155);
          const lastSpace = cut.lastIndexOf(' ');
          note = (lastSpace > 100 ? cut.slice(0, lastSpace) : cut) + '…';
        }
        artistBio.textContent = note.trim();
        artistBio.style.display = 'block';
      } else {
        artistBio.textContent = `Liner notes archived for ${artistText}. Streamed via Last.fm broadcast.`;
        artistBio.style.display = 'block';
      }
    }

    if (artistListeners) {
      if (artistInfo?.listeners && artistInfo.listeners > 0) {
        artistListeners.textContent = `${formatCount(artistInfo.listeners)} listeners`;
      } else {
        artistListeners.textContent = `Audio Archive`;
      }
    }

    if (modalStatus && statusDot) {
      if (isLive) {
        modalStatus.textContent = "Live Broadcast";
        modalStatus.classList.add('text-accent');
        modalStatus.classList.remove('text-text-muted');
        statusDot.className = "w-1.5 h-1.5 rounded-full bg-accent animate-pulse";
      } else {
        modalStatus.textContent = data.playedAt ? formatRelativeTime(data.playedAt) : "Resonance Idle";
        modalStatus.classList.remove('text-accent');
        modalStatus.classList.add('text-text-muted');
        statusDot.className = "w-1.5 h-1.5 rounded-full bg-text-muted/60";
      }
    }

    if (songLink) {
      if (data.songUrl) {
        songLink.setAttribute('href', data.songUrl);
        songLink.classList.remove('pointer-events-none', 'opacity-40');
      } else {
        songLink.removeAttribute('href');
        songLink.classList.add('pointer-events-none', 'opacity-40');
      }
    }

    if (artistLink) {
      const aUrl = artistInfo?.url || (data.artist ? `https://www.last.fm/music/${encodeURIComponent(data.artist)}` : null);
      if (aUrl) {
        artistLink.setAttribute('href', aUrl);
        artistLink.classList.remove('pointer-events-none', 'opacity-40');
      } else {
        artistLink.removeAttribute('href');
        artistLink.classList.add('pointer-events-none', 'opacity-40');
      }
    }
  }

  function positionSlip(triggerEl: HTMLElement) {
    const card = document.getElementById('lastfm-modal-card');
    if (!card) return;
    const tR = triggerEl.getBoundingClientRect();
    const isCenterAligned = triggerEl.closest('.spotify-resonance-root')?.classList.contains('items-center');

    if (isCenterAligned || window.innerWidth < 768) {
      // Mobile / center-aligned layout
      card.style.left = '50%';
      card.style.right = 'auto';
      card.style.top = 'auto';
      card.style.bottom = `${Math.max(16, window.innerHeight - tR.top + 10)}px`;
      card.style.transformOrigin = 'bottom center';
    } else {
      // Desktop bottom-right aligned layout
      const rightOffset = window.innerWidth - tR.right;
      const bottomOffset = window.innerHeight - tR.bottom;
      card.style.right = `${Math.max(16, rightOffset)}px`;
      card.style.bottom = `${Math.max(16, bottomOffset - 8)}px`;
      card.style.left = 'auto';
      card.style.top = 'auto';
      card.style.transformOrigin = 'bottom right';
    }
  }

  function openLastFmModal(triggerEl?: HTMLElement | null) {
    if (isMorphing) return;
    const modal = ensureSingleModal();
    if (!modal) return;
    const card = document.getElementById('lastfm-modal-card');
    if (!card) return;

    activeTriggerEl = triggerEl || (document.querySelector('.spotify-trigger:not([style*="display: none"])') as HTMLElement) || (document.querySelector('.spotify-trigger') as HTMLElement);

    if (latestTelemetryData) {
      populateModal(latestTelemetryData);
    }

    if (activeTriggerEl) {
      positionSlip(activeTriggerEl);
    }

    isMorphing = true;
    anime.remove(card);
    anime.remove(modal);
    if (activeTriggerEl) anime.remove(activeTriggerEl);

    modal.classList.remove('opacity-0', 'pointer-events-none');
    modal.classList.add('opacity-100', 'pointer-events-auto');

    // Smoothly dissolve the trigger into the expanding specimen slip
    if (activeTriggerEl) {
      anime({
        targets: activeTriggerEl,
        opacity: [1, 0],
        duration: 150,
        easing: 'easeOutQuad',
      });
    }

    const isMobile = window.innerWidth < 768 || activeTriggerEl?.closest('.spotify-resonance-root')?.classList.contains('items-center');

    if (isMobile) {
      anime({
        targets: card,
        opacity: [0, 1],
        scale: [0.93, 1],
        translateY: [8, 0],
        translateX: ['-50%', '-50%'],
        duration: 320,
        easing: 'cubicBezier(0.16, 1, 0.3, 1)',
        complete: () => {
          isMorphing = false;
        },
      });
    } else {
      anime({
        targets: card,
        opacity: [0, 1],
        scale: [0.93, 1],
        translateY: [8, 0],
        duration: 320,
        easing: 'cubicBezier(0.16, 1, 0.3, 1)',
        complete: () => {
          isMorphing = false;
        },
      });
    }
  }

  function closeLastFmModal() {
    if (isMorphing) return;
    const modal = document.getElementById('lastfm-expand-modal');
    const card = document.getElementById('lastfm-modal-card');
    if (!modal || !card) return;

    isMorphing = true;
    anime.remove(card);
    anime.remove(modal);
    if (activeTriggerEl) anime.remove(activeTriggerEl);

    const isMobile = window.innerWidth < 768 || activeTriggerEl?.closest('.spotify-resonance-root')?.classList.contains('items-center');

    if (isMobile) {
      anime({
        targets: card,
        opacity: [1, 0],
        scale: [1, 0.93],
        translateY: [0, 8],
        translateX: ['-50%', '-50%'],
        duration: 220,
        easing: 'cubicBezier(0.25, 1, 0.5, 1)',
        complete: () => {
          modal.classList.add('opacity-0', 'pointer-events-none');
          modal.classList.remove('opacity-100', 'pointer-events-auto');
          isMorphing = false;
          if (activeTriggerEl) {
            anime({
              targets: activeTriggerEl,
              opacity: [0, 1],
              duration: 200,
              easing: 'easeOutQuad',
            });
          }
        },
      });
    } else {
      anime({
        targets: card,
        opacity: [1, 0],
        scale: [1, 0.93],
        translateY: [0, 8],
        duration: 220,
        easing: 'cubicBezier(0.25, 1, 0.5, 1)',
        complete: () => {
          modal.classList.add('opacity-0', 'pointer-events-none');
          modal.classList.remove('opacity-100', 'pointer-events-auto');
          isMorphing = false;
          if (activeTriggerEl) {
            anime({
              targets: activeTriggerEl,
              opacity: [0, 1],
              duration: 200,
              easing: 'easeOutQuad',
            });
          }
        },
      });
    }
  }
  async function updateSpotify() {
    if (isFetching || document.visibilityState === 'hidden') return;
    isFetching = true;

    try {
      const res = await fetch('/api/spotify.json');
      if (!res.ok) return;

      const data = await res.json();
      latestTelemetryData = data;

      const eqElements = document.querySelectorAll('.spotify-eq');
      const tagElements = document.querySelectorAll('.spotify-tag');
      const titleElements = document.querySelectorAll('.spotify-title');
      const artistElements = document.querySelectorAll('.spotify-artist');
      const artWrapElements = document.querySelectorAll('.spotify-art-wrap');
      const artElements = document.querySelectorAll('.spotify-art');

      const isLive = data.isPlaying;
      const tagLabel = isLive
        ? 'Resonance • Live'
        : (data.title && data.title !== 'Chamber Silence' ? 'Resonance • Recent' : 'Resonance');

      const titleText = data.title || 'Chamber Silence';
      const artistText = data.artist || (isLive ? 'Unknown Artist' : 'Awaiting transmission...');
      eqElements.forEach(eq => {
        if (isLive) {
          eq.classList.add('eq-playing');
        } else {
          eq.classList.remove('eq-playing');
        }
      });

      tagElements.forEach(tag => {
        tag.textContent = tagLabel;
        if (isLive) {
          tag.classList.add('text-accent');
          tag.classList.remove('text-text-muted/70');
        } else {
          tag.classList.remove('text-accent');
          tag.classList.add('text-text-muted/70');
        }
      });

      titleElements.forEach(title => {
        title.textContent = titleText;
      });

      artistElements.forEach(artist => {
        artist.textContent = artistText;
      });

      if (data.albumImageUrl) {
        artElements.forEach(art => {
          (art as HTMLElement).style.backgroundImage = `url("${data.albumImageUrl}")`;
        });
        artWrapElements.forEach(wrap => {
          wrap.classList.remove('hidden');
        });
      } else {
        artWrapElements.forEach(wrap => {
          wrap.classList.add('hidden');
        });
      }

      // Populate Modal elements
      populateModal(data);
    } catch (e) {
      // Graceful silence on network hiccups
    } finally {
      isFetching = false;
    }
  }

  function initListeners() {
    // Attach trigger listeners
    document.querySelectorAll('.spotify-trigger').forEach(trigger => {
      trigger.addEventListener('click', (e) => {
        e.preventDefault();
        openLastFmModal(trigger as HTMLElement);
      });
    });

    const closeBtn = document.getElementById('lastfm-modal-close');
    if (closeBtn) {
      closeBtn.addEventListener('click', (e) => {
        e.preventDefault();
        closeLastFmModal();
      });
    }

    const backdrop = document.getElementById('lastfm-backdrop');
    if (backdrop) {
      backdrop.addEventListener('click', (e) => {
        e.preventDefault();
        closeLastFmModal();
      });
    }

    const modal = document.getElementById('lastfm-expand-modal');
    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) {
          closeLastFmModal();
        }
      });
    }

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeLastFmModal();
      }
    });
  }

  function initSpotify() {
    if (spotifyInterval) clearInterval(spotifyInterval);
    ensureSingleModal();
    initListeners();
    updateSpotify();
    spotifyInterval = setInterval(updateSpotify, 20000); // 20s telemetry poll
  }

  document.addEventListener('astro:page-load', initSpotify);
  document.addEventListener('astro:before-preparation', () => {
    if (spotifyInterval) clearInterval(spotifyInterval);
    closeLastFmModal();
  });
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible') {
      updateSpotify();
    }
  });

  if (document.readyState === 'complete') {
    initSpotify();
  }
</script>
