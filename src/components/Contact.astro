---
import { getRuntimeEnv } from '../lib/notion';
const contactEmail = await getRuntimeEnv('CONTACT_EMAIL') || await getRuntimeEnv('PUBLIC_CONTACT_EMAIL') || "hello@example.com";
const linkedinUrl = await getRuntimeEnv('LINKEDIN_URL') || await getRuntimeEnv('PUBLIC_LINKEDIN_URL') || "https://linkedin.com";
const instagramUrl = await getRuntimeEnv('INSTAGRAM_URL') || await getRuntimeEnv('PUBLIC_INSTAGRAM_URL') || "https://instagram.com";
const githubUrl = await getRuntimeEnv('GITHUB_URL') || await getRuntimeEnv('PUBLIC_GITHUB_URL') || "https://github.com";
import { Image } from 'astro:assets';

---
<section class="w-full flex-1 h-full flex flex-col justify-center py-[clamp(4rem,8vw,8rem)] text-center md:text-left max-w-5xl mx-auto relative border-t border-border-subtle/50 px-4 md:px-0">
  <div class="flex flex-col md:flex-row items-center justify-between gap-12 md:gap-24 w-full my-auto">
    
    <div class="relative z-20 flex-1 w-full md:pr-8">
      <h2 class="font-serif text-[clamp(2.5rem,5vw,4rem)] text-text-main mb-8 font-normal tracking-tight">
        Get In Touch<span class="text-accent">.</span>
      </h2>
      <p class="text-text-muted mb-8 max-w-md mx-auto md:mx-0 text-[1.05rem] leading-relaxed">Whether you have a question or just want to say hi, I'll try my best to get back to you!</p>
      
      <div class="flex flex-col sm:flex-row items-center gap-6 justify-center md:justify-start">
        <a href={`mailto:${contactEmail}`} id="slime-btn" class="inline-block border border-text-main/20 text-text-main font-sans uppercase tracking-[0.2em] text-[10px] px-8 py-4 rounded-full hover:bg-text-main hover:text-bg active:scale-95 transition-colors duration-300 origin-center">Say Hello</a>
        
        <div class="flex md:hidden items-center gap-4">
          <a href={linkedinUrl} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="text-text-muted hover:text-accent transition-colors p-2">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
          </a>
          <a href={instagramUrl} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="text-text-muted hover:text-accent transition-colors p-2">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
          </a>
          <a href={githubUrl} target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="text-text-muted hover:text-accent transition-colors p-2">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
          </a>
          <a href={import.meta.env.PUBLIC_LETTERBOXD_URL || "https://letterboxd.com"} target="_blank" rel="noopener noreferrer" aria-label="Letterboxd" class="text-text-muted hover:text-accent transition-colors p-2">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" stroke="none">
              <path d="M8.224 14.352a4.447 4.447 0 0 1-3.775 2.092C1.992 16.444 0 14.454 0 12s1.992-4.444 4.45-4.444c1.592 0 2.988.836 3.774 2.092-.427.682-.673 1.488-.673 2.352s.246 1.67.673 2.352zM15.101 12c0-.864.247-1.67.674-2.352-.786-1.256-2.183-2.092-3.775-2.092s-2.989.836-3.775 2.092c.427.682.674 1.488.674 2.352s-.247 1.67-.674 2.352c.786 1.256 2.183 2.092 3.775 2.092s2.989-.836 3.775-2.092A4.42 4.42 0 0 1 15.1 12zm4.45-4.444a4.447 4.447 0 0 0-3.775 2.092c.427.682.673 1.488.673 2.352s-.246 1.67-.673 2.352a4.447 4.447 0 0 0 3.775 2.092C22.008 16.444 24 14.454 24 12s-1.992-4.444-4.45-4.444z"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
    
    <!-- Poetic Intermission 3 (Rome Architecture) - Placed in the right column -->
    <div class="w-full md:w-1/2 max-w-md mx-auto md:mx-0 pointer-events-none relative z-10 text-right md:-mr-12">

      <img 
        src="/school_of_athens.jpg" 
        alt="The School of Athens"
        width="800"
        height="1200"
        loading="lazy"
        decoding="async"
        class="w-full h-auto opacity-100 origin-right"
        style="mask-image: radial-gradient(ellipse at center, black 40%, transparent 100%); -webkit-mask-image: radial-gradient(ellipse at center, black 40%, transparent 100%);"
      />
    </div>

  </div>
</section>

<script>
  document.addEventListener("astro:page-load", () => {
    const btn = document.getElementById("slime-btn");
    
    if (!btn) return;
    
    const newBtn = btn.cloneNode(true) as HTMLAnchorElement;
    btn.parentNode?.replaceChild(newBtn, btn);

    let isHovered = false;

    // Smooth magnetic tracking on mousemove
    newBtn.addEventListener("mousemove", async (e) => {
      isHovered = true;
      const { default: anime } = await import('animejs');
      const rect = newBtn.getBoundingClientRect();
      const centerX = rect.left + rect.width / 2;
      const centerY = rect.top + rect.height / 2;
      
      // Calculate distance of cursor from the center
      const distX = e.clientX - centerX;
      const distY = e.clientY - centerY;
      
      // Dense slime feels heavy, so it only pulls a fraction of the distance (30%)
      const pullX = distX * 0.3; 
      const pullY = distY * 0.3;

      anime({
        targets: newBtn,
        translateX: pullX,
        translateY: pullY,
        scale: 1.05,
        duration: 200, 
        easing: 'easeOutSine',
      });
    });

    // Snap back elastically like dense slime releasing
    newBtn.addEventListener("mouseleave", async () => {
      isHovered = false;
      const { default: anime } = await import('animejs');
      anime({
        targets: newBtn,
        translateX: 0,
        translateY: 0,
        scale: 1,
        duration: 1200,
        easing: 'easeOutElastic(1, 0.3)'
      });
    });

    // Heavy squish on click
    newBtn.addEventListener("mousedown", async () => {
      const { default: anime } = await import('animejs');
      anime({
        targets: newBtn,
        scale: 0.95,
        duration: 150,
        easing: 'easeOutQuad'
      });
    });

    // Spring back up on release
    newBtn.addEventListener("mouseup", async () => {
      if (!isHovered) return;
      const { default: anime } = await import('animejs');
      anime({
        targets: newBtn,
        scale: 1.05,
        duration: 600,
        easing: 'easeOutElastic(1, 0.4)'
      });
    });
  });
</script>
