---
import { getRuntimeEnv } from '../lib/notion';
const contactEmail = await getRuntimeEnv('CONTACT_EMAIL') || await getRuntimeEnv('PUBLIC_CONTACT_EMAIL') || "hello@example.com";
import { Image } from 'astro:assets';

---
<section id="contact" class="h-full flex flex-col justify-center py-[clamp(4rem,8vw,8rem)] text-center md:text-left max-w-5xl mx-auto relative border-t border-border-subtle/50 px-4 md:px-0">
  <div class="flex flex-col md:flex-row items-center justify-between gap-12 md:gap-24 w-full">
    
    <div class="relative z-20 flex-1 w-full md:pr-8">
      <h2 class="font-serif text-[clamp(2.5rem,5vw,4rem)] text-text-main mb-8 font-normal tracking-tight">
        Get In Touch<span class="text-accent">.</span>
      </h2>
      <p class="text-text-muted mb-8 max-w-md mx-auto md:mx-0 text-[1.05rem] leading-relaxed">Whether you have a question or just want to say hi, I'll try my best to get back to you!</p>
      <a href={`mailto:${contactEmail}`} id="slime-btn" class="inline-block border border-text-main/20 text-text-main font-sans uppercase tracking-[0.2em] text-[10px] px-8 py-4 rounded-full hover:bg-text-main hover:text-bg transition-colors duration-300 origin-center">Say Hello</a>
    </div>
    
    <!-- Poetic Intermission 3 (Rome Architecture) - Placed in the right column -->
    <div class="w-full md:w-1/2 max-w-md mx-auto md:mx-0 pointer-events-none relative z-10 text-right md:-mr-12">
      <div class="absolute inset-0 bg-gradient-to-t from-bg via-transparent to-bg z-10 opacity-70"></div>
      <div class="absolute inset-0 bg-gradient-to-l from-bg via-transparent to-bg z-10 opacity-90"></div>
      <img 
        src="/roman_poetry_art.jpg" 
        alt="Timeless Roman Architecture"
        width="800"
        height="1200"
        loading="lazy"
        decoding="async"
        class="w-full h-auto mix-blend-multiply dark:mix-blend-screen dark:invert-[0.95] dark:hue-rotate-180 opacity-50 transition-all duration-1000 origin-right grayscale"
      />
    </div>

  </div>
</section>

<script>
  import anime from 'animejs';

  document.addEventListener("astro:page-load", () => {
    const btn = document.getElementById("slime-btn");
    
    if (!btn) return;
    
    const newBtn = btn.cloneNode(true) as HTMLAnchorElement;
    btn.parentNode?.replaceChild(newBtn, btn);

    let isHovered = false;

    // Smooth magnetic tracking on mousemove
    newBtn.addEventListener("mousemove", (e) => {
      isHovered = true;
      const rect = newBtn.getBoundingClientRect();
      const centerX = rect.left + rect.width / 2;
      const centerY = rect.top + rect.height / 2;
      
      // Calculate distance of cursor from the center
      const distX = e.clientX - centerX;
      const distY = e.clientY - centerY;
      
      // Dense slime feels heavy, so it only pulls a fraction of the distance (30%)
      const pullX = distX * 0.3; 
      const pullY = distY * 0.3;

      anime({
        targets: newBtn,
        translateX: pullX,
        translateY: pullY,
        scale: 1.05,
        duration: 200, 
        easing: 'easeOutSine',
      });
    });

    // Snap back elastically like dense slime releasing
    newBtn.addEventListener("mouseleave", () => {
      isHovered = false;
      anime({
        targets: newBtn,
        translateX: 0,
        translateY: 0,
        scale: 1,
        duration: 1200,
        easing: 'easeOutElastic(1, 0.3)'
      });
    });

    // Heavy squish on click
    newBtn.addEventListener("mousedown", () => {
      anime({
        targets: newBtn,
        scale: 0.95,
        duration: 150,
        easing: 'easeOutQuad'
      });
    });

    // Spring back up on release
    newBtn.addEventListener("mouseup", () => {
      if (!isHovered) return;
      anime({
        targets: newBtn,
        scale: 1.05,
        duration: 600,
        easing: 'easeOutElastic(1, 0.4)'
      });
    });
  });
</script>
