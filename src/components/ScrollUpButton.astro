---
// Editorial Pill Scroll-to-Top Button [ ↑ TOP · 42% ]
---

<button
  id="scroll-to-top-btn"
  type="button"
  aria-label="Scroll to top of page"
  class="fixed bottom-6 right-6 md:bottom-8 md:right-8 z-40 inline-flex items-center gap-2 px-3.5 py-1.5 md:px-4 md:py-2 rounded-full bg-bg/75 backdrop-blur-xl border border-border-subtle/60 text-text-muted hover:text-text-main hover:border-accent/60 shadow-xl shadow-black/15 cursor-pointer opacity-0 pointer-events-none translate-y-4 active:scale-95 transition-colors duration-300 group select-none"
>
  <!-- Micro Arrow with hover lift -->
  <span id="scroll-btn-arrow" class="inline-flex items-center justify-center text-accent transition-transform duration-200 group-hover:-translate-y-0.5">
    <svg 
      class="w-3.5 h-3.5" 
      viewBox="0 0 24 24" 
      fill="none" 
      stroke="currentColor" 
      stroke-width="2.5" 
      stroke-linecap="round" 
      stroke-linejoin="round"
    >
      <line x1="12" y1="19" x2="12" y2="5"></line>
      <polyline points="5 12 12 5 19 12"></polyline>
    </svg>
  </span>

  <!-- Label 'TOP' -->
  <span class="font-mono text-[10px] md:text-[11px] uppercase tracking-[0.2em] font-medium text-text-main/90 group-hover:text-accent transition-colors duration-200">
    TOP
  </span>

  <!-- Divider -->
  <span class="text-border-subtle text-xs font-mono select-none">·</span>

  <!-- Dynamic Scroll Progress Percentage -->
  <span 
    id="scroll-btn-pct" 
    class="font-mono text-[10px] md:text-[11px] text-accent font-semibold tabular-nums tracking-wider"
  >
    0%
  </span>
</button>

<script>
  import anime from 'animejs';

  let entranceAnim: any = null;
  let isBtnVisible = false;

  function initScrollToTopPill() {
    const btn = document.getElementById('scroll-to-top-btn');
    const pctLabel = document.getElementById('scroll-btn-pct');
    const arrowEl = document.getElementById('scroll-btn-arrow');
    if (!btn || !pctLabel) return;

    const onScroll = () => {
      const scrollY = window.scrollY;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;

      // Toggle entrance/exit visibility with anime.js
      if (scrollY > 300) {
        if (!isBtnVisible) {
          isBtnVisible = true;
          btn.classList.remove('pointer-events-none');
          if (entranceAnim) entranceAnim.pause();
          entranceAnim = anime({
            targets: btn,
            opacity: [0, 1],
            translateY: [16, 0],
            duration: 400,
            easing: 'easeOutCubic'
          });
        }
      } else {
        if (isBtnVisible) {
          isBtnVisible = false;
          btn.classList.add('pointer-events-none');
          if (entranceAnim) entranceAnim.pause();
          entranceAnim = anime({
            targets: btn,
            opacity: [1, 0],
            translateY: [0, 16],
            duration: 300,
            easing: 'easeInQuad'
          });
        }
      }

      // Update percentage text
      if (docHeight > 0) {
        const pct = Math.min(100, Math.max(0, Math.round((scrollY / docHeight) * 100)));
        pctLabel.textContent = `${pct}%`;
      }
    };

    // Hover animation on arrow with anime.js
    btn.addEventListener('mouseenter', () => {
      if (arrowEl) {
        anime({
          targets: arrowEl,
          translateY: [-2, 0],
          duration: 300,
          easing: 'easeOutBack'
        });
      }
    });

    // Click handler with tactile spring and smooth scroll
    btn.addEventListener('click', () => {
      anime({
        targets: btn,
        scale: [0.92, 1],
        duration: 300,
        easing: 'easeOutElastic(1, .5)'
      });

      if ((window as any).lenis) {
        (window as any).lenis.scrollTo(0, { duration: 1.2 });
      } else {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    });

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    document.addEventListener('astro:before-swap', () => {
      window.removeEventListener('scroll', onScroll);
      if (entranceAnim) entranceAnim.pause();
    }, { once: true });
  }

  document.addEventListener('astro:page-load', initScrollToTopPill);
  if (document.readyState === 'complete') initScrollToTopPill();
  else window.addEventListener('DOMContentLoaded', initScrollToTopPill);
</script>
