---
// Frosted Glass Floating Action Button with Continuous Arrow Animation
---

<button
  id="scroll-to-top-btn"
  type="button"
  aria-label="Scroll to top of page"
  class="fixed bottom-6 right-6 md:bottom-8 md:right-8 z-40 w-11 h-11 md:w-12 md:h-12 rounded-full flex items-center justify-center bg-bg/75 backdrop-blur-xl border border-border-subtle/60 text-accent hover:border-accent hover:shadow-accent/10 shadow-xl shadow-black/15 cursor-pointer opacity-0 pointer-events-none translate-y-4 active:scale-90 transition-all duration-300 group select-none"
>
  <!-- Micro Arrow with Continuous Loop Animation -->
  <span id="scroll-btn-arrow" class="inline-flex items-center justify-center text-accent animate-arrow-float">
    <svg 
      class="w-4 h-4 md:w-[18px] md:h-[18px] transition-transform duration-200 group-hover:scale-110" 
      viewBox="0 0 24 24" 
      fill="none" 
      stroke="currentColor" 
      stroke-width="2.5" 
      stroke-linecap="round" 
      stroke-linejoin="round"
    >
      <line x1="12" y1="19" x2="12" y2="5"></line>
      <polyline points="5 12 12 5 19 12"></polyline>
    </svg>
  </span>
</button>

<style>
  @keyframes scrollArrowFloat {
    0%, 100% {
      transform: translateY(2.5px);
    }
    50% {
      transform: translateY(-3.5px);
    }
  }

  .animate-arrow-float {
    animation: scrollArrowFloat 1.6s ease-in-out infinite;
    will-change: transform;
  }
</style>

<script>
  import anime from 'animejs';

  let entranceAnim: any = null;
  let isBtnVisible = false;

  function initScrollToTopBtn() {
    const btn = document.getElementById('scroll-to-top-btn');
    if (!btn) return;

    const onScroll = () => {
      const scrollY = window.scrollY;

      // Toggle entrance/exit visibility with anime.js
      if (scrollY > 300) {
        if (!isBtnVisible) {
          isBtnVisible = true;
          btn.classList.remove('pointer-events-none');
          if (entranceAnim) entranceAnim.pause();
          entranceAnim = anime({
            targets: btn,
            opacity: [0, 1],
            translateY: [16, 0],
            duration: 400,
            easing: 'easeOutCubic'
          });
        }
      } else {
        if (isBtnVisible) {
          isBtnVisible = false;
          btn.classList.add('pointer-events-none');
          if (entranceAnim) entranceAnim.pause();
          entranceAnim = anime({
            targets: btn,
            opacity: [1, 0],
            translateY: [0, 16],
            duration: 300,
            easing: 'easeInQuad'
          });
        }
      }
    };

    // Click handler with tactile spring and smooth scroll to top
    btn.addEventListener('click', () => {
      anime({
        targets: btn,
        scale: [0.85, 1],
        duration: 350,
        easing: 'easeOutElastic(1, .5)'
      });

      if ((window as any).lenis) {
        (window as any).lenis.scrollTo(0, { duration: 1.2 });
      } else {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    });

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    document.addEventListener('astro:before-swap', () => {
      window.removeEventListener('scroll', onScroll);
      if (entranceAnim) entranceAnim.pause();
    }, { once: true });
  }

  document.addEventListener('astro:page-load', initScrollToTopBtn);
  if (document.readyState === 'complete') initScrollToTopBtn();
  else window.addEventListener('DOMContentLoaded', initScrollToTopBtn);
</script>
