---
interface Props {
  location?: string;
  class?: string;
}
const { location = "LOCAL TIME", class: className = "" } = Astro.props;
---
<div class={`text-right flex flex-col items-end gap-0.5 ${className}`}>
  <p class="font-sans text-[8.5px] uppercase tracking-[0.22em] text-text-muted/70">{location}</p>
  <p id="live-clock-display" class="font-serif text-xs md:text-sm text-text-main tabular-nums tracking-wider">...</p>
</div>

<script>
  function initClock() {
    const display = document.getElementById('live-clock-display');
    if (!display) return;
    
    const updateTime = () => {
      try {
        const now = new Date();
        const timeStr = new Intl.DateTimeFormat('en-US', {
          hour: '2-digit',
          minute: '2-digit',
          second: '2-digit',
          hour12: false
        }).format(now);
        
        const formattedTime = timeStr.replace(/:/g, ' : ');
        const offset = -now.getTimezoneOffset() / 60;
        const gmtStr = `GMT${offset >= 0 ? '+' : ''}${offset}`;
        
        display.textContent = `${formattedTime} • ${gmtStr}`;
      } catch (e) {
        display.textContent = new Date().toLocaleTimeString('en-US');
      }
    };
    
    updateTime();
    const interval = setInterval(updateTime, 1000);
    
    // Store interval ID on the element to clear it later if needed (e.g. view transitions)
    // @ts-ignore
    display._clockInterval = interval;
  }
  
  initClock();
  document.addEventListener('astro:page-load', () => {
    initClock();
  });
</script>
