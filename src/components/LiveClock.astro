---
interface Props {
  location?: string;
  align?: "right" | "center";
  class?: string;
}
const { location = "LOCAL TIME", align = "right", class: className = "" } = Astro.props;
const isCenter = align === "center";
---
<div class={`flex flex-col gap-0.5 ${isCenter ? "items-center text-center" : "items-end text-right"} ${className}`}>
  <p class="font-sans text-[8.5px] uppercase tracking-[0.22em] text-text-muted/70">{location}</p>
  <p class="live-clock-display font-serif text-xs md:text-sm text-text-main tabular-nums tracking-wider">...</p>
</div>

<script>
  let clockInterval: any = null;

  function initClock() {
    const displays = document.querySelectorAll('.live-clock-display');
    if (displays.length === 0) return;
    
    const updateTime = () => {
      try {
        const now = new Date();
        const timeStr = new Intl.DateTimeFormat('en-US', {
          hour: '2-digit',
          minute: '2-digit',
          second: '2-digit',
          hour12: false
        }).format(now);
        
        const formattedTime = timeStr.replace(/:/g, ' : ');
        const offset = -now.getTimezoneOffset() / 60;
        const gmtStr = `GMT${offset >= 0 ? '+' : ''}${offset}`;
        const fullText = `${formattedTime} • ${gmtStr}`;
        
        displays.forEach(display => {
          display.textContent = fullText;
        });
      } catch (e) {
        const fallback = new Date().toLocaleTimeString('en-US');
        displays.forEach(display => {
          display.textContent = fallback;
        });
      }
    };
    
    updateTime();
    if (clockInterval) clearInterval(clockInterval);
    clockInterval = setInterval(updateTime, 1000);
  }
  
  document.addEventListener('astro:before-preparation', () => {
    if (clockInterval) {
      clearInterval(clockInterval);
      clockInterval = null;
    }
  });
  initClock();
  document.addEventListener('astro:page-load', () => {
    initClock();
  });
</script>
