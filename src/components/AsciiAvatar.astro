---
interface Props {
  initialArt: string;
  framesData: string;
}
const { initialArt, framesData } = Astro.props;
---

<pre
  id="ascii-avatar"
  data-frames={framesData}
  class="font-mono text-[clamp(2.8px,0.52vh,5.8px)] leading-[0.55] text-accent select-none whitespace-pre overflow-hidden cursor-pointer hover:opacity-80 transition-opacity pt-2 max-w-full"
>{initialArt}</pre>

<script>
  const charsArray = '$@B%8&WM#*oahkbdpqwmZO0QLCJUYXzcvunxrjft/\\|()1{}[]?-_+~<>i!lI;:,"^`. '.split("");

  function initAsciiAvatar() {
    const avatar = document.getElementById('ascii-avatar');
    if (!avatar) return;

    const framesData = avatar.dataset.frames;
    if (!framesData) return;

    let frames;
    try {
      frames = JSON.parse(framesData);
    } catch (e) {
      return;
    }

    if (frames.length < 2) return;

    let isAnimating = false;
    let currentFrameIdx = 0;
    let intervalId: number | undefined;

    const abortController = new AbortController();
    const signal = abortController.signal;

    avatar.addEventListener('click', () => {
      if (isAnimating) return;
      isAnimating = true;

      const targetFrameIdx = currentFrameIdx === 0 ? 1 : 0;
      const targetRows = frames[targetFrameIdx];
      const currentRows = frames[currentFrameIdx].slice();

      const rows = targetRows.length;
      const cols = targetRows[0].length;
      const totalChars = rows * cols;
      let charsResolved = 0;

      const resolved = Array.from({ length: rows }, () => Array(cols).fill(false));

      intervalId = window.setInterval(() => {
        const swaps = Math.floor(totalChars * (0.08 + Math.random() * 0.05));

        for (let i = 0; i < swaps; i++) {
          const r = Math.floor(Math.random() * rows);
          const c = Math.floor(Math.random() * cols);

          if (!resolved[r][c]) {
            if (Math.random() > 0.5) {
              const rowArr = currentRows[r].split("");
              rowArr[c] = charsArray[Math.floor(Math.random() * charsArray.length)];
              currentRows[r] = rowArr.join("");
            } else {
              const rowArr = currentRows[r].split("");
              rowArr[c] = targetRows[r][c];
              currentRows[r] = rowArr.join("");
              resolved[r][c] = true;
              charsResolved++;
            }
          }
        }

        avatar.textContent = currentRows.join("\n");

        if (charsResolved > totalChars * 0.88) {
          if (intervalId !== undefined) {
            clearInterval(intervalId);
            intervalId = undefined;
          }
          avatar.textContent = frames[targetFrameIdx].join("\n");
          currentFrameIdx = targetFrameIdx;
          isAnimating = false;
        }
      }, 25);
    }, { signal });

    document.addEventListener('astro:before-swap', () => {
      if (intervalId !== undefined) {
        clearInterval(intervalId);
        intervalId = undefined;
      }
      abortController.abort();
    }, { once: true });
  }

  if (document.readyState === 'complete') {
    initAsciiAvatar();
  }
  document.addEventListener('astro:page-load', initAsciiAvatar);
</script>
