---
import RocketLoader from "./RocketLoader.astro";
---
<div id="preloader-overlay" class="fixed inset-0 z-[9999] bg-bg flex flex-col items-center justify-center transition-opacity duration-1000" style="display: none;">
  <div class="mb-4 flex items-center justify-center scale-150">
    <RocketLoader text="" />
  </div>
  
  <div class="flex flex-col items-center gap-6 text-center mt-4">
    <div class="font-serif text-[clamp(2rem,4vw,3rem)] text-text-main italic flex items-baseline gap-4">
      <span class="text-text-muted text-lg md:text-xl">Crafting...</span>
      <span id="preloader-percent">0%</span>
    </div>
  </div>
</div>

<script is:inline>
  try {
    if (!sessionStorage.getItem('hasSeenPreloader')) {
      const el = document.getElementById('preloader-overlay');
      if (el) {
        el.style.display = 'flex';
        document.body.style.overflow = 'hidden';
      }
    }
  } catch (e) {}
</script>

<script>
  let failsafeTimer: ReturnType<typeof setTimeout> | null = null;
  let hideTimer: ReturnType<typeof setTimeout> | null = null;
  let rafId: number | null = null;

  const cleanupPreloader = () => {
    if (failsafeTimer) {
      clearTimeout(failsafeTimer);
      failsafeTimer = null;
    }
    if (hideTimer) {
      clearTimeout(hideTimer);
      hideTimer = null;
    }
    if (rafId !== null) {
      cancelAnimationFrame(rafId);
      rafId = null;
    }
    document.body.style.overflow = '';
  };

  document.addEventListener('astro:page-load', () => {
    cleanupPreloader();
    const preloader = document.getElementById('preloader-overlay');
    const percentEl = document.getElementById('preloader-percent');
    
    let hasSeen = false;
    try {
      hasSeen = !!sessionStorage.getItem('hasSeenPreloader');
    } catch {
      hasSeen = true;
    }

    if (hasSeen || !preloader || !percentEl) {
      if (preloader) preloader.style.display = 'none';
      document.body.style.overflow = '';
      return;
    }
    
    try {
      sessionStorage.setItem('hasSeenPreloader', 'true');
    } catch {}

    const start = performance.now();
    const duration = 350;

    const tick = (now: number) => {
      const pct = Math.min(100, Math.round(((now - start) / duration) * 100));
      percentEl.textContent = `${pct}%`;
      if (pct < 100) {
        rafId = requestAnimationFrame(tick);
      } else {
        rafId = null;
        document.body.style.overflow = '';
        preloader.classList.add('opacity-0');
        preloader.style.pointerEvents = 'none';
        hideTimer = setTimeout(() => {
          preloader.style.display = 'none';
        }, 500);
      }
    };

    rafId = requestAnimationFrame(tick);
    failsafeTimer = setTimeout(() => {
      document.body.style.overflow = '';
    }, 1000);
  });

  document.addEventListener('astro:before-swap', cleanupPreloader);
</script>
