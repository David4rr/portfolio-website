---
import RocketLoader from "./RocketLoader.tsx";
---
<div id="preloader-overlay" class="fixed inset-0 z-[9999] bg-bg flex flex-col items-center justify-center transition-opacity duration-1000">
  <div class="mb-4 flex items-center justify-center scale-150">
    <RocketLoader client:load text="" />
  </div>
  
  <div class="flex flex-col items-center gap-6 text-center mt-4">
    <div class="font-serif text-[clamp(2rem,4vw,3rem)] text-text-main italic flex items-baseline gap-4">
      <span class="text-text-muted text-lg md:text-xl">Crafting...</span>
      <span id="preloader-percent">0%</span>
    </div>
  </div>
</div>

<script>
  // In Astro, module scripts are executed exactly once per page load.
  // This state will be reset on hard refresh, but preserved across client-side navigations (ViewTransitions).
  let hasPlayed = false;

  document.addEventListener('astro:page-load', () => {
    const preloader = document.getElementById('preloader-overlay');
    const percentEl = document.getElementById('preloader-percent');
    
    if (preloader && percentEl) {
      if (hasPlayed) {
        // Client-side navigation (e.g. coming back from /explore)
        preloader.style.display = 'none';
        preloader.style.opacity = '0';
        preloader.style.pointerEvents = 'none';
        document.body.style.overflow = '';
        return;
      }
      
      // First load or hard refresh
      hasPlayed = true;
      document.body.style.overflow = 'hidden';
      let pct = 0;
      
      const interval = setInterval(() => {
        pct += 1;
        if (pct >= 100) {
          pct = 100;
          clearInterval(interval);
          
          setTimeout(() => {
            preloader.classList.add('opacity-0');
            preloader.style.pointerEvents = 'none';
            setTimeout(() => {
              preloader.style.display = 'none';
              document.body.style.overflow = '';
            }, 1000);
          }, 500);
        }
        percentEl.textContent = `${pct}%`;
      }, 25);
    }
  });
</script>
