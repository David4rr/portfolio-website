---
import RocketLoader from "./RocketLoader.tsx";
---
<div id="preloader-overlay" class="fixed inset-0 z-[9999] bg-bg flex flex-col items-center justify-center transition-opacity duration-1000" style="display: none;">
  <div class="mb-4 flex items-center justify-center scale-150">
    <RocketLoader client:load text="" />
  </div>
  
  <div class="flex flex-col items-center gap-6 text-center mt-4">
    <div class="font-serif text-[clamp(2rem,4vw,3rem)] text-text-main italic flex items-baseline gap-4">
      <span class="text-text-muted text-lg md:text-xl">Crafting...</span>
      <span id="preloader-percent">0%</span>
    </div>
  </div>
</div>

<script is:inline>
  // Runs synchronously before paint.
  // If hasSeenPreloader is NOT set in sessionStorage, this is a fresh session, so we show it!
  if (!sessionStorage.getItem('hasSeenPreloader')) {
    const el = document.getElementById('preloader-overlay');
    if (el) {
      el.style.display = 'flex';
      document.body.style.overflow = 'hidden';
    }
  }
</script>

<script>
  // In Astro, module scripts are executed exactly once per page load.
  document.addEventListener('astro:page-load', () => {
    const preloader = document.getElementById('preloader-overlay');
    const percentEl = document.getElementById('preloader-percent');
    
    if (preloader && percentEl) {
      if (sessionStorage.getItem('hasSeenPreloader')) {
        // Already seen in this session. 
        // Inline script kept it hidden. Do nothing.
        return;
      }
      
      // First load for this session
      sessionStorage.setItem('hasSeenPreloader', 'true');
      document.body.style.overflow = 'hidden';
      let pct = 0;
      
      const interval = setInterval(() => {
        pct += 1;
        if (pct >= 100) {
          pct = 100;
          clearInterval(interval);
          
          setTimeout(() => {
            preloader.classList.add('opacity-0');
            preloader.style.pointerEvents = 'none';
            setTimeout(() => {
              preloader.style.display = 'none';
              document.body.style.overflow = '';
            }, 1000);
          }, 500);
        }
        percentEl.textContent = `${pct}%`;
      }, 25);
    }
  });
</script>
