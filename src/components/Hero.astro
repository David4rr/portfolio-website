---
// ponytail: hero section with interactive Matrix ASCII avatar
import AsciiAvatar from "./AsciiAvatar.astro";
import Typewriter from "./Typewriter.astro";
import SpotifyResonance from "./SpotifyResonance.astro";
import framesJson from "../data/ascii-frames.json";
import { getRuntimeEnv } from "../lib/notion";

const contactEmail = await getRuntimeEnv('CONTACT_EMAIL') || "hello@example.com";

let framesData = "[]";
let initialArt = "";

try {
  // Use pre-generated ASCII frames from JSON
  const frames = framesJson;
  framesData = JSON.stringify(frames);
  initialArt = frames[0] ? frames[0].join("\n") : "";
} catch (e) {
  console.error("Error loading ASCII frames:", e);
}
---

<section
  class="flex flex-col justify-center section-padding pt-20 pb-8 md:pt-16 md:pb-8 relative w-full h-full"
  id="hero"
>
  <!-- Decorative subtle grid/lines for paper feel -->
  <div
    class="absolute inset-0 pointer-events-none opacity-[0.03] dark:opacity-[0.02]"
    style="background-image: linear-gradient(var(--color-border-subtle) 1px, transparent 1px); background-size: 100% 4rem;"
  >
  </div>

  <div
    class="flex flex-col items-center text-center max-w-4xl mx-auto w-full relative z-10"
  >
    <!-- ASCII Emblem -->
    <div class="mb-0 flex flex-col items-center relative">
      <div class="p-0">
        <AsciiAvatar initialArt={initialArt} framesData={framesData} />
      </div>
      <div class="w-[1px] h-1 bg-border-subtle mt-1"></div>

      <div class="absolute left-full top-1/2 -translate-y-1/2 ml-4 flex-col items-start hidden md:flex pointer-events-none opacity-60 w-40">
        <svg class="w-16 h-16 text-accent mb-2 -ml-4" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
           <!-- Looping arrow path -->
           <path d="M 90 90 Q 90 50, 60 50 Q 40 50, 40 65 Q 40 80, 60 80 Q 90 80, 70 40 Q 60 10, 10 30" />
           <!-- Properly aligned delicate arrow head -->
           <path d="M 26 33 L 10 30 L 20 18" />
        </svg>
        <span class="font-serif italic text-text-muted text-[0.7rem] leading-[1.4] text-left">
          A gentle hold,<br/>
          lets the truth unfold.
        </span>
      </div>
    </div>

    <!-- The Title -->
    <h1 class="font-serif text-[clamp(2.4rem,5.5vw,4.75rem)] font-normal leading-none tracking-tight mb-2 mt-2 whitespace-normal sm:whitespace-nowrap text-text-main">
      David Arrozaqi<span class="text-accent">.</span>
    </h1>

    <!-- The Role (Typewriter) -->
    <h2 class="font-sans text-[clamp(0.7rem,1.4vw,0.85rem)] uppercase tracking-[0.25em] text-text-muted mb-4 mt-1">
      <Typewriter />
    </h2>

    <!-- The Prose -->
    <div class="max-w-xl mx-auto mb-6">
      <p
        class="font-serif text-text-muted text-[clamp(0.9rem,1.25vw,1.05rem)] leading-relaxed px-4"
      >
        Software engineer crafting robust web architectures, native Android systems, and interactive digital experiences. Focused on bridging disciplined engineering with bespoke editorial aesthetics.
      </p>
    </div>

    <!-- Actions -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-4">
      <a
        href="/#projects"
        class="group inline-flex items-center justify-center gap-2 border border-text-main/20 text-text-main font-sans uppercase tracking-[0.2em] text-[9px] px-6 py-2 rounded-full hover:bg-text-main hover:text-bg active:bg-text-main active:text-bg active:scale-95 transition-all duration-500"
        >
        <div class="relative w-[4px] h-[4px] flex items-center justify-center transition-all duration-300 group-hover:w-[16px] group-hover:h-[16px]">
          <span class="absolute inset-0 bg-text-main/50 rounded-full transition-all duration-300 group-hover:bg-transparent group-hover:opacity-0" />
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute w-[16px] h-[16px] text-bg opacity-0 scale-50 transition-all duration-300 group-hover:opacity-100 group-hover:scale-100">
            <circle cx="12" cy="12" r="10" />
            <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76" />
          </svg>
        </div>
        Explore the Work
      </a>
      <a href={`mailto:${contactEmail}`} class="group inline-flex items-center justify-center gap-2 font-serif italic text-text-muted hover:text-accent active:text-accent active:scale-95 transition-all duration-300 text-sm">
        Or send a letter
        <div class="relative w-[4px] h-[4px] flex items-center justify-center transition-all duration-300 group-hover:w-[16px] group-hover:h-[16px]">
          <span class="absolute inset-0 bg-text-muted rounded-full transition-all duration-300 group-hover:bg-transparent group-hover:opacity-0" />
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute w-[16px] h-[16px] text-accent opacity-0 scale-50 transition-all duration-300 group-hover:opacity-100 group-hover:scale-100">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
            <polyline points="22,6 12,13 2,6" />
          </svg>
        </div>
      </a>
    </div>

    <!-- Mobile Spotify Resonance (Visible on mobile only) -->
    <div class="md:hidden mt-3 mb-1 flex justify-center w-full">
      <SpotifyResonance align="center" />
    </div>

  </div>

</section>



<style>
  /* Explicitly target dark mode (when .light class is absent) */
  :root:not(.light) #ascii-avatar {
    color: var(--color-accent);
    text-shadow: 0 0 6px var(--color-accent-glow);
  }
</style>
