---
interface Props {
  username: string;
}
const { username } = Astro.props;
---

<div id="gh-activity-container" data-username={username} class="w-full">
  <div class="flex items-center justify-between mb-2 pb-1 border-b border-border-subtle/30">
    <h4 class="font-sans uppercase tracking-[0.2em] text-[9px] text-text-muted/70 flex items-center gap-1.5">
      <span class="text-accent text-[8px]">◍</span> Live Dispatches
    </h4>
    <span class="font-mono text-[9px] text-text-muted/50 tracking-wider">Public Log</span>
  </div>
  <ul id="gh-activity-list" class="flex flex-col gap-2 font-serif text-xs md:text-[13px] text-text-muted text-left" aria-busy="true">
    <li class="flex items-center justify-between py-1 border-b border-border-subtle/30 animate-pulse">
      <span class="flex items-center gap-2.5">
        <span class="w-1.5 h-1.5 rounded-full bg-accent/60"></span>
        <span class="h-3 w-48 sm:w-64 rounded bg-border-subtle/50"></span>
      </span>
      <span class="h-2.5 w-12 rounded bg-border-subtle/40"></span>
    </li>
    <li class="flex items-center justify-between py-1 border-b border-border-subtle/30 animate-pulse" style="animation-delay: 150ms;">
      <span class="flex items-center gap-2.5">
        <span class="w-1.5 h-1.5 rounded-full bg-accent/40"></span>
        <span class="h-3 w-40 sm:w-52 rounded bg-border-subtle/50"></span>
      </span>
      <span class="h-2.5 w-10 rounded bg-border-subtle/40"></span>
    </li>
    <li class="flex items-center justify-between py-1 animate-pulse" style="animation-delay: 300ms;">
      <span class="flex items-center gap-2.5">
        <span class="w-1.5 h-1.5 rounded-full bg-accent/30"></span>
        <span class="h-3 w-44 sm:w-56 rounded bg-border-subtle/50"></span>
      </span>
      <span class="h-2.5 w-14 rounded bg-border-subtle/40"></span>
    </li>
  </ul>
</div>

<script>
  function getTimeString(createdAt) {
    const diff = Date.now() - new Date(createdAt).getTime();
    const hours = Math.floor(diff / (1000 * 60 * 60));
    if (hours === 0) return 'just now';
    if (hours >= 24 && hours < 48) return 'yesterday';
    if (hours >= 48) return `${Math.floor(hours / 24)}d ago`;
    return `${hours}h ago`;
  }

  function getActionString(type) {
    if (type === "PushEvent") return "Pushed to";
    if (type === "WatchEvent") return "Starred";
    if (type === "CreateEvent") return "Created";
    if (type === "PullRequestEvent") return "Opened PR on";
    if (type === "IssuesEvent") return "Opened issue on";
    return "Contributed to";
  }

  function initActivity() {
    const container = document.getElementById('gh-activity-container');
    const list = document.getElementById('gh-activity-list');
    if (!container || !list || container.dataset.initialized === "true") return;
    container.dataset.initialized = "true";

    const username = container.dataset.username;
    if (!username) return;

    let interval: number | undefined;
    let isRunning = true;

    async function fetchActivity() {
      if (!isRunning || document.visibilityState === 'hidden') return;
      try {
        const res = await fetch(`https://api.github.com/users/${username}/events/public`);
        if (!res.ok) {
          showError();
          return;
        }
        const data = await res.json();
        
        const filtered = data
          .filter((ev) =>
            [
              "PushEvent",
              "WatchEvent",
              "CreateEvent",
              "PullRequestEvent",
              "IssuesEvent",
            ].includes(ev.type),
          )
          .slice(0, 3);
          
        if (filtered.length === 0) {
          list.removeAttribute('aria-busy');
          list.innerHTML = `
            <li class="flex items-center justify-between border-b border-border-subtle/50 pb-1 last:border-0 last:pb-0">
              <span class="flex items-center gap-3">
                <span class="text-[10px]">◍</span> No recent activity found.
              </span>
            </li>
          `;
          return;
        }


        let html = '';
        for (const ev of filtered) {
          const headSha = ev.payload?.head;
          const commitUrl = headSha
            ? `https://github.com/${ev.repo.name}/commit/${headSha}`
            : `https://github.com/${ev.repo.name}`;
          html += `
            <li class="flex items-center justify-between border-b border-border-subtle/40 pb-1.5 last:border-0 last:pb-0">
              <a
                href="${commitUrl}"
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-2 hover:text-accent transition-colors group truncate max-w-[78%]"
                title="View on GitHub"
              >
                <span class="text-[9px] text-accent/70 group-hover:text-accent shrink-0">◍</span>
                <span class="truncate hover:underline underline-offset-2">${getActionString(ev.type)} <span class="font-mono text-xs text-text-main group-hover:text-accent font-medium">${ev.repo.name}</span></span>
                <span class="text-[10px] opacity-0 group-hover:opacity-100 transition-opacity text-accent shrink-0">↗</span>
              </a>
              <span class="opacity-60 text-xs font-mono shrink-0">· ${getTimeString(ev.created_at)}</span>
            </li>
          `;
        }
        list.removeAttribute('aria-busy');
        list.innerHTML = html;
      } catch (e) {
        console.error("Failed to load GitHub activity:", e);
        showError();
      }
    }

    function showError() {
      list.removeAttribute('aria-busy');
      list.innerHTML = `
        <li class="flex items-center justify-between border-b border-border-subtle/50 pb-1 last:border-0 last:pb-0">
          <span class="flex items-center gap-3">
            <span class="text-[10px]">◍</span> Error receiving transmission.
          </span>
        </li>
      `;
    }

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          fetchActivity();
          if (!interval) {
            interval = window.setInterval(fetchActivity, 600000);
          }
          observer.disconnect();
        }
      });
    }, { rootMargin: '100px' });

    observer.observe(container);

    document.addEventListener('astro:before-preparation', () => {
      isRunning = false;
      observer.disconnect();
      clearInterval(interval);
      interval = undefined;
      delete container.dataset.initialized;
    }, { once: true });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initActivity, { once: true });
  } else {
    initActivity();
  }
  document.addEventListener('astro:page-load', initActivity);
</script>
