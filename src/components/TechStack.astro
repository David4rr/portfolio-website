---

<section
  id="tech"
  class="pb-[clamp(4rem,8vw,8rem)] pt-12 relative border-t border-border-subtle/50"
>
  <div class="max-w-4xl mx-auto w-full px-4">
    <h2 class="font-serif text-[clamp(2.5rem,5vw,4rem)] text-text-main mb-16 text-center font-normal tracking-tight">
      Toolkit & Expertise<span class="text-accent">.</span>
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 md:gap-8">
      {
        stack.map((group, i) => (
          <div class="flex flex-col items-center md:items-start text-center md:text-left">
            <h3 class="font-serif text-[1.2rem] text-text-main mb-6 italic">
              {group.category}
            </h3>
            <ul class="flex flex-col gap-3 font-sans text-sm tracking-wide text-text-muted">
              {group.items.map((item) => (
                <li class="flex items-center gap-4 group cursor-default">
                  
                  {/* Morphing Dot Effect */}
                  <div class="relative w-[4px] h-[4px] flex items-center justify-center transition-all duration-300 group-hover:w-[16px] group-hover:h-[16px]">
                    <span class="absolute inset-0 bg-border-subtle rounded-full transition-all duration-300 group-hover:bg-transparent group-hover:opacity-0" />
                    
                    {icons[item] ? (
                      <svg viewBox="0 0 24 24" class="absolute w-[16px] h-[16px] fill-accent opacity-0 scale-50 transition-all duration-300 group-hover:opacity-100 group-hover:scale-100">
                        <path d={icons[item]} />
                      </svg>
                    ) : (
                      <span class="absolute inset-0 bg-border-subtle rounded-full transition-all duration-300 group-hover:bg-accent opacity-0 group-hover:opacity-100 scale-50 group-hover:scale-100" />
                    )}
                  </div>

                  <span class="transition-colors duration-300 group-hover:text-text-main group-hover:translate-x-1">
                    {item}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
