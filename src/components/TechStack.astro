---
// ponytail: TechStack section
const tech = ["JavaScript", "TypeScript", "React", "Astro", "Tailwind CSS", "Node.js", "GSAP"];
---
<section id="tech" class="py-[clamp(4rem,8vw,8rem)]">
  <h2 class="text-[clamp(1.5rem,4vw,2.5rem)] font-bold mb-8 scroll-reveal opacity-0">Tech Stack</h2>
  <div class="flex flex-wrap gap-4">
    {tech.map((item) => (
      <div class="px-4 py-2 bg-bg-elevated border border-border-subtle rounded text-text-muted hover:text-accent hover:border-accent transition-colors scroll-reveal opacity-0">
        {item}
      </div>
    ))}
  </div>
</section>
