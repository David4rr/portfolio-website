---
import ThemeToggle from './ThemeToggle.astro';
import { getRuntimeEnv } from '../lib/notion';

const currentPath = Astro.url.pathname;
const linkedinUrl = await getRuntimeEnv('LINKEDIN_URL') || await getRuntimeEnv('PUBLIC_LINKEDIN_URL') || "https://linkedin.com";
const instagramUrl = await getRuntimeEnv('INSTAGRAM_URL') || await getRuntimeEnv('PUBLIC_INSTAGRAM_URL') || "https://instagram.com";
const githubUrl = await getRuntimeEnv('GITHUB_URL') || await getRuntimeEnv('PUBLIC_GITHUB_URL') || "https://github.com";
---
<nav id="main-nav" class="fixed top-0 left-0 right-0 pt-4 pb-8 md:pt-5 md:pb-8 px-6 grid grid-cols-3 items-center z-50 bg-bg/90 backdrop-blur-md transition-colors duration-300">
  <script>
    const setupNav = () => {
      const nav = document.getElementById('main-nav');
      if (!nav) return;

      const numPoints = 80;
      const points = [];
      points.push('100% 0%', '0% 0%');
      for (let i = 0; i <= numPoints; i++) {
        const x = (i / numPoints) * 100;
        const isDeep = Math.random() > 0.8;
        const y = isDeep ? (Math.random() * 5 + 85) : (Math.random() * 5 + 95);
        points.push(`${x}% ${y}%`);
      }
      nav.style.clipPath = `polygon(${points.join(', ')})`;
    };

    document.addEventListener('astro:page-load', setupNav);
    if (document.readyState === 'complete') setupNav();
    else window.addEventListener('DOMContentLoaded', setupNav);
  </script>
  <div class="flex justify-start">
    <a href="/" class="font-bold text-xl tracking-tighter">Portfolio.</a>
  </div>
  
  <div class="flex justify-center">
    <!-- Wrap in a drop-shadow container because clip-path hides box-shadow -->
    <div class="absolute top-0 drop-shadow-md">
      <button id="theme-toggle" class="w-10 h-14 md:w-12 md:h-16 bg-bg-elevated hover:bg-bg-subtle text-text-muted hover:text-accent transition-colors flex items-end justify-center pb-2 md:pb-3 cursor-pointer" style="clip-path: polygon(0% 0%, 100% 0%, 100% 75%, 50% 100%, 0% 75%);" aria-label="Toggle theme">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="theme-icon w-[18px] h-[18px] md:w-[20px] md:h-[20px]">
          <mask id="moon-mask">
            <rect x="0" y="0" width="100%" height="100%" fill="white" />
            <circle cx="24" cy="10" r="6" fill="black" class="moon-mask-circle" />
          </mask>
          <circle cx="12" cy="12" r="5" fill="currentColor" mask="url(#moon-mask)" class="sun-core" />
          <g class="sun-rays">
            <line x1="12" y1="1" x2="12" y2="3" />
            <line x1="12" y1="21" x2="12" y2="23" />
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
            <line x1="1" y1="12" x2="3" y2="12" />
            <line x1="21" y1="12" x2="23" y2="12" />
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
          </g>
        </svg>
      </button>
    </div>
  </div>
  
  <div class="flex justify-end items-center gap-3">
    <!-- Mobile Clock -->
    <div class="flex md:hidden flex-col items-end mr-1">
      <span class="font-sans text-[7px] uppercase tracking-[0.2em] text-text-muted">JKT, ID</span>
      <span id="nav-mobile-clock" class="font-serif text-[11px] text-text-main tabular-nums tracking-wide">--:--</span>
    </div>
    
    <!-- Desktop Socials -->
    <div class="hidden md:flex items-center gap-3">
    <a href={linkedinUrl} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="text-text-muted hover:text-accent transition-colors p-1">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle>
      </svg>
    </a>
    <a href={instagramUrl} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="text-text-muted hover:text-accent transition-colors p-1">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
      </svg>
    </a>
    <a href={githubUrl} target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="text-text-muted hover:text-accent transition-colors p-1">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
      </svg>
    </a>
    <a href={import.meta.env.PUBLIC_LETTERBOXD_URL || "https://letterboxd.com"} target="_blank" rel="noopener noreferrer" aria-label="Letterboxd" class="text-text-muted hover:text-accent transition-colors p-1">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" stroke="none">
        <path d="M8.224 14.352a4.447 4.447 0 0 1-3.775 2.092C1.992 16.444 0 14.454 0 12s1.992-4.444 4.45-4.444c1.592 0 2.988.836 3.774 2.092-.427.682-.673 1.488-.673 2.352s.246 1.67.673 2.352zM15.101 12c0-.864.247-1.67.674-2.352-.786-1.256-2.183-2.092-3.775-2.092s-2.989.836-3.775 2.092c.427.682.674 1.488.674 2.352s-.247 1.67-.674 2.352c.786 1.256 2.183 2.092 3.775 2.092s2.989-.836 3.775-2.092A4.42 4.42 0 0 1 15.1 12zm4.45-4.444a4.447 4.447 0 0 0-3.775 2.092c.427.682.673 1.488.673 2.352s-.246 1.67-.673 2.352a4.447 4.447 0 0 0 3.775 2.092C22.008 16.444 24 14.454 24 12s-1.992-4.444-4.45-4.444z"/>
      </svg>
    </a>
    </div>
  </div>
</nav>

<script>
  function initNavClock() {
    const display = document.getElementById('nav-mobile-clock');
    if (!display) return;
    
    const updateTime = () => {
      try {
        display.textContent = new Intl.DateTimeFormat('en-US', {
          timeZone: 'Asia/Jakarta',
          hour: '2-digit',
          minute: '2-digit',
          hour12: true
        }).format(new Date());
      } catch (e) {
        // Fallback if timezone not supported
      }
    };
    
    updateTime();
    const interval = setInterval(updateTime, 1000);
    
    // Cleanup on page transition
    document.addEventListener('astro:before-swap', () => clearInterval(interval), { once: true });
  }

  document.addEventListener('astro:page-load', initNavClock);
  if (document.readyState === 'complete') initNavClock();
  else window.addEventListener('DOMContentLoaded', initNavClock);
</script>
