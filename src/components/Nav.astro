---
// ponytail: sticky nav with top center toggle
---
<nav class="fixed top-0 left-0 right-0 p-6 grid grid-cols-3 items-center z-50 bg-bg/80 backdrop-blur-sm border-b border-border-subtle">
  <div class="flex justify-start">
    <a href="/" class="font-bold text-xl tracking-tighter">Portfolio.</a>
  </div>
  
  <div class="flex justify-center">
    <!-- Wrap in a drop-shadow container because clip-path hides box-shadow -->
    <div class="absolute top-0 drop-shadow-md">
      <button id="theme-toggle" class="w-12 h-16 bg-bg-elevated hover:bg-bg-subtle text-text-muted hover:text-accent transition-colors flex items-end justify-center pb-3 cursor-pointer" style="clip-path: polygon(0% 0%, 100% 0%, 100% 75%, 50% 100%, 0% 75%);" aria-label="Toggle theme">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="theme-icon">
          <mask id="moon-mask">
            <rect x="0" y="0" width="100%" height="100%" fill="white" />
            <circle cx="24" cy="10" r="6" fill="black" class="moon-mask-circle" />
          </mask>
          <circle cx="12" cy="12" r="5" fill="currentColor" mask="url(#moon-mask)" class="sun-core" />
          <g class="sun-rays">
            <line x1="12" y1="1" x2="12" y2="3" />
            <line x1="12" y1="21" x2="12" y2="23" />
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
            <line x1="1" y1="12" x2="3" y2="12" />
            <line x1="21" y1="12" x2="23" y2="12" />
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
          </g>
        </svg>
      </button>
    </div>
  </div>
  
  <div class="flex justify-end space-x-4 text-sm font-medium">
    <a href="/#about" class="hover:text-accent transition-colors hidden md:block">About</a>
    <a href="/#projects" class="hover:text-accent transition-colors hidden md:block">Projects</a>
    <a href="/#timeline" class="hover:text-accent transition-colors hidden md:block">Timeline</a>
    <a href="/#contact" class="hover:text-accent transition-colors hidden md:block">Contact</a>
    <a href="/blog" class="hover:text-accent transition-colors">Blog</a>
  </div>
</nav>
