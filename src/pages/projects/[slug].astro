---
// ponytail: luxurious museum-print project detail page
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import ScrollUpButton from '../../components/ScrollUpButton.astro';
import VisitActionButton from '../../components/VisitActionButton.astro';
import { getProjectsFromNotion, getProjectContent } from '../../lib/notion';
import { optimizeImageUrl, resolveReturnLink } from '../../lib/detail-helpers';
import { marked } from 'marked';

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=3600');

const { slug } = Astro.params;
const projects = await getProjectsFromNotion();
const project = projects.find((p) => p.slug === slug);

if (!project) {
  return Astro.redirect('/404');
}

const mdContent = await getProjectContent(project.id);
const rawHtml = await marked.parse(mdContent.replace(/[\u2014—]/g, ' - ').replace(/&mdash;/g, ' - '));
const { returnHref, returnLabel } = resolveReturnLink(Astro.url.searchParams, '/#projects');

const htmlContent = (typeof rawHtml === 'string' ? rawHtml : '').replace(
  /<img\b([^>]*?)>/gi,
  (imgTag) => {
    const srcMatch = imgTag.match(/\bsrc=["']([^"']+)["']/i);
    const altMatch = imgTag.match(/\balt=["']([^"']*)["']/i);
    const titleMatch = imgTag.match(/\btitle=["']([^"']*)["']/i);

    const rawSrc = srcMatch ? srcMatch[1] : '';
    const altText = altMatch ? altMatch[1] : '';
    const titleText = titleMatch ? ` title="${titleMatch[1]}"` : '';
    const optimizedSrc = optimizeImageUrl(rawSrc, 1200);

    return `<img src="${optimizedSrc}" alt="${altText}"${titleText} loading="lazy" decoding="async" data-image-component="" class="rounded-sm shadow-xl border border-border-subtle/30 mx-auto mt-12 mb-6 max-w-full h-auto" />`;
  }
);

const optimizedGallery = (project.gallery || []).map((img) => optimizeImageUrl(img, 1200));
const optimizedCover = optimizeImageUrl(
  project.image || 'https://images.unsplash.com/photo-1518173946687-a4c8892bbd9f?auto=format&fit=crop&q=80&w=1200',
  1200
);
---

<BaseLayout
  title={`${project.title} | David Arrozaqi`}
  description={project.description || `Explore ${project.title}, engineered by David Arrozaqi.`}
  image={optimizedCover || '/og-image.png'}
  type="article"
>
  <Nav />

  <main class="min-h-screen pt-24 sm:pt-28 md:pt-32 pb-32 bg-bg overflow-x-clip w-full">
    <div class="max-w-xl mx-auto px-4 sm:px-6 md:px-8">
      <div class="flex justify-center mb-12 sm:mb-16 md:mb-20">
        <a id="magnetic-area" href={returnHref} class="p-4 sm:p-6 cursor-pointer group">
          <div id="back-button" class="flex items-center text-text-muted group-hover:text-accent transition-colors duration-300 uppercase font-sans text-[10px] tracking-[0.25em] sm:tracking-[0.3em]">
            <span class="w-8 sm:w-12 flex justify-end items-center"><span class="return-line-left w-[8px] sm:w-[12px] h-[1px] bg-accent/70 transition-colors duration-300"></span></span>
            <span id="back-text" class="min-w-[6rem] px-2 text-center whitespace-nowrap">{returnLabel}</span>
            <span class="w-8 sm:w-12 flex justify-start items-center"><span class="return-line-right w-[8px] sm:w-[12px] h-[1px] bg-accent/70 transition-colors duration-300"></span></span>
          </div>
        </a>
      </div>

      <div id="project-hero-zone" class="text-center mb-16 relative">
        {project.timeline && (
          <div id="project-timeline" class="font-serif text-sm md:text-base italic text-text-muted/70 mb-4">
            Forged in the span of {project.timeline}
          </div>
        )}
        <h1 id="project-title" class="font-serif text-3xl md:text-5xl leading-[1.3] text-text-main mb-6 font-light tracking-tight italic break-words pb-2 pt-1 px-1">
          {project.title}
        </h1>
        {project.description && (
          <p class="hero-desc-writing text-text-muted text-lg font-sans font-light leading-relaxed px-4 md:px-8 mb-12">
            {project.description}
          </p>
        )}

        <div id="project-tags" class="flex flex-wrap items-center justify-center gap-3 text-xs tracking-[0.2em] uppercase font-sans mb-12 text-text-muted">
          {project.type.split(' • ').map((t, i, arr) => (
            <>
              <span>{t}</span>
              {i < arr.length - 1 && <span class="w-1 h-1 rounded-full bg-accent"></span>}
            </>
          ))}
        </div>
      </div>

      {optimizedGallery && optimizedGallery.length > 0 ? (
        <div id="project-media" class="w-full max-w-2xl mx-auto mb-16 flex flex-col items-center">
          <div
            class="w-full relative cursor-pointer group card-stack-container mb-20 min-h-[220px]"
            data-captions={JSON.stringify(project.galleryCaptions || [])}
          >
            <Image
              src={optimizedGallery[0]}
              alt=""
              inferSize={true}
              loading="eager"
              decoding="async"
              class="w-full h-auto opacity-0 pointer-events-none block select-none"
              aria-hidden="true"
            />

            {optimizedGallery.map((imgUrl, i) => (
              <div
                class="card-stack-item absolute inset-0 rounded-sm overflow-hidden shadow-2xl p-1 card-polaroid border border-border-subtle will-change-transform origin-bottom flex items-center justify-center"
                style={{ zIndex: optimizedGallery.length - i }}
                data-index={i}
              >
                <Image
                  src={imgUrl}
                  alt={`${project.title} gallery ${i + 1}`}
                  inferSize={true}
                  loading="eager"
                  decoding="async"
                  class="w-full h-full object-contain rounded-[1px] select-none"
                />
              </div>
            ))}
          </div>
          <div class="flex justify-center items-center gap-4 w-full opacity-70 pointer-events-none mt-8 mb-10">
            <span class="w-4 h-[1px] bg-accent/50"></span>
            <span class="text-[9px] font-sans tracking-[0.3em] uppercase text-accent">Click to reveal</span>
            <span class="w-4 h-[1px] bg-accent/50"></span>
          </div>
          <div class="w-full relative px-4" style="perspective: 800px;">
            <div id="dynamic-caption" class="w-full flex flex-wrap items-center justify-center text-center text-text-muted font-serif italic text-sm origin-center leading-relaxed">
              {project.galleryCaptions?.[0]}
            </div>
          </div>
        </div>
      ) : (
        <div id="project-media" class="w-full max-w-xl mx-auto relative mb-20 overflow-hidden rounded-sm opacity-90 sepia-[0.15] saturate-[0.7] hover:saturate-100 hover:opacity-100 transition-all duration-700 shadow-2xl p-1 bg-border-subtle/20 border border-border-subtle/30 flex items-center justify-center">
          <Image
            src={optimizedCover}
            alt={project.title}
            inferSize={true}
            loading="eager"
            decoding="async"
            class="w-full h-auto object-contain rounded-[1px]"
          />
        </div>
      )}

      <article class="prose prose-invert prose-p:text-text-muted prose-p:font-sans prose-p:leading-[2.4] prose-p:mb-6 prose-p:text-[1.1rem] md:prose-p:text-[1.15rem] prose-headings:font-serif prose-headings:text-text-main prose-headings:font-normal prose-headings:italic prose-h2:text-2xl prose-h3:text-lg prose-a:text-accent prose-img:rounded-sm prose-img:opacity-85 prose-img:sepia-[0.15] hover:prose-img:opacity-100 hover:prose-img:sepia-0 prose-img:transition-all prose-img:duration-1000 prose-img:mx-auto prose-img:mt-16 prose-img:mb-6 prose-img:shadow-xl prose-img:border prose-img:border-border-subtle/30 prose-em:block prose-em:text-center prose-em:text-[13px] prose-em:opacity-60 prose-em:mb-16 prose-em:font-serif max-w-none mx-auto text-left">
        <Fragment set:html={htmlContent} />
      </article>

      <div class="mt-16 pt-10 border-t border-border-subtle/20 flex flex-col items-center justify-center text-center">
        <div class="flex items-center gap-4 mb-8 opacity-80">
          <span class="w-4 h-[1px] bg-accent/50"></span>
          <span class="text-[9px] font-sans tracking-[0.3em] uppercase text-accent">Built With</span>
          <span class="w-4 h-[1px] bg-accent/50"></span>
        </div>
        <div class="flex flex-wrap justify-center items-center gap-2 text-[11px] md:text-xs font-serif italic text-text-muted/70">
          {(project.techStack || ['Flutter', 'Golang', 'Riverpod', 'Midtrans']).map((tech, index, array) => (
            <>
              <span class="tracking-widest hover:text-accent transition-colors cursor-default">{tech}</span>
              {index < array.length - 1 && <span class="opacity-40 font-sans mx-2 text-accent">/</span>}
            </>
          ))}
        </div>
      </div>

      {project.url && <VisitActionButton href={project.url} label="Visit Site" />}
    </div>
  </main>

  <script>
    import '../../scripts/project-detail';
  </script>

  <ScrollUpButton />
</BaseLayout>
