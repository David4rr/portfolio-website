---
// ponytail: Home page composing all sections
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Preloader from "../components/Preloader.astro";
import Timeline from "../components/Timeline.astro";
import TechStack from "../components/TechStack.astro";
import Contact from "../components/Contact.astro";
import LiveClock from "../components/LiveClock.astro";
import SpotifyResonance from "../components/SpotifyResonance.astro";
import ScrollIndicator from "../components/ScrollIndicator.astro";
import GithubHeatmap from "../components/GithubHeatmap.astro";
import ProjectsSection from "../components/ProjectsSection.astro";
import WritingSection from "../components/WritingSection.astro";
import CursorPreview from "../components/CursorPreview.astro";
import { getProjectsFromNotion } from "../lib/notion";
import { getBlogPosts } from "../lib/blogger";

// Plan A: ISR Caching - Cache for 60s, stale-while-revalidate for 1 hour
Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=3600');

const [allProjects, blogPosts] = await Promise.all([
  getProjectsFromNotion(),
  getBlogPosts(),
]);

const featuredProjects = allProjects.filter((p) => p.featured === true);
const selectedProjects = (featuredProjects.length > 0 ? featuredProjects : allProjects).slice(0, 4);
const projects = [...selectedProjects].sort((a, b) => {
  const orderA = typeof a.order === 'number' && !isNaN(a.order) ? a.order : null;
  const orderB = typeof b.order === 'number' && !isNaN(b.order) ? b.order : null;

  if (orderA !== null && orderB !== null) return orderA - orderB;
  if (orderA !== null && orderB === null) return -1;
  if (orderA === null && orderB !== null) return 1;
  return 0;
});

const previewItems = [
  ...projects.map((p) => ({ slug: p.slug, title: p.title, image: p.image })),
  ...blogPosts.map((p) => ({ slug: p.slug, title: p.title, image: p.image })),
];
---

<BaseLayout 
  title="David Arrozaqi | Creative Developer & Software Engineer"
  description="Crafting bespoke digital artifacts, interactive systems & high-performance web architecture."
  image="/og-image.png"
>
  <Preloader />
  <Nav />
  <ScrollIndicator />
  <main class="w-full relative overflow-x-clip">
    <!-- 1. Hero -->
    <section
      data-section
      class="relative min-h-[100svh] md:h-[100dvh] overflow-hidden w-full bg-bg z-10 flex flex-col justify-center"
    >
      <div
        data-reveal="editorial-fade"
        class="min-h-full max-w-[1200px] mx-auto px-4 md:px-8 w-full flex flex-col justify-center pt-2 pb-2"
      >
        <div data-animate class="w-full">
          <Hero />
        </div>
      </div>

      <!-- Telemetry Hub: Spotify Resonance & Live Clock (Screen Edge) -->
      <div id="hero-telemetry" class="absolute bottom-6 md:bottom-8 right-6 md:right-8 text-right flex flex-col items-end gap-2.5 z-30 pointer-events-auto hidden md:flex">
        <SpotifyResonance />
        <div class="w-12 h-[1px] bg-border-subtle/40 my-0.5"></div>
        <LiveClock />
      </div>
      <!-- Poetry Scroll Indicator (Screen Edge) -->
      <div id="hero-scroll-indicator" class="absolute bottom-4 md:bottom-8 left-1/2 -translate-x-1/2 md:left-8 md:translate-x-0 flex flex-col items-center gap-3 opacity-60 pointer-events-none z-20 w-8 will-change-[opacity]">
        <span class="font-serif italic text-text-muted text-[10px] tracking-[0.2em] uppercase origin-center md:origin-left whitespace-nowrap">Unfold</span>
        <div class="w-full flex justify-center">
          <svg width="12" height="40" viewBox="0 0 12 40" fill="none" xmlns="http://www.w3.org/2000/svg" class="overflow-hidden">
            <rect x="5.5" y="0" width="1" height="40" fill="currentColor" class="text-text-muted/20" />
            <rect id="scroll-line" x="5.5" y="0" width="1" height="0" fill="currentColor" class="text-accent" />
          </svg>
        </div>
      </div>
    </section>

    <!-- 2. Activity -->
    <section data-section class="relative min-h-[100svh] md:min-h-screen w-full bg-bg z-20 border-t border-border-subtle/30">
      <div
        data-reveal="ink-bloom"
        class="h-full max-w-[1200px] mx-auto px-4 md:px-8 w-full"
      >
        <div class="h-full flex flex-col justify-center">
          <Timeline />
          <GithubHeatmap />
          <TechStack />
        </div>
      </div>
    </section>

    <!-- Anchor for Projects -->
    <div id="projects" class="absolute w-full h-0 pointer-events-none"></div>

    <!-- 3. Projects -->
    <section data-section class="relative min-h-[100svh] md:min-h-screen w-full bg-bg z-30 border-t border-border-subtle/30">
      <div
        data-reveal="word-cascade"
        class="h-full max-w-[1200px] mx-auto px-4 md:px-8 w-full"
      >
        <ProjectsSection projects={projects} />
      </div>
    </section>

    <div id="writing" class="absolute w-full h-0 pointer-events-none"></div>

    <!-- 4. Writing -->
    <section data-section id="writing-section" class="relative min-h-[100svh] md:min-h-screen w-full bg-bg z-40 border-t border-border-subtle/30">
      <div
        data-reveal="word-cascade"
        class="h-full max-w-[1200px] mx-auto px-4 md:px-8 w-full"
      >
        <WritingSection posts={blogPosts} />
      </div>
    </section>

    <!-- 5. Contact -->
    <section
      data-section
      class="relative min-h-[100svh] md:min-h-screen w-full bg-bg z-50 flex flex-col border-t border-border-subtle/30"
      id="contact"
    >
      <div
        data-reveal="ink-bloom"
        class="h-full max-w-[1200px] mx-auto px-4 md:px-8 w-full flex-1 flex flex-col justify-center"
      >
        <div data-animate class="h-full w-full flex-1 flex flex-col justify-center">
          <Contact />
        </div>
      </div>
    </section>
  </main>
  <CursorPreview items={previewItems} />
</BaseLayout>

<script>
  import anime from 'animejs';

  const initInkDrop = () => {
    const line = document.getElementById('scroll-line');
    if (!line) return;

    const lineWithAnime = line as unknown as { anime?: { pause: () => void } };
    if (lineWithAnime.anime) lineWithAnime.anime.pause();

    line.setAttribute('y', '0');
    line.setAttribute('height', '0');
    line.setAttribute('opacity', '0');

    lineWithAnime.anime = anime
      .timeline({ loop: true })
      .add({
        targets: line,
        height: [0, 26],
        y: 0,
        opacity: [0.3, 1],
        duration: 1100,
        easing: 'easeInOutCubic',
      })
      .add(
        {
          targets: line,
          y: [0, 40],
          height: [26, 0],
          opacity: [1, 0],
          duration: 850,
          easing: 'easeInOutCubic',
        },
        '-=150'
      )
      .add({ duration: 500 });
  };

  let telemetryScrollListener: (() => void) | null = null;
  const initHeroTelemetry = () => {
    const telemetry = document.getElementById('hero-telemetry');
    const unfold = document.getElementById('hero-scroll-indicator');
    if (!telemetry && !unfold) return;

    if (telemetryScrollListener) {
      window.removeEventListener('scroll', telemetryScrollListener);
      const lenis = (window as any).lenis;
      if (lenis && typeof lenis.off === 'function') {
        lenis.off('scroll', telemetryScrollListener);
      }
    }
    let lastHidden = false;
    const onScroll = () => {
      const scrollY = window.scrollY;
      const threshold = window.innerHeight * 0.25;
      if (scrollY > threshold) {
        if (!lastHidden) {
          if (telemetry) {
            telemetry.style.opacity = '0';
            telemetry.style.pointerEvents = 'none';
          }
          if (unfold) {
            unfold.style.opacity = '0';
            unfold.style.pointerEvents = 'none';
          }
          lastHidden = true;
        }
      } else {
        lastHidden = false;
        const progress = Math.max(0, 1 - scrollY / threshold);
        if (telemetry) {
          telemetry.style.opacity = progress.toString();
          telemetry.style.pointerEvents = progress > 0.05 ? 'auto' : 'none';
        }
        if (unfold) {
          unfold.style.opacity = (progress * 0.6).toString();
          unfold.style.pointerEvents = 'none';
        }
      }
    };

    telemetryScrollListener = onScroll;
    window.addEventListener('scroll', onScroll, { passive: true });
    const lenis = (window as any).lenis;
    if (lenis && typeof lenis.on === 'function') {
      lenis.on('scroll', onScroll);
    }
    onScroll();
  };

  const clearExploreSession = () => {
    try {
      sessionStorage.removeItem('explore_item');
      sessionStorage.removeItem('explore_origin');
      sessionStorage.removeItem('nav_from');
    } catch {}
  };

  document.addEventListener('astro:page-load', () => {
    clearExploreSession();
    initInkDrop();
    initHeroTelemetry();
  });

  document.addEventListener('astro:before-swap', () => {
    const line = document.getElementById('scroll-line') as unknown as { anime?: { pause: () => void } } | null;
    if (line?.anime) {
      line.anime.pause();
    }
    if (telemetryScrollListener) {
      window.removeEventListener('scroll', telemetryScrollListener);
      const lenis = (window as any).lenis;
      if (lenis && typeof lenis.off === 'function') {
        lenis.off('scroll', telemetryScrollListener);
      }
      telemetryScrollListener = null;
    }
  });

  window.addEventListener('pageshow', (event) => {
    if (event.persisted) {
      initInkDrop();
      initHeroTelemetry();
    }
  });
</script>
