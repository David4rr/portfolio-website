---
// ponytail: Home page composing all sections
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Preloader from "../components/Preloader.astro";
import Timeline from "../components/Timeline.astro";
import TechStack from "../components/TechStack.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import LiveClock from "../components/LiveClock.astro";
import { getProjectsFromNotion } from "../lib/notion";

import laurelWreathImg from "../assets/laurel_wreath.jpg";


// Plan A: ISR Caching - Cache for 60s, stale-while-revalidate for 1 hour
Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=3600');

// Pass Cloudflare runtime secrets if available
const runtimeEnv = typeof Astro !== 'undefined' && Astro.locals?.runtime?.env ? Astro.locals.runtime.env : {};
const allProjects = await getProjectsFromNotion(runtimeEnv);
const projects = allProjects.slice(0, 4);
---

<BaseLayout title="Portfolio">
  <Preloader />
  <Nav />
  <main class="w-full relative">
    <!-- 1. Hero -->
    <section
      data-section
      class="sticky top-0 h-[100dvh] overflow-hidden w-full bg-bg z-40"
    >
      <div
        data-reveal="letter-unfold"
        class="min-h-full max-w-[1200px] mx-auto px-4 md:px-8 w-full flex flex-col justify-center pt-6 pb-4"
      >
        <div data-animate class="w-full">
          <Hero />
        </div>
      </div>

      <!-- Live Clock outside max-w-[1200px] to be truly at screen edge -->
      <LiveClock />
    </section>
    <!-- Anchor for Projects -->
    <div id="projects" class="absolute w-full h-0 pointer-events-none"></div>

    <!-- 2. Projects -->
    <section data-section class="sticky top-0 min-h-screen w-full bg-bg z-30">
      <div
        data-reveal="word-cascade"
        class="h-full max-w-[1200px] mx-auto px-4 md:px-8 w-full"
      >
        <div
          class="py-[clamp(4rem,8vw,8rem)] relative border-t border-border-subtle/50 flex flex-col justify-between min-h-[calc(100vh-3rem)]"
        >
          <div>
            <h2
              data-word
              class="font-serif text-[clamp(2.5rem,5vw,4rem)] text-text-main mb-16 text-center font-normal tracking-tight"
            >
              Selected Works<span class="text-accent">.</span>
            </h2>

            <div class="grid grid-cols-1 md:grid-cols-3 auto-rows-[350px] md:auto-rows-[320px] gap-4">
              {
                projects.map((project, i) => {
                  const getBentoClass = (index) => {
                    const mod = index % 4;
                    if (mod === 0) return "md:col-span-2 md:row-span-1"; // Wide banner (Top Left)
                    if (mod === 1) return "md:col-span-1 md:row-span-2"; // Tall feature (Right Side)
                    if (mod === 2) return "md:col-span-1 md:row-span-1"; // Small square (Bottom Left)
                    if (mod === 3) return "md:col-span-1 md:row-span-1"; // Small square (Bottom Middle)
                    return "md:col-span-1 md:row-span-1";
                  };
                  
                  return (
                    <a
                      data-card
                      href={`/projects/${project.slug}`}
                      class={`group relative block w-full p-6 md:p-10 border border-border-subtle bg-bg hover:border-transparent transition-colors duration-700 overflow-hidden flex flex-col justify-between h-full ${getBentoClass(i)}`}
                    >
                      <!-- Front Layer: Image (Starts full, shrinks to center on hover) -->
                      <div class="absolute inset-0 w-full h-full z-10 transition-all duration-[900ms] ease-[cubic-bezier(0.77,0,0.175,1)] [clip-path:inset(0_0_0_0)] group-hover:[clip-path:inset(50%_50%_50%_50%)] pointer-events-none">
                        {project.image && (
                          <Image 
                            src={project.image} 
                            alt={project.title}
                            width={800}
                            height={800}
                            class="w-full h-full object-cover scale-100 group-hover:scale-110 transition-transform duration-[900ms] ease-[cubic-bezier(0.77,0,0.175,1)]" 
                          />
                        )}
                      </div>
                      
                      <!-- Base Layer: Content (Always there, revealed when image shrinks) -->
                      <div class="relative flex flex-col justify-between h-full z-0">
                        <div class="flex items-start justify-between w-full relative z-10">
                          <span class="font-mono text-[10px] uppercase tracking-widest text-text-muted">
                            Idx. 0{i + 1}
                          </span>
                          <span class="font-mono text-[10px] uppercase tracking-[0.1em] text-accent flex items-center gap-2 opacity-0 -translate-x-4 group-hover:translate-x-0 group-hover:opacity-100 transition-all duration-[900ms] ease-out delay-100">
                            Click to Explore <span class="text-lg leading-none">&rarr;</span>
                          </span>
                        </div>
                        
                        <!-- Roman Poetry Art Illustration -->
                        {i === 1 && (
                          <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
                            <img 
                              src="/roman_poetry_art.jpg" 
                              alt="Roman Poetry Art" 
                              class="absolute inset-0 w-full h-full object-cover opacity-40 group-hover:opacity-60 group-hover:scale-105 transition-all duration-[1500ms] ease-out grayscale mix-blend-luminosity" 
                            />
                            <div class="absolute inset-0 bg-gradient-to-t from-bg via-bg/80 to-bg/10"></div>
                            <div class="absolute inset-0 bg-gradient-to-r from-bg via-bg/40 to-transparent"></div>
                          </div>
                        )}

                        <div class="mt-auto pt-16 relative z-10">
                          <h3 class="font-serif text-3xl md:text-4xl text-text-main mb-4 italic">
                            {project.title}
                          </h3>
                          {project.description && (
                            <p class="font-sans text-sm md:text-base leading-relaxed text-text-muted max-w-[90%]">
                              {project.description}
                            </p>
                          )}
                        </div>
                      </div>
                    </a>
                  );
                })
              }
            </div>
          </div>

          <div class="mt-16 flex justify-center w-full">
            <a href="/explore" id="rocket-btn" class="relative z-10 bg-bg inline-flex items-center border border-text-main/20 text-text-main font-sans uppercase tracking-[0.2em] text-[10px] pl-8 pr-14 py-4 rounded-full group hover:border-text-main/50 transition-colors duration-300 cursor-pointer select-none">
              
              <span class="relative z-10 btn-text pointer-events-none">View More Projects</span>

              <!-- Shared Container for Rocket -->
              <div class="absolute right-6 top-1/2 -translate-y-1/2 w-4 h-4 flex items-center justify-center pointer-events-none">

                <!-- Rocket System -->
                <div class="rocket-system absolute w-[100px] h-[100px] flex items-center justify-center overflow-visible origin-center" style="transform: scale(0.7);">
                  <svg class="w-full h-full overflow-visible" viewBox="-50 -50 100 100" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                    
                    <defs>
                      <!-- Clip path fixed at button edge (x=32) -->
                      <clipPath id="rope-clip">
                        <rect x="32" y="-50" width="200" height="100" />
                      </clipPath>
                    </defs>

                    <!-- Ropes Container (Static Clip Window) -->
                    <g clip-path="url(#rope-clip)">
                      <!-- Ropes are static lines whose x2 attribute perfectly tracks the tail -->
                      <line class="rope-top text-text-main/50" x1="32" y1="-18" x2="-18.9" y2="-9" stroke="currentColor" stroke-width="1.5" />
                      <line class="rope-bottom text-text-main/50" x1="32" y1="18" x2="-18.9" y2="9" stroke="currentColor" stroke-width="1.5" />
                    </g>

                    <!-- Rocket Mover -->
                    <g class="rocket-mover">
                      <!-- Rocket Core (AIME Rocket, perfectly centered over arrow at t=0) -->
                      <g class="rocket-body text-text-main" transform="scale(0.45) translate(-70, -30)">
                        
                        <!-- Flames -->
                        <g class="rocket-flames opacity-0 text-accent">
                          <g class="rocket-flames-flicker origin-[16px_30px]">
                            <path d="M 16 12 L -50 30 L 16 48" fill="currentColor" stroke="none" opacity="0.3" />
                            <path d="M 16 18 L -25 30 L 16 42" fill="currentColor" stroke="none" opacity="0.6" />
                            <path d="M 16 24 L -5 30 L 16 36" fill="currentColor" stroke="none" />
                          </g>
                        </g>

                        <!-- Static Body & Circuitry -->
                        <g stroke="currentColor" fill="none" stroke-linecap="round">
                          <path d="M 12 6 Q 18 6 18 10 L 18 50 Q 18 54 12 54" stroke-width="4.5" />
                          <path d="M 24 6 Q 18 6 18 10 M 24 54 Q 18 54 18 50" stroke-width="4.5" />
                          <path d="M 28 10 Q 75 15 115 30 Q 75 45 28 50" stroke-width="4" />
                          <path d="M 50 14 Q 65 30 50 46" stroke-width="3" />
                        </g>

                        <g class="transition-colors duration-300 group-hover:text-accent" stroke="currentColor" fill="none" stroke-linecap="round" stroke-width="2">
                          <path d="M 36 40 Q 36 24 40 24 Q 44 24 44 32 Q 44 24 48 24 Q 52 24 52 40" />
                          <path d="M 76 22 Q 68 30 76 38" />
                          <path d="M 74 22 Q 95 25 115 30" />
                          <path d="M 71 30 Q 85 30 95 30" />
                          <path d="M 74 38 Q 95 35 115 30" />
                        </g>
                      </g>
                    </g>
                  </svg>
                </div>
              </div>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. Activity -->
    <section data-section class="sticky top-0 min-h-screen w-full bg-bg z-20">
      <div
        data-reveal="ink-bloom"
        class="h-full max-w-[1200px] mx-auto px-4 md:px-8 w-full"
      >
        <div data-animate class="h-full flex flex-col justify-center">
          <Timeline />

          <!-- Poetic Intermission 2 (Astrolabe) - Placed as a bridge between timeline and techstack -->
          <div
            class="w-full max-w-sm mx-auto py-8 flex flex-col items-center justify-center pointer-events-none relative border-t border-border-subtle/30 mt-4"
          >
            <div
              class="absolute inset-0 bg-gradient-to-t from-bg via-transparent to-bg z-10 opacity-80"
            >
            </div>
            <img
              src="/roman_poetry_art.jpg"
              alt="Classical Roman Art"
              class="w-full h-auto mix-blend-multiply dark:mix-blend-screen dark:invert-[0.95] dark:hue-rotate-180 opacity-50 transition-all duration-1000 grayscale"
            />
          </div>

          <TechStack />
        </div>
      </div>
    </section>

    <!-- 4. Contact -->
    <section
      data-section
      class="sticky top-0 h-screen w-full bg-bg z-10 flex flex-col"
      id="contact"
    >
      <div
        data-reveal="ink-bloom"
        class="w-full max-w-[1200px] mx-auto px-4 md:px-8 flex flex-col justify-center h-full flex-1"
      >
        <div data-animate class="h-full flex flex-col">
          <Contact />
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  import anime from "animejs/lib/anime.es.js";

  const initRocketBtn = () => {
    const btn = document.getElementById("rocket-btn");
    if (!btn) return;

    const newBtn = btn.cloneNode(true) as HTMLAnchorElement;
    btn.parentNode?.replaceChild(newBtn, btn);

    const rocketSystem = newBtn.querySelector(".rocket-system");
    const rocketMover = newBtn.querySelector(".rocket-mover");
    const rocketFlames = newBtn.querySelector(".rocket-flames");
    const rocketFlamesFlicker = newBtn.querySelector(".rocket-flames-flicker");
    const ropes = newBtn.querySelectorAll(".rope-top, .rope-bottom");

    // Continuous flame flicker loop (always runs, but only visible when rocketFlames opacity > 0)
    if (rocketFlamesFlicker) {
      anime({
        targets: rocketFlamesFlicker,
        scaleX: [1, 1.4, 0.85, 1.2],
        scaleY: [1, 0.85, 1.1, 0.95],
        duration: 350,
        loop: true,
        direction: 'alternate',
        easing: 'easeInOutSine'
      });
    }

    let hoverTl;

    newBtn.addEventListener("mouseenter", () => {
      if (newBtn.dataset.clicked) return;
      if (hoverTl) hoverTl.pause();
      
      hoverTl = anime.timeline({
        easing: "easeOutQuad",
      });

      // 1. Rocket scales up
      hoverTl.add({
        targets: rocketSystem,
        scale: [0.7, 1],
        duration: 100,
      }, 0);

      // 2. Flames ignite
      hoverTl.add({
        targets: rocketFlames,
        opacity: [0, 1],
        duration: 100,
      }, 50);

      const flightDistance = 120;
      const tailStartX = -18.9;
      const buttonEdgeX = 32;
      const distToEdge = buttonEdgeX - tailStartX; // 50.9
      const flightDuration = 300;
      const percentToEdge = distToEdge / flightDistance; // 0.424

      // 3. Rocket flies out
      hoverTl.add({
        targets: rocketMover,
        translateX: ["0px", `${flightDistance}px`], 
        duration: flightDuration,
        easing: "easeOutSine",
      }, 120);

      // Ropes track exactly with the rocket tail by animating x2
      hoverTl.add({
        targets: ropes,
        x2: [-18.9, 101.1],
        duration: flightDuration,
        easing: "easeOutSine"
      }, 120);

      // 4. Button gets pulled slightly right
      hoverTl.add({
        targets: newBtn,
        translateX: "8px",
        duration: flightDuration * (1 - percentToEdge),
        easing: "easeOutSine"
      }, 120 + (flightDuration * percentToEdge)); 
    });

    newBtn.addEventListener("mouseleave", () => {
      if (newBtn.dataset.clicked) return;
      if (hoverTl) hoverTl.pause();

      hoverTl = anime.timeline({
        easing: "easeOutQuad",
      });

      // Quick reset for clean exit
      hoverTl.add({
        targets: ropes,
        x2: -18.9,
        duration: 150,
      }, 0);

      hoverTl.add({
        targets: rocketSystem,
        scale: 0.7,
        duration: 150,
      }, 0);

      hoverTl.add({
        targets: rocketMover,
        translateX: "0px",
        duration: 150,
      }, 0);

      hoverTl.add({
        targets: rocketFlames,
        opacity: 0,
        duration: 150,
      }, 0);

      hoverTl.add({
        targets: newBtn,
        translateX: "0px",
        duration: 300,
      }, 0);
    });

    newBtn.addEventListener("click", (e) => {
      e.preventDefault();
      newBtn.dataset.clicked = "true";
      
      const href = newBtn.getAttribute("href");
      
      // Lock hover styles forcefully to prevent snapback when pointer events are disabled
      newBtn.classList.add("!border-text-main/50");
      newBtn.style.pointerEvents = "none";
      
      if (hoverTl) hoverTl.pause();

      // Launch rocket and button together cleanly without sudden scaling or yanking
      anime({
        targets: newBtn,
        translateX: window.innerWidth,
        opacity: [1, 0],
        duration: 800,
        easing: "easeInExpo",
        complete: () => {
          if (href) window.location.href = href;
        }
      });
    });
  };

  initRocketBtn();
  document.addEventListener("astro:page-load", initRocketBtn);
</script>
