---
// ponytail: Home page composing all sections
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Timeline from '../components/Timeline.astro';
import TechStack from '../components/TechStack.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
---

<BaseLayout title="Portfolio">
  <Nav />
  <main class="max-w-[1200px] mx-auto px-8">
    <Hero />
    
    <section id="projects" class="py-[clamp(4rem,8vw,8rem)]">
      <h2 class="text-[clamp(1.5rem,4vw,2.5rem)] font-bold mb-8 scroll-reveal opacity-0">Projects</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {projects.map((project) => (
          <a href={`/projects/${project.id}`} class="block p-6 bg-bg-elevated border border-border-subtle rounded-lg scroll-reveal opacity-0 hover:-translate-y-1 hover:shadow-[0_0_15px_var(--color-accent-glow)] transition-all duration-300 motion-reduce:transition-none">
            <h3 class="text-2xl font-bold mb-2 text-text-main group-hover:text-accent transition-colors">{project.data.title}</h3>
            {project.data.description && <p class="text-text-muted text-[clamp(0.9rem,1.2vw,1.1rem)]">{project.data.description}</p>}
          </a>
        ))}
      </div>
    </section>

    <Timeline />
    <TechStack />
    <Contact />
  </main>
  <Footer />

</BaseLayout>
