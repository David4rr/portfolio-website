---
// ponytail: Home page composing all sections
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Preloader from "../components/Preloader.astro";
import Timeline from "../components/Timeline.astro";
import TechStack from "../components/TechStack.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import LiveClock from "../components/LiveClock.astro";
import SpotifyResonance from "../components/SpotifyResonance.astro";
import ScrollIndicator from "../components/ScrollIndicator.astro";
import { getProjectsFromNotion } from "../lib/notion";

import GithubHeatmap from "../components/GithubHeatmap.astro";
import WritingSection from "../components/WritingSection.astro";
import { getBlogPosts } from "../lib/blogger";

// Plan A: ISR Caching - Cache for 60s, stale-while-revalidate for 1 hour
Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=3600');

const [allProjects, blogPosts] = await Promise.all([
  getProjectsFromNotion(),
  getBlogPosts(),
]);

// Select featured projects if any are explicitly chosen in Notion; otherwise fallback to all projects (up to 4)
const featuredProjects = allProjects.filter((p) => p.featured === true);
const selectedProjects = (featuredProjects.length > 0 ? featuredProjects : allProjects).slice(0, 4);
// Sort selected projects by explicit order (ascending) when provided, preserving Notion order as secondary sort
const projects = [...selectedProjects].sort((a, b) => {
  const orderA = typeof a.order === 'number' && !isNaN(a.order) ? a.order : null;
  const orderB = typeof b.order === 'number' && !isNaN(b.order) ? b.order : null;

  if (orderA !== null && orderB !== null) {
    return orderA - orderB;
  }
  if (orderA !== null && orderB === null) {
    return -1;
  }
  if (orderA === null && orderB !== null) {
    return 1;
  }
  return 0;
});

const formatPoetryTitle = (title: string) => {
  const words = title.split(' ');
  if (words.length > 1) {
    const last = words.pop();
    return `${words.join(' ')} <span class="italic font-light pr-1">${last}</span>`;
  }
  
  // Single word handling (e.g. StatEmpire)
  const camelMatch = title.match(/^([A-Z]?[a-z]+)([A-Z][a-z]+)$/);
  if (camelMatch) {
    return `${camelMatch[1]}<span class="italic font-light pr-1">${camelMatch[2]}</span>`;
  }
  
  // Custom fallback for specific titles in screenshot
  if (title.toLowerCase() === 'budgetmify') {
    return `Budget<span class="italic font-light pr-1">mify</span>`;
  }
  
  // Generic fallback: split in half
  const mid = Math.ceil(title.length / 2);
  return `${title.slice(0, mid)}<span class="italic font-light pr-1">${title.slice(mid)}</span>`;
};
---

<BaseLayout 
  title="David Arrozaqi | Creative Developer & Software Engineer"
  description="Crafting bespoke digital artifacts, interactive systems & high-performance web architecture."
  image="/og-image.png"
>
  <Preloader />
  <Nav />
  <ScrollIndicator />
  <main class="w-full relative overflow-x-clip">
    <!-- 1. Hero -->
    <section
      data-section
      class="relative min-h-[100svh] md:h-[100dvh] overflow-hidden w-full bg-bg z-10 flex flex-col justify-center"
    >
      <div
        data-reveal="editorial-fade"
        class="min-h-full max-w-[1200px] mx-auto px-4 md:px-8 w-full flex flex-col justify-center pt-2 pb-2"
      >
        <div data-animate class="w-full">
          <Hero />
        </div>
      </div>

      <!-- Telemetry Hub: Spotify Resonance & Live Clock (Screen Edge) -->
      <div id="hero-telemetry" class="absolute bottom-6 md:bottom-8 right-6 md:right-8 text-right flex flex-col items-end gap-2.5 z-30 pointer-events-auto hidden md:flex">
        <SpotifyResonance />
        <div class="w-12 h-[1px] bg-border-subtle/40 my-0.5"></div>
        <LiveClock />
      </div>
      <!-- Poetry Scroll Indicator (Screen Edge) -->
      <div id="hero-scroll-indicator" class="absolute bottom-4 md:bottom-8 left-1/2 -translate-x-1/2 md:left-8 md:translate-x-0 flex flex-col items-center gap-3 opacity-60 pointer-events-none z-20 w-8 will-change-[opacity]">
        <span class="font-serif italic text-text-muted text-[10px] tracking-[0.2em] uppercase origin-center md:origin-left whitespace-nowrap">Unfold</span>
        <div class="w-full flex justify-center">
          <svg width="12" height="40" viewBox="0 0 12 40" fill="none" xmlns="http://www.w3.org/2000/svg" class="overflow-hidden">
            <rect x="5.5" y="0" width="1" height="40" fill="currentColor" class="text-text-muted/20" />
            <rect id="scroll-line" x="5.5" y="0" width="1" height="0" fill="currentColor" class="text-accent" />
          </svg>
        </div>
      </div>
    </section>
    <!-- 2. Activity -->
    <section data-section class="relative min-h-[100svh] md:min-h-screen w-full bg-bg z-20 border-t border-border-subtle/30">
      <div
        data-reveal="ink-bloom"
        class="h-full max-w-[1200px] mx-auto px-4 md:px-8 w-full"
      >
        <div class="h-full flex flex-col justify-center">
          <Timeline />

          <GithubHeatmap />

          <TechStack />
        </div>
      </div>
    </section>

    <!-- Anchor for Projects -->
    <div id="projects" class="absolute w-full h-0 pointer-events-none"></div>

    <!-- 3. Projects -->
    <section data-section class="relative min-h-[100svh] md:min-h-screen w-full bg-bg z-30 border-t border-border-subtle/30">
      <div
        data-reveal="word-cascade"
        class="h-full max-w-[1200px] mx-auto px-4 md:px-8 w-full"
      >
        <div
          class="py-[clamp(4rem,8vw,8rem)] relative border-t border-border-subtle/50 flex flex-col justify-between min-h-[calc(100svh-3rem)]"
        >
          <div>
            <div class="overflow-hidden mb-16 text-center">
              <h2
                data-word
                class="font-serif text-[clamp(2.5rem,5vw,4rem)] text-text-main font-normal tracking-tight"
              >
                Selected Works<span class="text-accent">.</span>
              </h2>
            </div>

            <div class="flex flex-col border-t border-border-subtle/50" id="project-list-container">
              {
                projects.map((project, i) => {
                  const optimizedSrc = project.image && project.image.startsWith('http') 
                    ? `https://wsrv.nl/?url=${encodeURIComponent(project.image)}&w=600&output=webp` 
                    : project.image;
                  
                  const romanNumerals = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX', 'X'];
                  const numeral = romanNumerals[i] || (i + 1);

                  return (
                    <a
                      data-card
                      href={`/projects/${project.slug}`}
                      class="project-bento-card cursor-pointer group relative flex flex-col md:flex-row md:items-center gap-6 md:gap-8 py-6 md:py-10 px-2 md:px-6 border-b border-border-subtle/50 hover:bg-border-subtle/5 transition-all duration-700"
                      data-slug={project.slug}
                      data-has-image={!!project.image}
                    >
                      <div class="flex-shrink-0 w-full md:w-20 text-text-muted font-serif italic text-sm md:text-base">
                        {numeral}.
                      </div>
                      
                      <div class="flex-shrink-0 w-full md:w-[32%]">
                        <h3 class="font-serif text-[1.75rem] md:text-[2.25rem] leading-tight text-text-main group-hover:text-accent transition-colors duration-700 tracking-tight pr-4 line-clamp-2" set:html={formatPoetryTitle(project.title)}>
                        </h3>
                      </div>
                      
                      <div class="flex-1 w-full max-w-xl pr-4">
                        <p class="font-serif italic font-light text-sm md:text-[15px] leading-loose text-text-main/70 line-clamp-4">
                          "{project.description}"
                        </p>
                      </div>
                      
                      <div class="flex-shrink-0 w-full md:w-[20%] flex flex-col gap-2 font-serif text-text-muted/80">
                        <div class="text-text-main/90 tracking-[0.2em] uppercase text-[10px]">
                          {project.type || "Digital Fragment"}
                        </div>
                        <div class="font-light italic opacity-70 leading-relaxed line-clamp-2 text-xs">
                          {project.timeline || "2024"} &mdash; {project.techStack.join(', ')}
                        </div>
                      </div>
                      
                      <div class="flex w-full md:w-auto mt-4 md:mt-0 flex-shrink-0 items-center justify-end md:justify-center gap-4 md:ml-4">
                        <span class="font-serif italic text-text-main/70 md:opacity-0 md:-translate-x-4 md:group-hover:opacity-100 md:group-hover:translate-x-0 transition-all duration-500 text-sm md:text-base">
                          Explore
                        </span>
                        <div class="flex items-center justify-center w-8 h-8 text-text-main/50 group-hover:text-text-main transition-all duration-500 overflow-hidden relative flex-shrink-0">
                          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="absolute transition-transform duration-500 ease-out transform -rotate-45 group-hover:translate-x-8 group-hover:-translate-y-8">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                          </svg>
                          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="absolute transition-transform duration-500 ease-out transform -rotate-45 -translate-x-8 translate-y-8 group-hover:translate-x-0 group-hover:translate-y-0">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                          </svg>
                        </div>
                      </div>
                    </a>
                  );
                })
              }
            </div>
            
            <!-- Floating Cursor Image Container -->
            <div id="project-cursor-wrapper" class="fixed top-0 left-0 pointer-events-none z-[100]"> <!-- positioning handled purely by JS -->
              <div id="project-cursor-image" class="w-[450px] rounded-2xl overflow-hidden opacity-0 scale-50 shadow-2xl origin-center bg-bg border border-border-subtle relative">
                {projects.map(project => {
                  const optimizedSrc = project.image && project.image.startsWith('http') 
                    ? `https://wsrv.nl/?url=${encodeURIComponent(project.image)}&w=600&output=webp` 
                    : project.image;
                    
                  return project.image ? (
                  <Image 
                    src={optimizedSrc} 
                    alt={`Preview of ${project.title}`} 
                    width={600} 
                    height={450} 
                    class="w-full h-auto absolute hidden cursor-project-img" 
                    data-slug={project.slug} 
                    loading="eager"
                  />
                ) : null})}
                {blogPosts.map(post => {
                  return post.image ? (
                  <img 
                    src={post.image} 
                    alt={`Preview of ${post.title}`} 
                    width="600" 
                    height="450" 
                    class="w-full h-auto absolute hidden cursor-project-img object-cover" 
                    data-slug={post.slug} 
                    loading="eager"
                    decoding="async"
                  />
                ) : null})}
              </div>
            </div>

            <script>
              const initProjectCursor = async () => {
                const cards = document.querySelectorAll('.project-bento-card');
                const cursorWrapper = document.getElementById('project-cursor-wrapper');
                const cursorImg = document.getElementById('project-cursor-image');
                const imgTags = document.querySelectorAll('.cursor-project-img');
                
                if (!cursorWrapper || !cursorImg || cards.length === 0) return;

                // Move wrapper to body to guarantee viewport coordinate system
                if (cursorWrapper.parentNode !== document.body) {
                  document.body.appendChild(cursorWrapper);
                }

                const { gsap } = await import('gsap');

                const xTo = gsap.quickTo(cursorWrapper, "x", { duration: 0.4, ease: "power3" });
                const yTo = gsap.quickTo(cursorWrapper, "y", { duration: 0.4, ease: "power3" });

                let isHovering = false;
                let firstHover = true;

                const getClampedPosition = (clientX, clientY) => {
                  // Dynamically read the image's actual bounds since height is now auto
                  const rect = cursorImg.getBoundingClientRect();
                  const imgWidth = rect.width || 450;
                  const imgHeight = rect.height || 337;
                  const offset = 20;
                  
                  let x = clientX + offset;
                  let y = clientY + offset;
                  
                  // Flip to left if it overflows right screen bounds
                  if (x + imgWidth > window.innerWidth - offset) {
                    x = clientX - imgWidth - offset;
                  }
                  
                  // Flip to top if it overflows bottom screen bounds
                  if (y + imgHeight > window.innerHeight - offset) {
                    y = clientY - imgHeight - offset;
                  }
                  
                  // Failsafe bounds check
                  if (x < offset) x = offset;
                  if (y < offset) y = offset;
                  
                  return { x, y };
                };

                cards.forEach(card => {
                  card.addEventListener('mouseenter', (e: MouseEvent) => {
                    isHovering = true;
                    const slug = card.getAttribute('data-slug');
                    const hasImg = card.getAttribute('data-has-image') === 'true' || card.dataset.hasImage === 'true' || card.hasAttribute('data-has-image');
                    
                    if (!hasImg || !slug) return;
                    
                    // Reset all images
                    const allCursorImgs = cursorImg.querySelectorAll('.cursor-project-img');
                    allCursorImgs.forEach(img => {
                      img.classList.remove('relative', 'block');
                      img.classList.add('absolute', 'hidden');
                    });
                    
                    // Show target image
                    const targetImg = cursorImg.querySelector(`.cursor-project-img[data-slug="${slug}"]`);
                    if (targetImg) {
                      targetImg.classList.remove('absolute', 'hidden');
                      targetImg.classList.add('relative', 'block');
                    } else {
                      return; // image wasn't generated
                    }
                    
                    const pos = getClampedPosition(e.clientX, e.clientY);
                    
                    if (firstHover) {
                      gsap.set(cursorWrapper, { x: pos.x, y: pos.y });
                      firstHover = false;
                    }
                    
                    xTo(pos.x);
                    yTo(pos.y);

                    gsap.killTweensOf(cursorImg);
                    gsap.to(cursorImg, {
                      opacity: 1,
                      scale: 1,
                      rotation: 0,
                      duration: 0.6,
                      ease: "elastic.out(1, 0.8)"
                    });
                  });

                  card.addEventListener('mousemove', (e: MouseEvent) => {
                    if (isHovering) {
                      const pos = getClampedPosition(e.clientX, e.clientY);
                      xTo(pos.x);
                      yTo(pos.y);
                    }
                  });

                  card.addEventListener('mouseleave', () => {
                    isHovering = false;
                    gsap.killTweensOf(cursorImg);
                    gsap.to(cursorImg, {
                      opacity: 0,
                      scale: 0.5,
                      rotation: 0,
                      duration: 0.4,
                      ease: "power3.out"
                    });
                  });
                });
              };

              if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initProjectCursor);
              } else {
                initProjectCursor();
              }
              document.addEventListener("astro:page-load", initProjectCursor);
            </script>
          </div>

          <div class="mt-16 flex justify-center w-full relative">
            <a href="/explore?from=projects" id="rocket-btn" aria-label="View more projects" class="relative z-10 bg-bg inline-flex items-center border border-text-main/20 text-text-main font-sans uppercase tracking-[0.2em] text-[10px] pl-8 pr-14 py-4 rounded-full group hover:border-text-main/50 active:scale-95 transition-colors duration-300 cursor-pointer select-none">
              
              <span class="relative z-10 btn-text pointer-events-none">View More Projects</span>

              <!-- Shared Container for Rocket -->
              <div class="absolute right-6 top-1/2 -translate-y-1/2 w-4 h-4 flex items-center justify-center pointer-events-none">

                <!-- Rocket System -->
                <div class="rocket-system absolute w-[100px] h-[100px] flex items-center justify-center overflow-visible origin-center" style="transform: scale(0.7);">
                  <svg class="w-full h-full overflow-visible" viewBox="-50 -50 100 100" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                    
                    <defs>
                      <!-- Clip path fixed at button edge (x=32) -->
                      <clipPath id="rope-clip">
                        <rect x="32" y="-50" width="200" height="100" />
                      </clipPath>
                    </defs>

                    <!-- Ropes Container (Static Clip Window) -->
                    <g clip-path="url(#rope-clip)">
                      <!-- Ropes are static lines whose x2 attribute perfectly tracks the tail -->
                      <line class="rope-top text-text-main/50" x1="32" y1="-18" x2="-18.9" y2="-9" stroke="currentColor" stroke-width="1.5" />
                      <line class="rope-bottom text-text-main/50" x1="32" y1="18" x2="-18.9" y2="9" stroke="currentColor" stroke-width="1.5" />
                    </g>

                    <!-- Rocket Mover -->
                    <g class="rocket-mover">
                      <!-- Rocket Core (AIME Rocket, perfectly centered over arrow at t=0) -->
                      <g class="rocket-body text-text-main" transform="scale(0.45) translate(-70, -30)">
                        
                        <!-- Flames -->
                        <g class="rocket-flames opacity-0 text-accent">
                          <g class="rocket-flames-flicker origin-[16px_30px]">
                            <path d="M 16 12 L -50 30 L 16 48" fill="currentColor" stroke="none" opacity="0.3" />
                            <path d="M 16 18 L -25 30 L 16 42" fill="currentColor" stroke="none" opacity="0.6" />
                            <path d="M 16 24 L -5 30 L 16 36" fill="currentColor" stroke="none" />
                          </g>
                        </g>

                        <!-- Static Body & Circuitry -->
                        <g stroke="currentColor" fill="none" stroke-linecap="round">
                          <path d="M 12 6 Q 18 6 18 10 L 18 50 Q 18 54 12 54" stroke-width="4.5" />
                          <path d="M 24 6 Q 18 6 18 10 M 24 54 Q 18 54 18 50" stroke-width="4.5" />
                          <path d="M 28 10 Q 75 15 115 30 Q 75 45 28 50" stroke-width="4" />
                          <path d="M 50 14 Q 65 30 50 46" stroke-width="3" />
                        </g>

                        <g class="transition-colors duration-300 group-hover:text-accent" stroke="currentColor" fill="none" stroke-linecap="round" stroke-width="2">
                          <path d="M 36 40 Q 36 24 40 24 Q 44 24 44 32 Q 44 24 48 24 Q 52 24 52 40" />
                          <path d="M 76 22 Q 68 30 76 38" />
                          <path d="M 74 22 Q 95 25 115 30" />
                          <path d="M 71 30 Q 85 30 95 30" />
                          <path d="M 74 38 Q 95 35 115 30" />
                        </g>
                      </g>
                    </g>
                  </svg>
                </div>
              </div>
            </a>
          </div>
        </div>
      </div>
    </section>
    <div id="writing" class="absolute w-full h-0 pointer-events-none"></div>

    <!-- 4. Writing -->
    <section data-section id="writing-section" class="relative min-h-[100svh] md:min-h-screen w-full bg-bg z-40 border-t border-border-subtle/30">
      <div
        data-reveal="word-cascade"
        class="h-full max-w-[1200px] mx-auto px-4 md:px-8 w-full"
      >
        <WritingSection posts={blogPosts} />
      </div>
    </section>

    <!-- 5. Contact -->
    <section
      data-section
      class="relative min-h-[100svh] md:min-h-screen w-full bg-bg z-50 flex flex-col border-t border-border-subtle/30"
      id="contact"
    >
      <div
        data-reveal="ink-bloom"
        class="h-full max-w-[1200px] mx-auto px-4 md:px-8 w-full flex-1 flex flex-col justify-center"
      >
        <div data-animate class="h-full w-full flex-1 flex flex-col justify-center">
          <Contact />
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  const setupOneRocketBtn = (btn: HTMLElement) => {
    const newBtn = btn.cloneNode(true) as HTMLAnchorElement;
    btn.parentNode?.replaceChild(newBtn, btn);
    const rocketSystem = newBtn.querySelector(".rocket-system");
    const rocketMover = newBtn.querySelector(".rocket-mover");
    const rocketFlames = newBtn.querySelector(".rocket-flames");
    const rocketFlamesFlicker = newBtn.querySelector(".rocket-flames-flicker");
    const ropes = newBtn.querySelectorAll(".rope-top, .rope-bottom");

    // Fix Astro ViewTransitions Cache Bug: Reset state if button was previously clicked
    delete newBtn.dataset.clicked;
    newBtn.classList.remove("!border-text-main/50");
    newBtn.style.pointerEvents = "";
    newBtn.style.opacity = "";
    newBtn.style.transform = "";
    if (rocketMover) rocketMover.style.transform = "";
    if (rocketSystem) rocketSystem.style.transform = "scale(0.7)";
    if (rocketFlames) rocketFlames.style.opacity = "0";
    ropes.forEach(rope => rope.setAttribute("x2", "-18.9"));

    // Continuous flame flicker loop handled by CSS now: .animate-rocket-flicker
    if (rocketFlamesFlicker) {
      rocketFlamesFlicker.classList.add('animate-rocket-flicker');
    }

    let hoverTl;

    newBtn.addEventListener("mouseenter", async () => {
      if (newBtn.dataset.clicked) return;
      if (hoverTl) hoverTl.pause();
      
      const { default: anime } = await import('animejs/lib/anime.es.js');

      hoverTl = anime.timeline({
        easing: "easeOutQuad",
      });

      // 1. Rocket scales up
      hoverTl.add({
        targets: rocketSystem,
        scale: [0.7, 1],
        duration: 100,
      }, 0);

      // 2. Flames ignite
      hoverTl.add({
        targets: rocketFlames,
        opacity: [0, 1],
        duration: 100,
      }, 50);

      const flightDistance = 120;
      const tailStartX = -18.9;
      const buttonEdgeX = 32;
      const distToEdge = buttonEdgeX - tailStartX; // 50.9
      const flightDuration = 300;
      const percentToEdge = distToEdge / flightDistance; // 0.424

      // 3. Rocket flies out
      hoverTl.add({
        targets: rocketMover,
        translateX: ["0px", `${flightDistance}px`], 
        duration: flightDuration,
        easing: "easeOutSine",
      }, 120);

      // Ropes track exactly with the rocket tail by animating x2
      hoverTl.add({
        targets: ropes,
        x2: [-18.9, 101.1],
        duration: flightDuration,
        easing: "easeOutSine"
      }, 120);

      // 4. Button gets pulled slightly right
      hoverTl.add({
        targets: newBtn,
        translateX: "8px",
        duration: flightDuration * (1 - percentToEdge),
        easing: "easeOutSine"
      }, 120 + (flightDuration * percentToEdge)); 
    });

    newBtn.addEventListener("mouseleave", async () => {
      if (newBtn.dataset.clicked) return;
      if (hoverTl) hoverTl.pause();
      
      const { default: anime } = await import('animejs/lib/anime.es.js');

      hoverTl = anime.timeline({
        easing: "easeOutQuad",
      });

      // Quick reset for clean exit
      hoverTl.add({
        targets: ropes,
        x2: -18.9,
        duration: 150,
      }, 0);

      hoverTl.add({
        targets: rocketSystem,
        scale: 0.7,
        duration: 150,
      }, 0);

      hoverTl.add({
        targets: rocketMover,
        translateX: "0px",
        duration: 150,
      }, 0);

      hoverTl.add({
        targets: rocketFlames,
        opacity: 0,
        duration: 150,
      }, 0);

      hoverTl.add({
        targets: newBtn,
        translateX: "0px",
        duration: 300,
      }, 0);
    });

    newBtn.addEventListener("click", async (e) => {
      e.preventDefault();
      if (newBtn.dataset.clicked) return;
      newBtn.dataset.clicked = "true";
      
      const href = newBtn.getAttribute("href");
      
      // Lock hover styles forcefully to prevent snapback
      newBtn.classList.add("!border-text-main/50");
      newBtn.style.pointerEvents = "none";
      
      if (hoverTl) hoverTl.pause();
      
      const { default: anime } = await import('animejs/lib/anime.es.js');

      const launchRocket = () => {
        anime({
          targets: newBtn,
          translateX: "100vw",
          opacity: [1, 0],
          duration: 800,
          easing: "easeInExpo",
          complete: () => {
            if (href) window.location.href = href;
          }
        });
      };

      // On mobile/touch devices, mouseenter might not fire fully. 
      // Play the full hover sequence first before launching.
      if (window.innerWidth < 768) {
        const clickTl = anime.timeline({ easing: "easeOutQuad" });
        clickTl.add({ targets: rocketSystem, scale: [0.7, 1], duration: 100 }, 0);
        clickTl.add({ targets: rocketFlames, opacity: [0, 1], duration: 100 }, 50);
        
        const flightDistance = 120;
        const distToEdge = 50.9;
        const flightDuration = 300;
        const percentToEdge = distToEdge / flightDistance;

        clickTl.add({ targets: rocketMover, translateX: ["0px", `${flightDistance}px`], duration: flightDuration, easing: "easeOutSine" }, 120);
        clickTl.add({ targets: ropes, x2: [-18.9, 101.1], duration: flightDuration, easing: "easeOutSine" }, 120);
        clickTl.add({ targets: newBtn, translateX: "8px", duration: flightDuration * (1 - percentToEdge), easing: "easeOutSine", complete: launchRocket }, 120 + (flightDuration * percentToEdge));
      } else {
        // On desktop, the hover animation has already run or is running. Just launch!
        launchRocket();
      }
    });
  };

  const initRocketBtn = () => {
    const btns = document.querySelectorAll<HTMLAnchorElement>("#rocket-btn, .rocket-btn-element, #rocket-btn-writing");
    btns.forEach(setupOneRocketBtn);
  };

  const initInkDrop = async () => {
    const line = document.getElementById('scroll-line');
    if (!line) return;
    
    // Kill existing animation if any
    const lineWithAnime = line as unknown as { anime?: { pause: () => void } };
    if (lineWithAnime.anime) lineWithAnime.anime.pause();

    const { default: anime } = await import('animejs/lib/anime.es.js');
    
    line.setAttribute('y', '0');
    line.setAttribute('height', '0');
    line.setAttribute('opacity', '0');

    lineWithAnime.anime = anime.timeline({
      loop: true,
    })
    // 1. Unfold: line draws/extends smoothly downward from top
    .add({
      targets: line,
      height: [0, 26],
      y: 0,
      opacity: [0.3, 1],
      duration: 1100,
      easing: 'easeInOutCubic',
    })
    // 2. Unfurl release: tail catches up, dissolving into the bottom edge
    .add({
      targets: line,
      y: [0, 40],
      height: [26, 0],
      opacity: [1, 0],
      duration: 850,
      easing: 'easeInOutCubic',
    }, '-=150')
    // 3. Poetic resting pause
    .add({
      duration: 500,
    });
  };
  let telemetryScrollListener = null;
  const initHeroTelemetry = () => {
    const telemetry = document.getElementById("hero-telemetry");
    const unfold = document.getElementById("hero-scroll-indicator");
    if (!telemetry && !unfold) return;

    if (telemetryScrollListener) {
      window.removeEventListener("scroll", telemetryScrollListener);
      const lenis = (window as any).lenis;
      if (lenis && typeof lenis.off === "function") {
        lenis.off("scroll", telemetryScrollListener);
      }
    }
    let lastHidden = false;
    const onScroll = () => {
      const scrollY = window.scrollY;
      const threshold = window.innerHeight * 0.25;
      if (scrollY > threshold) {
        if (!lastHidden) {
          if (telemetry) {
            telemetry.style.opacity = "0";
            telemetry.style.pointerEvents = "none";
          }
          if (unfold) {
            unfold.style.opacity = "0";
            unfold.style.pointerEvents = "none";
          }
          lastHidden = true;
        }
      } else {
        lastHidden = false;
        const progress = Math.max(0, 1 - scrollY / threshold);
        if (telemetry) {
          telemetry.style.opacity = progress.toString();
          telemetry.style.pointerEvents = progress > 0.05 ? "auto" : "none";
        }
        if (unfold) {
          unfold.style.opacity = (progress * 0.6).toString();
          unfold.style.pointerEvents = "none";
        }
      }
    };

    telemetryScrollListener = onScroll;
    window.addEventListener("scroll", onScroll, { passive: true });
    const lenis = (window as any).lenis;
    if (lenis && typeof lenis.on === "function") {
      lenis.on("scroll", onScroll);
    }
    onScroll();
  };

  initRocketBtn();
  initInkDrop();
  initHeroTelemetry();
  document.addEventListener("astro:page-load", () => {
    initRocketBtn();
    initInkDrop();
    initHeroTelemetry();
  });
  document.addEventListener("astro:before-swap", () => {
    if (telemetryScrollListener) {
      window.removeEventListener("scroll", telemetryScrollListener);
      const lenis = (window as any).lenis;
      if (lenis && typeof lenis.off === "function") {
        lenis.off("scroll", telemetryScrollListener);
      }
      telemetryScrollListener = null;
    }
    const cw = document.getElementById("project-cursor-wrapper");
    if (cw && cw.parentNode === document.body) {
      document.body.removeChild(cw);
    }
  });
  window.addEventListener("pageshow", (event) => {
    if (event.persisted) {
      initRocketBtn();
      initInkDrop();
      initHeroTelemetry();
    }
  });
</script>

