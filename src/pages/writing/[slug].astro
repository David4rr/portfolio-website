---
import '../../styles/writing-article.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import ScrollUpButton from '../../components/ScrollUpButton.astro';
import VisitActionButton from '../../components/VisitActionButton.astro';
import { getBlogPostBySlug } from '../../lib/blogger';
import { optimizeImageUrl, resolveReturnLink } from '../../lib/detail-helpers';
import { transformBloggerArticleContent } from '../../lib/article-transformer';

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=3600');

const { slug } = Astro.params;
const post = await getBlogPostBySlug(slug || '');

if (!post) {
  return Astro.redirect('/404');
}

const { returnHref, returnLabel } = resolveReturnLink(Astro.url.searchParams, '/#writing');
const optimizedCover = post.image ? optimizeImageUrl(post.image, 1200) : '';
const { sanitizedContent, toc } = transformBloggerArticleContent(post.content || '', post.title);

const hasImageInContent = /<img\b/i.test(post.content || '');
const showCover = Boolean(optimizedCover && !hasImageInContent);

const formattedDate = new Date(post.published).toLocaleDateString('en-US', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<BaseLayout
  title={`${post.title} | David Arrozaqi`}
  description={post.excerpt}
  image={optimizedCover || '/og-image.png'}
  type="article"
>
  <Nav />

  <main class="min-h-screen pt-24 sm:pt-28 md:pt-32 pb-36 sm:pb-48 md:pb-64 bg-bg overflow-x-clip w-full">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 md:px-8">
      <div class="flex justify-center mb-12 sm:mb-16 md:mb-20">
        <a id="magnetic-area" href={returnHref} class="p-4 sm:p-6 cursor-pointer group">
          <div id="back-button" class="flex items-center text-text-muted group-hover:text-accent transition-colors duration-300 uppercase font-sans text-[10px] tracking-[0.25em] sm:tracking-[0.3em]">
            <span class="w-8 sm:w-12 flex justify-end items-center"><span class="return-line-left w-[8px] sm:w-[12px] h-[1px] bg-accent/70 transition-colors duration-300"></span></span>
            <span id="back-text" class="min-w-[6rem] px-2 text-center whitespace-nowrap">{returnLabel}</span>
            <span class="w-8 sm:w-12 flex justify-start items-center"><span class="return-line-right w-[8px] sm:w-[12px] h-[1px] bg-accent/70 transition-colors duration-300"></span></span>
          </div>
        </a>
      </div>

      <header class="text-center mb-10 sm:mb-14 md:mb-16">
        <div class="font-mono text-[11px] sm:text-xs uppercase tracking-[0.15em] sm:tracking-[0.2em] text-text-muted mb-3 sm:mb-4 flex items-center justify-center gap-2 flex-wrap">
          <span>{formattedDate}</span>
          <span id="detail-last-read" class="hidden text-accent lowercase tracking-normal font-sans italic opacity-90"></span>
        </div>

        <h1 class="font-serif text-2xl sm:text-3xl md:text-4xl lg:text-5xl leading-[1.25] text-text-main font-normal tracking-tight italic mb-6 break-words">
          {post.title}
        </h1>
      </header>

      {showCover && (
        <div class="mb-14 overflow-hidden rounded-sm border border-border-subtle/50">
          <img
            src={optimizedCover}
            alt={post.title}
            class="w-full h-auto object-cover max-h-[500px]"
            loading="eager"
            decoding="async"
            data-image-component=""
          />
        </div>
      )}

      <TableOfContents items={toc} />

      <article
        class="prose prose-invert max-w-none text-text-main/90 font-serif text-base md:text-lg leading-relaxed space-y-6 [&>p]:leading-relaxed [&>h2]:font-serif [&>h2]:text-2xl [&>h2]:mt-10 [&>h2]:mb-4 [&>h2]:break-words [&>h3]:font-serif [&>h3]:text-xl [&>h3]:mt-8 [&>h3]:mb-3 [&>h3]:break-words [&>h4]:break-words [&>a]:text-accent [&>a]:underline [&>blockquote]:border-l-2 [&>blockquote]:border-accent [&>blockquote]:pl-4 [&>blockquote]:italic [&_ul]:list-disc [&_ul]:pl-5 sm:[&_ul]:pl-6 [&_ul]:my-4 [&_ol]:list-decimal [&_ol]:pl-5 sm:[&_ol]:pl-6 [&_ol]:my-4 [&_li]:my-2 [&_li]:pl-1 [&_li::marker]:text-accent"
        set:html={sanitizedContent}
      />

      {post.url && <VisitActionButton href={post.url} label="Visit Article" />}
    </div>
  </main>

  <ScrollUpButton />
</BaseLayout>

<script>
  import { setupDetailBackButton } from '../../lib/detail-helpers';

  const setupCopyButtons = () => {
    document.querySelectorAll('.copy-terminal-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const card = btn.closest('.terminal-card');
        const codeEl = card?.querySelector('.terminal-body code');
        const label = btn.querySelector('.copy-label');
        if (!codeEl || !label) return;

        try {
          await navigator.clipboard.writeText(codeEl.textContent || '');
          label.textContent = 'Copied!';
          btn.classList.add('text-accent');
          setTimeout(() => {
            label.textContent = 'Copy';
            btn.classList.remove('text-accent');
          }, 2000);
        } catch (err) {
          console.error('Failed to copy code:', err);
        }
      });
    });
  };

  let detailExitCleanup: (() => void) | null = null;

  const recordReadingHistory = () => {
    try {
      if (detailExitCleanup) {
        detailExitCleanup();
        detailExitCleanup = null;
      }

      const slug = window.location.pathname.split('/').filter(Boolean).pop();
      if (!slug) return;
      const key = 'omp_reading_history';
      const history = JSON.parse(localStorage.getItem(key) || '{}');
      const priorExitTime = history[slug];

      let prevRel: string | null = null;
      if (priorExitTime && typeof priorExitTime === 'number') {
        const diffSec = Math.floor((Date.now() - priorExitTime) / 1000);
        if (diffSec < 60) prevRel = 'just now';
        else if (diffSec < 3600) prevRel = `${Math.floor(diffSec / 60)}m ago`;
        else if (diffSec < 86400) prevRel = `${Math.floor(diffSec / 3600)}h ago`;
        else if (diffSec >= 86400 && diffSec < 172800) prevRel = 'yesterday';
        else prevRel = `${Math.floor(diffSec / 86400)}d ago`;
      }

      const indicator = document.getElementById('detail-last-read');
      if (indicator) {
        if (prevRel) {
          indicator.textContent = `• last read ${prevRel}`;
          indicator.classList.remove('hidden');
        } else {
          indicator.textContent = '';
          indicator.classList.add('hidden');
        }
      }

      let hasFlushed = false;
      const flushTimestamp = () => {
        if (hasFlushed) return;
        hasFlushed = true;
        try {
          const currentHistory = JSON.parse(localStorage.getItem(key) || '{}');
          currentHistory[slug] = Date.now();
          localStorage.setItem(key, JSON.stringify(currentHistory));
        } catch {}
      };

      const returnBtn = document.getElementById('magnetic-area');
      if (returnBtn) {
        returnBtn.addEventListener('click', flushTimestamp);
      }

      const onBeforeSwap = () => {
        flushTimestamp();
        cleanup();
      };
      document.addEventListener('astro:before-swap', onBeforeSwap, { once: true });

      const cleanup = () => {
        if (returnBtn) returnBtn.removeEventListener('click', flushTimestamp);
        document.removeEventListener('astro:before-swap', onBeforeSwap);
      };

      detailExitCleanup = cleanup;
    } catch {}
  };

  const initDetailPage = () => {
    setupDetailBackButton('/#writing');
    setupCopyButtons();
    recordReadingHistory();
  };

  document.addEventListener('astro:page-load', initDetailPage);
  window.addEventListener('pageshow', recordReadingHistory);
</script>
