---
// ponytail: standalone contact page
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import ContactSection from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout 
  title="Contact | David Arrozaqi"
  description="Get in touch with David Arrozaqi for engineering inquiries, software architecture, and creative collaborations."
  image="/og-image.png"
>
  <Nav />
  <main class="max-w-300 mx-auto px-8 pt-20 min-h-[80vh] flex flex-col justify-center">
    <ContactSection />
  </main>
  <Footer />

</BaseLayout>
